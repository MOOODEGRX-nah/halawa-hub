<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HalawaHub.App.ViewModels"
             xmlns:l="using:HalawaHub.App.Services"
             xmlns:c="using:HalawaHub.App.Controls"
             x:Class="HalawaHub.App.Views.SearchBox"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <!-- النبض يعمل فقط مع الصنف pulse (يضيفه الكود بضع ثوانٍ عند تفعيل النافذة): حركة دائمة هنا
             كانت تعيد رسم النافذة 60 مرة في الثانية والبرنامج خامل (ربع نواة تقريبًا) -->
        <Style Selector="Border.halo.pulse">
            <Setter Property="RenderTransform">
                <ScaleTransform/>
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:2" IterationCount="Infinite" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.3"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.65"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="1.08"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.08"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.3"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- الصنف bob يُضاف فقط والفقاعة ظاهرة: حركة لا نهائية على عنصر مخفي تُبقي خيط الرسم يعمل كل إطار -->
        <Style Selector="TextBlock.bob">
            <Setter Property="RenderTransform">
                <TranslateTransform/>
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:2" IterationCount="Infinite" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="0"/></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="TranslateTransform.Y" Value="-3"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="0"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Button.sb-chip">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Wash10Brush}"/>
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ChipTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="Button.sb-chip:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource RedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <Style Selector="Button.sb-row">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Wash06Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="Button.sb-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
        </Style>
    </UserControl.Styles>

    <Panel Name="Box" Width="44" Height="44" Classes.open="{Binding IsSearchOpen}">
        <Border Name="Halo" Classes="halo" Opacity="0.3" Margin="-6" CornerRadius="28" BorderThickness="3" BorderBrush="{DynamicResource SearchHaloBrush}"
                IsHitTestVisible="False" IsVisible="{Binding !IsSearchOpen}"/>

        <Border Name="Shell" BorderBrush="{DynamicResource AccentAmberGradient}" CornerRadius="22" BorderThickness="2" Background="{DynamicResource SurfaceBrush}"
                BoxShadow="{DynamicResource GlowS}" Opacity="0" IsHitTestVisible="False">
            <Border.Transitions>
                <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.3"/></Transitions>
            </Border.Transitions>
        </Border>

        <Border Name="Fill" CornerRadius="22" Background="{DynamicResource RedGradient}"
                BoxShadow="{DynamicResource GlowSearch}" IsHitTestVisible="False">
            <Border.Transitions>
                <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.3"/></Transitions>
            </Border.Transitions>
        </Border>

        <Button Name="OpenButton" CornerRadius="22" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                IsVisible="{Binding !IsSearchOpen}" Click="Open_Click"
                ToolTip.Tip="{l:Loc search}" AutomationProperties.Name="{l:Loc search}"/>

        <c:VectorIcon Name="SearchIcon" Data="{StaticResource IconSearch}" Size="20" StrokeWidth="2.4"
                      HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,0,0"
                      Foreground="White" IsHitTestVisible="False">
            <c:VectorIcon.Transitions>
                <Transitions><BrushTransition Property="Foreground" Duration="0:0:0.3"/></Transitions>
            </c:VectorIcon.Transitions>
        </c:VectorIcon>

        <!-- علامة الاستفهام عند عدم وجود نتائج -->
        <Border Name="Bubble" Width="26" Height="26" CornerRadius="13" IsHitTestVisible="False"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,-30,0,0"
                IsVisible="{Binding ShowSearchNoMatch}" BoxShadow="{DynamicResource GlowSearchS}" Background="{DynamicResource AccentHoverAmberGradient}">
            <TextBlock Classes.bob="{Binding ShowSearchNoMatch}" Text="?" Foreground="White" FontWeight="Bold" FontSize="16" FontFamily="fonts:Inter#Inter"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <TextBox Name="Input" Classes="bare" Margin="42,0,44,0"
                 Text="{Binding SearchQuery, Mode=TwoWay}" Watermark="{l:Loc search}"
                 IsVisible="{Binding IsSearchOpen}"
                 AutomationProperties.Name="{l:Loc search}"/>

        <Button Name="ClearButton" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource ChipBrush}" Foreground="{DynamicResource MenuTextBrush}"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0"
                IsVisible="{Binding HasSearchText}" Click="Clear_Click"
                ToolTip.Tip="{l:Loc clear}" AutomationProperties.Name="{l:Loc clear}">
            <c:VectorIcon Data="{StaticResource IconX}" Size="14" StrokeWidth="2.6"/>
        </Button>

        <!-- القائمة المنسدلة -->
        <Canvas>
            <Border Name="Dropdown" Canvas.Top="56" Canvas.Right="0" Width="340" Padding="14,12" CornerRadius="16"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushCard}" BorderThickness="1"
                    BoxShadow="0 16 40 0 #99000000" IsVisible="{Binding ShowSearchDropdown}">
                <StackPanel>
                    <StackPanel IsVisible="{Binding ShowRecentSearches}">
                        <TextBlock Text="{l:Loc recentLbl}" Foreground="{DynamicResource SubtleBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <ItemsControl Name="RecentList" ItemsSource="{Binding RecentSearches}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button Classes="sb-chip" Content="{Binding}" Click="Recent_Click"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ItemsControl Name="SuggestionList" ItemsSource="{Binding SearchSuggestions}" IsVisible="{Binding ShowSearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SearchSuggestion">
                                <Button Classes="sb-row" Click="Suggestion_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <c:VectorIcon Data="{StaticResource IconSearch}" Size="16" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Before}" Foreground="{DynamicResource MutedBrush}" FontSize="16" FontWeight="Medium"/>
                                            <TextBlock Text="{Binding Match}" Foreground="{DynamicResource TextBrush}" FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding After}" Foreground="{DynamicResource MutedBrush}" FontSize="16" FontWeight="Medium"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Name="NoMatchPanel" IsVisible="{Binding ShowSearchNoMatch}" Margin="0,14,0,8" Spacing="6">
                        <TextBlock Text="{Binding SearchNoMatchText}" Foreground="{DynamicResource ChipTextBrush}"
                                   FontSize="16" FontWeight="Medium" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="{l:Loc tryOther}" Foreground="{DynamicResource SubtleBrush}" FontSize="13" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Canvas>
    </Panel>
</UserControl>
