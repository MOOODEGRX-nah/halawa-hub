<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HalawaHub.App.ViewModels"
             xmlns:l="using:HalawaHub.App.Services"
             xmlns:c="using:HalawaHub.App.Controls"
             x:Class="HalawaHub.App.Views.TopBar"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <Style Selector="Button.tbtn">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.tbtn:pointerover">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style Selector="Button.tbtn.on, Button.tbtn.on:pointerover">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Border.bdg">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="#2A1313"/>
            <Setter Property="BorderBrush" Value="#4A2A12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.3"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.bdg TextBlock">
            <Setter Property="Transitions">
                <Transitions><BrushTransition Property="Foreground" Duration="0:0:0.3"/></Transitions>
            </Setter>
            <Setter Property="Foreground" Value="{StaticResource AmberBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.on Border.bdg">
            <Setter Property="Background" Value="#4D000000"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
        </Style>
        <Style Selector="Button.on Border.bdg TextBlock">
            <Setter Property="Foreground" Value="#FFE2B0"/>
        </Style>

        <Style Selector="Button.slb /template/ Border#PART_Root">
            <Setter Property="Transitions">
                <Transitions><BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.35"/></Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.slb:pointerover /template/ Border#PART_Root, Button.slb.on /template/ Border#PART_Root">
            <Setter Property="BoxShadow" Value="0 0 18 0 #80EF4444"/>
        </Style>
        <Style Selector="Button.slb:pointerover, Button.slb.on, Button.slb.on:pointerover">
            <Setter Property="Background" Value="{StaticResource SettingsHoverGradient}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="*,Auto,*" Margin="0,16">
        <!-- الشعار -->
        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#000000"
                BorderBrush="{StaticResource BorderBrushCard}" BorderThickness="1"
                HorizontalAlignment="Left" BoxShadow="0 0 18 0 #47EF4444">
            <Border CornerRadius="9" ClipToBounds="True">
                <Image Source="avares://Halawa-Hub/Assets/logo.png" Stretch="UniformToFill"/>
            </Border>
        </Border>

        <!-- المكتبة / المطورين -->
        <Border Grid.Column="1" Width="400" Height="56" CornerRadius="20"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushCard}"
                BorderThickness="1" BoxShadow="0 6 18 0 #73000000">
            <Panel>
                <c:SlidingPill ItemCount="2" SelectedIndex="{Binding TopNavIndex}" Inset="6" Margin="0,6">
                    <Border CornerRadius="14" Background="{StaticResource RedGradient}"
                            BoxShadow="0 0 20 0 #8CEF4444"/>
                </c:SlidingPill>
                <Grid ColumnDefinitions="*,*" Margin="6">
                    <Button Grid.Column="0" Classes="tbtn" Classes.on="{Binding IsLibraryPage}"
                            Command="{Binding GoLibraryCommand}"
                            Content="{l:Loc library}"/>
                    <Button Grid.Column="1" Classes="tbtn" Classes.on="{Binding IsDeveloperPage}"
                            Command="{Binding GoDeveloperCommand}" AutomationProperties.Name="{l:Loc developer}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{l:Loc developer}" VerticalAlignment="Center"/>
                            <Border Classes="bdg">
                                <TextBlock Text="{l:Loc soon}"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </Grid>
            </Panel>
        </Border>

        <!-- الإعدادات: المقابض تنزلق عند المرور -->
        <Panel Grid.Column="2" HorizontalAlignment="Right" Width="44" Height="44">
            <Button Name="SettingsButton" Classes="ib slb" Classes.on="{Binding IsSettingsVisible}"
                    Command="{Binding OpenSettingsCommand}"
                    ToolTip.Tip="{l:Loc settings}"
                    AutomationProperties.Name="{l:Loc settings}">
                <c:SlidersIcon Name="Sliders" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
            <!-- كان جرس الإشعارات يدل على التحديث: النقطة تحل مكانه -->
            <Ellipse Width="10" Height="10" Fill="{StaticResource AmberBrush}" IsHitTestVisible="False"
                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                     IsVisible="{Binding IsUpdateAvailable}"/>
        </Panel>
    </Grid>
</UserControl>
