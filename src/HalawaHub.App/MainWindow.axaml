<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HalawaHub.App.ViewModels"
        xmlns:views="using:HalawaHub.App.Views"
        x:Class="HalawaHub.App.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitleText}" Width="1280" Height="860" MinWidth="980" MinHeight="620"
        Icon="avares://Halawa-Hub/Assets/icon.ico"
        Background="{DynamicResource PageBrush}"
        FlowDirection="{Binding AppFlowDirection}"
        FontFamily="{Binding AppFontFamily}"
        Foreground="{DynamicResource TextBrush}">

    <Panel Name="WindowRoot" Classes.nohover="{Binding !CoverHoverAnimation}">
        <!-- الوهج الأحمر أعلى الصفحة: ثابت في جهة اليمين باللغتين كما في التصميم -->
        <Border IsHitTestVisible="False" FlowDirection="LeftToRight" Background="{DynamicResource WindowGlowBrush}"/>

        <Grid Name="PageContent" RowDefinitions="Auto,*" Margin="28,0">
            <views:TopBar Grid.Row="0"/>
            <views:LibraryView Grid.Row="1" IsVisible="{Binding IsLibraryPage}"/>
            <views:ComingSoonView Grid.Row="1" IsVisible="{Binding IsDeveloperPage}"/>
        </Grid>

        <!-- رسائل الحالة والأخطاء -->
        <Border Name="Toast" IsVisible="{Binding HasStatusMessage}" IsHitTestVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="20,0,20,24" MaxWidth="640"
                Background="{DynamicResource MenuBrush}" BorderBrush="{DynamicResource MenuBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,10"
                BoxShadow="0 12 32 0 #99000000">
            <TextBlock Text="{Binding StatusMessage}" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextBrush}"/>
        </Border>

        <views:GameDialog/>
        <views:SettingsDialog/>
        <views:MediaDialog/>
        <views:WhatsNewDialog/>
        <views:NotificationsDialog/>
        <views:QuickSearchDialog/>
        <views:WizardDialog/>
        <views:ConfirmDialog/>
    </Panel>
</Window>
