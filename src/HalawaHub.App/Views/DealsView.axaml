<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HalawaHub.App.ViewModels"
             xmlns:l="using:HalawaHub.App.Services"
             xmlns:behaviors="using:HalawaHub.App.Behaviors"
             x:Class="HalawaHub.App.Views.DealsView"
             x:DataType="vm:MainViewModel"
             Name="Root">

    <!-- صفحة العروض: مجانيات Epic الآن، ومكان أي عروض تُضاف لاحقًا. كانت شريطًا يأخذ من ارتفاع المكتبة -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,8,0,40" Spacing="14">
            <TextBlock Text="{l:Loc deals}" FontSize="28" FontWeight="Bold"/>

            <TextBlock Name="DealsEmpty" Text="{Binding DealsEmptyText}" IsVisible="{Binding HasNoDeals}" FontSize="15"
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"/>

            <StackPanel Name="FreeGamesSection" Spacing="10" IsVisible="{Binding HasFreeGames}">
                <TextBlock Classes="lbl" Text="{l:Loc freeThisWeek}"/>
                <ItemsControl ItemsSource="{Binding FreeGames}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FreeGameItem">
                            <Button Classes="btn" Width="300" Height="236" Padding="0" Margin="0,0,16,16"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    AutomationProperties.Name="{Binding Title}"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).OpenUrlCommand}" CommandParameter="{Binding Url}">
                                <StackPanel>
                                    <Border Height="169" CornerRadius="9,9,0,0" ClipToBounds="True" Background="{DynamicResource ChipBrush}">
                                        <Image Stretch="UniformToFill" IsVisible="{Binding HasImage}"
                                               behaviors:AsyncImage.DecodeWidth="600" behaviors:AsyncImage.SourceUrl="{Binding ImageUrl}"/>
                                    </Border>
                                    <StackPanel Margin="14,10,14,12" Spacing="3">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding EndsText}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
