<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:HalawaHub.App.Services"
        xmlns:controls="using:HalawaHub.App.Controls">

    <!-- ظلال البطاقات وهالة البحث والقوائم تتجاوز حدود عناصرها -->
    <Style Selector=":is(UserControl)">
        <Setter Property="ClipToBounds" Value="False"/>
    </Style>

    <!-- زر الإغلاق: الأيقونة تدور عند المرور -->
    <Style Selector="Button.x controls|VectorIcon">
        <Setter Property="RenderTransform" Value="rotate(0deg)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.35" Easing="{x:Static l:Springs.Switch}"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.x:pointerover controls|VectorIcon">
        <Setter Property="RenderTransform" Value="rotate(90deg)"/>
    </Style>

    <!-- نصوص -->
    <Style Selector="TextBlock.lbl">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- حقول النص .inp: 44 ارتفاعًا -->
    <Style Selector="TextBox.inp">
        <Setter Property="Height" Value="44"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AmberBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushControl}"/>
        <Setter Property="Background" Value="{DynamicResource PageBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.inp:pointerover /template/ Border#PART_BorderElement,
                     TextBox.inp:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource PageBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FieldFocusBorderBrush}"/>
    </Style>
    <Style Selector="TextBox.inp:pointerover, TextBox.inp:focus">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style Selector="TextBox.inp /template/ TextBlock#PART_Watermark,
                     TextBox.inp /template/ TextBlock#PART_FloatingWatermark">
        <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
    </Style>

    <!-- حقل البحث: بلا إطار لأن الإطار المتدرج في الخلف -->
    <Style Selector="TextBox.bare">
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AmberBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement,
                     TextBox.bare:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox.bare:pointerover, TextBox.bare:focus">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style Selector="TextBox.bare /template/ TextBlock#PART_Watermark">
        <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
    </Style>

    <!-- صندوق المسار .code: نص أحادي العرض من اليسار دائمًا -->
    <Style Selector="Border.code">
        <Setter Property="Background" Value="{DynamicResource PageBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCard}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="FlowDirection" Value="LeftToRight"/>
    </Style>
    <Style Selector="Border.code TextBlock">
        <Setter Property="FontFamily" Value="Consolas, ui-monospace, monospace"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource MenuTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- صندوق الحالة .stat -->
    <Style Selector="Border.stat">
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="{DynamicResource PageBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCard}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.35"/>
                <BrushTransition Property="Background" Duration="0:0:0.35"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.stat.ok">
        <Setter Property="BorderBrush" Value="{DynamicResource StatOkBorderBrush}"/>
        <Setter Property="Background" Value="{DynamicResource StatOkBackground}"/>
    </Style>
    <Style Selector="Border.stat.bad">
        <Setter Property="BorderBrush" Value="{DynamicResource StatBadBorderBrush}"/>
        <Setter Property="Background" Value="{DynamicResource StatBadBackground}"/>
    </Style>
    <Style Selector="Border.stat TextBlock.stat-title">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="Border.stat.wait TextBlock.stat-title">
        <Setter Property="Foreground" Value="{DynamicResource ChipTextBrush}"/>
    </Style>
    <Style Selector="Border.stat.bad TextBlock.stat-title">
        <Setter Property="Foreground" Value="{DynamicResource StatBadTextBrush}"/>
    </Style>

    <!-- صف مفتاح وقيمة .kv -->
    <Style Selector="Border.kv">
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="0,10"/>
    </Style>
    <Style Selector="Border.kv TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style Selector="Border.kv TextBlock.k">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="Width" Value="150"/>
        <Setter Property="Margin" Value="0,0,16,0"/>
    </Style>

    <!-- قوائم Flyout -->
    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource MenuBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="ScrollBar">
        <Setter Property="AllowAutoHide" Value="True"/>
    </Style>

    <!-- أنماط بطاقة اللعبة: هنا مرة واحدة للبرنامج كله. كانت داخل GameCard فتُنشأ نسخة منها لكل بطاقة
         (25 نمطًا × عدد الألعاب)، وهذا يأكل الذاكرة في المكتبات الكبيرة -->
    <Style Selector="Border.face">
        <Setter Property="RenderTransform" Value="translateY(0px)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Panel.card:pointerover Border.face">
        <Setter Property="RenderTransform" Value="translateY(-4px)"/>
        <Setter Property="BoxShadow" Value="{DynamicResource GlowCardHover}"/>
    </Style>
    <!-- إعداد "حركة الغلاف عند المرور" مطفأ -->
    <Style Selector="Panel.nohover Panel.card:pointerover Border.face">
        <Setter Property="RenderTransform" Value="translateY(0px)"/>
        <Setter Property="BoxShadow" Value="0 0 0 0 #00000000"/>
    </Style>

    <Style Selector="Button.eb">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="CornerRadius" Value="22"/>
    </Style>
    <Style Selector="Button.eb.open /template/ Border#PART_Root">
        <Setter Property="BoxShadow" Value="{DynamicResource GlowMenuOpen}"/>
    </Style>
    <Style Selector="Button.eb">
        <Setter Property="Transitions">
            <Transitions><BrushTransition Property="Background" Duration="0:0:0.3"/></Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.eb /template/ Border#PART_Root">
        <Setter Property="Transitions">
            <Transitions><BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.3"/></Transitions>
        </Setter>
    </Style>
    <Style Selector="Panel.mt">
        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="Transitions">
            <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="{x:Static l:Springs.Pop}"/></Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.eb:pressed Panel.mt">
        <Setter Property="RenderTransform" Value="scale(0.85)"/>
    </Style>
    <Style Selector="Button.eb:pointerover controls|MenuCloseIcon">
        <Setter Property="Foreground" Value="{DynamicResource RedHoverBrush}"/>
    </Style>
    <Style Selector="Button.eb.open">
        <Setter Property="Background" Value="{DynamicResource MenuOpenGradient}"/>
    </Style>
    <Style Selector="Button.eb.open:pointerover controls|MenuCloseIcon">
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Button.mi">
        <Setter Property="Height" Value="38"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style Selector="Button.mi:pointerover">
        <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
    </Style>

    <!-- شارة الحالة: اللون من النبرة -->
    <Style Selector="Border.st.t0"><Setter Property="BorderBrush" Value="#9C8A8A"/></Style>
    <Style Selector="Border.st.t0 TextBlock"><Setter Property="Foreground" Value="#9C8A8A"/></Style>
    <Style Selector="Border.st.t1"><Setter Property="BorderBrush" Value="#34D399"/></Style>
    <Style Selector="Border.st.t1 TextBlock"><Setter Property="Foreground" Value="#34D399"/></Style>
    <Style Selector="Border.st.t2"><Setter Property="BorderBrush" Value="#EF4444"/></Style>
    <Style Selector="Border.st.t2 TextBlock"><Setter Property="Foreground" Value="#EF4444"/></Style>
    <Style Selector="Border.st.t3"><Setter Property="BorderBrush" Value="#F5A623"/></Style>
    <Style Selector="Border.st.t3 TextBlock"><Setter Property="Foreground" Value="#F5A623"/></Style>

    <!-- لعبة على قرص غير موصول: تبقى في المكتبة باهتة -->
    <Style Selector="Border.cover-layer.offline">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>
</Styles>
