<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HalawaHub.App.ViewModels"
             xmlns:l="using:HalawaHub.App.Services"
             x:Class="HalawaHub.App.Views.ComingSoonView"
             x:DataType="vm:MainViewModel">

    <!-- المحتوى في منتصف مساحة أقصاها 700 كما في التصميم، وفي النوافذ الأقصر في منتصف المتاح -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1000*" MaxHeight="700"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" Spacing="56" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel MaxWidth="420" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="{l:Loc soonTitle}" FontSize="44" FontWeight="Bold"/>
                    <TextBlock Text="{l:Loc soonText}" FontSize="17" LineHeight="27"
                               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                    <Border Name="Bar" Height="8" CornerRadius="4" Background="{DynamicResource ChipBrush}" ClipToBounds="True">
                        <Border Name="BarFill" CornerRadius="4" HorizontalAlignment="Left" Background="{DynamicResource ComingSoonGradient}"/>
                    </Border>
                    <TextBlock Classes="lbl" Text="{l:Loc inDev}"/>
                    <Button Classes="btn pri" HorizontalAlignment="Left" Margin="0,8,0,0"
                            Command="{Binding GoLibraryCommand}" Content="{l:Loc back}"/>
                </StackPanel>

                <Border Width="270" Height="414" CornerRadius="14" ClipToBounds="True" VerticalAlignment="Center">
                    <Image Source="avares://Halawa-Hub/Assets/mascot-coming-soon.png" Stretch="UniformToFill"/>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
