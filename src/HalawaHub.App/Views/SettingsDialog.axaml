<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HalawaHub.App.ViewModels"
             xmlns:l="using:HalawaHub.App.Services"
             xmlns:c="using:HalawaHub.App.Controls"
             xmlns:conv="using:HalawaHub.App.Converters"
             x:Class="HalawaHub.App.Views.SettingsDialog"
             x:Name="Root"
             x:DataType="vm:MainViewModel"
             IsVisible="{Binding IsSettingsVisible}">

    <UserControl.Styles>
        <Style Selector="Button.seg">
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Transitions">
                <Transitions><BrushTransition Property="Foreground" Duration="0:0:0.3"/></Transitions>
            </Setter>
        </Style>
        <Style Selector="Panel.spin">
            <Setter Property="Width" Value="0"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.25"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                    <ThicknessTransition Property="Margin" Duration="0:0:0.25"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.busy Panel.spin">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style Selector="Button.seg.on, Button.seg.on:pointerover">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- مجموعة اختيارات (الثيم، الحركة، العرض...): الخيار المختار بلون التمييز -->
        <Style Selector="Border.choice">
            <Setter Property="Background" Value="{DynamicResource PageBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCard}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="Button.ch">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.ch:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
        </Style>
        <Style Selector="Button.ch.on, Button.ch.on:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentDeepBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.sw">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.sw.on">
            <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style Selector="Button.ib.pick.on /template/ Border#PART_Root">
            <Setter Property="BorderBrush" Value="{DynamicResource RedHoverBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="TextBlock.row">
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <Border Name="Scrim" Background="{DynamicResource ScrimBrush}" PointerPressed="Scrim_PointerPressed"/>

        <!-- الحجم يتبع البرنامج: 80% منه، لا أصغر من 900×540 ولا أكبر من 1400×900، ودائمًا داخله -->
        <c:DialogFrame Name="Frame" MinFrameWidth="900" MinFrameHeight="540">
        <Border Name="DialogBox" CornerRadius="14" Background="{DynamicResource DialogBrush}"
                BorderBrush="{DynamicResource BorderBrushCard}" BorderThickness="1"
                BoxShadow="0 30 80 0 #B3000000" RenderTransformOrigin="50%,50%">
            <Border CornerRadius="13" ClipToBounds="True">
            <Panel>
                <!-- وهج أعلى النافذة، ثابت في جهة اليمين -->
                <Border IsHitTestVisible="False" FlowDirection="LeftToRight" Background="{DynamicResource DialogGlowBrush}"/>

                <Grid ColumnDefinitions="230,*">
                    <!-- الشريط الجانبي -->
                    <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushCard}"
                            BorderThickness="0,0,1,0" Padding="12,20">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="10,0,10,14" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="36" Height="36" CornerRadius="9" Background="#000000" BoxShadow="{DynamicResource GlowLogo}">
                                        <Border CornerRadius="9" ClipToBounds="True">
                                            <Image Source="avares://Halawa-Hub/Assets/logo.png" Stretch="UniformToFill"/>
                                        </Border>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Halawa Hub" FontSize="15" FontWeight="Bold" FontFamily="fonts:Inter#Inter"/>
                                        <TextBlock Text="{Binding AppVersion}" FontSize="12" Foreground="{DynamicResource SubtleBrush}" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{l:Loc setTitle}" Grid.Row="1" Foreground="{DynamicResource RedHoverBrush}" FontWeight="Bold"
                                       FontSize="15" Margin="10,0,10,12"/>

                            <!-- الأقسام بترتيب الظهور؛ رقم كل قسم ثابت، والشريط يتبع موضعه (SettingsPillIndex) -->
                            <ScrollViewer Name="NavScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <Panel VerticalAlignment="Top">
                                <c:SlidingPill Name="SettingsNavPill" Orientation="Vertical" Pitch="48" Motion="Dialog" ItemCount="{Binding SettingsSectionCount}" IsHitTestVisible="False"
                                               SelectedIndex="{Binding SettingsPillIndex}">
                                    <Border CornerRadius="10" Background="{DynamicResource RedGradient}" BoxShadow="{DynamicResource GlowM}"/>
                                </c:SlidingPill>
                                <StackPanel Spacing="4">
                                    <Button Classes="si" Classes.on="{Binding SettingsSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=4}"
                                            Command="{Binding SelectSettingsSectionCommand}" CommandParameter="4" Content="{l:Loc sGeneral}"/>
                                    <Button Classes="si" Classes.on="{Binding SettingsSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=7}"
                                            Command="{Binding SelectSettingsSectionCommand}" CommandParameter="7" Content="{l:Loc sLibrary}"/>
                                    <Button Classes="si" Classes.on="{Binding SettingsSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=10}"
                                            Command="{Binding SelectSettingsSectionCommand}" CommandParameter="10" Content="{l:Loc sCollections}"/>
                                    <Button Classes="si" Classes.on="{Binding SettingsSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=3}"
                                            Command="{Binding SelectSettingsSectionCommand}" CommandParameter="3" Content="{l:Loc sAppearance}"/>
                                    <Button Classes="si" Classes.on="{Binding SettingsSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=8}"
                                            Command="{Binding SelectSettingsSectionCommand}" CommandParameter="8" Content="{l:Loc sPlatforms}"/>
                                    <Button Classes="si" Classes.on="{Binding SettingsSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=11}"
                                            Command="{Binding SelectSettingsSectionCommand}" CommandParameter="11" Content="{l:Loc sSubscriptions}"/>
                                    <Button Classes="si" Classes.on="{Binding SettingsSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=1}"
                                            Command="{Binding SelectSettingsSectionCommand}" CommandParameter="1" Content="{l:Loc sLanguage}"/>
                                    <Button Classes="si" Classes.on="{Binding SettingsSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=2}"
                                            Command="{Binding SelectSettingsSectionCommand}" CommandParameter="2" Content="{l:Loc sApi}"/>
                                    <Button Classes="si" Classes.on="{Binding SettingsSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=6}"
                                            Command="{Binding SelectSettingsSectionCommand}" CommandParameter="6" Content="{l:Loc sPlugins}"/>
                                    <Button Classes="si" Classes.on="{Binding SettingsSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=0}"
                                            Command="{Binding SelectSettingsSectionCommand}" CommandParameter="0" Content="{l:Loc sUpdates}"/>
                                    <Button Classes="si" Classes.on="{Binding SettingsSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=9}"
                                            Command="{Binding SelectSettingsSectionCommand}" CommandParameter="9" Content="{l:Loc sTools}"/>
                                    <Button Classes="si" Classes.on="{Binding SettingsSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=5}"
                                            Command="{Binding SelectSettingsSectionCommand}" CommandParameter="5" Content="{l:Loc sBuild}"/>
                                </StackPanel>
                            </Panel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- المحتوى -->
                    <Grid Grid.Column="1" Margin="26,22" RowDefinitions="Auto,*,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                            <TextBlock Name="Title" Classes="h2" Text="{Binding SettingsTitle}"/>
                            <Button Grid.Column="1" Classes="x" Command="{Binding CloseSettingsCommand}"
                                    ToolTip.Tip="{l:Loc close}" AutomationProperties.Name="{l:Loc close}">
                                <c:VectorIcon Data="{StaticResource IconX}" Size="18"/>
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" Name="Body" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <Panel>
                                <!-- التحديثات -->
                                <StackPanel Spacing="12" IsVisible="{Binding SettingsSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=0}">
                                    <Border Classes="kv">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Classes="k" Text="{l:Loc curVersion}"/>
                                            <TextBlock Text="{Binding AppVersion}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="stat"
                                            Classes.ok="{Binding UpdateBadge, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=Done}"
                                            Classes.bad="{Binding UpdateBadge, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=Error}"
                                            Classes.wait="{Binding UpdateBadge, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=Pending}">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                            <c:StatusBadge State="{Binding UpdateBadge}" VerticalAlignment="Center"/>
                                            <TextBlock Name="UpdateStatusLabel" Grid.Column="1" Classes="stat-title" RenderTransformOrigin="50%,50%" Text="{Binding UpdateStatusText}"
                                                       VerticalAlignment="Center" Margin="14,0"/>
                                            <Button Grid.Column="2" Classes="btn pri" Margin="0,0,10,0" Content="{Binding InstallButtonText}"
                                                    IsVisible="{Binding IsUpdateAvailable}" Command="{Binding InstallUpdateCommand}"/>
                                            <Button Grid.Column="3" Classes="btn" Classes.busy="{Binding IsCheckingForUpdates}"
                                                    Command="{Binding CheckForUpdatesNowCommand}" AutomationProperties.Name="{l:Loc check}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Panel Classes="spin" Height="16" ClipToBounds="True" VerticalAlignment="Center">
                                                        <Panel Name="SpinRing" Classes="spin-ring" FlowDirection="LeftToRight" Width="16" Height="16" HorizontalAlignment="Left">
                                                            <Panel.RenderTransform><RotateTransform/></Panel.RenderTransform>
                                                            <Ellipse Stroke="{DynamicResource Wash25Brush}" StrokeThickness="2"/>
                                                            <Arc Stroke="{DynamicResource AmberBrush}" StrokeThickness="2" StartAngle="-90" SweepAngle="90"/>
                                                        </Panel>
                                                    </Panel>
                                                    <TextBlock Text="{l:Loc check}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <TextBlock Classes="lbl" Text="{Binding UpdateMessage}" IsVisible="{Binding IsInstallingUpdate}"
                                               Foreground="{DynamicResource AmberBrush}"/>
                                    <TextBlock Classes="lbl" Text="{l:Loc installNote}"/>
                                </StackPanel>

                                <!-- اللغة -->
                                <StackPanel Spacing="12" IsVisible="{Binding SettingsSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=1}">
                                    <Border Width="182" HorizontalAlignment="Left" CornerRadius="10" Background="{DynamicResource PageBrush}"
                                            BorderBrush="{DynamicResource BorderBrushCard}" BorderThickness="1">
                                        <Panel Height="44">
                                            <c:SlidingPill ItemCount="2" SelectedIndex="{Binding LanguageIndex}" Inset="4" Motion="Even" Margin="0,4" IsHitTestVisible="False">
                                                <Border CornerRadius="8" Background="{DynamicResource AccentDeepBrush}" BoxShadow="{DynamicResource GlowS}"/>
                                            </c:SlidingPill>
                                            <UniformGrid Columns="2" Margin="4">
                                                <Button Classes="seg" Classes.on="{Binding LanguageIndex, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=0}"
                                                        Command="{Binding SetLanguageCommand}" CommandParameter="ar" AutomationProperties.Name="عربي">
                                                    <TextBlock Text="عربي" FontFamily="avares://Halawa-Hub/Assets/Fonts#Cairo"/>
                                                </Button>
                                                <Button Classes="seg" Classes.on="{Binding LanguageIndex, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=1}"
                                                        Command="{Binding SetLanguageCommand}" CommandParameter="en" AutomationProperties.Name="English">
                                                    <TextBlock Text="English" FontFamily="fonts:Inter#Inter"/>
                                                </Button>
                                            </UniformGrid>
                                        </Panel>
                                    </Border>
                                    <TextBlock Classes="lbl" Text="{l:Loc langNote}"/>
                                </StackPanel>

                                <!-- مفاتيح API -->
                                <StackPanel Spacing="12" IsVisible="{Binding SettingsSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=2}">
                                    <TextBlock Classes="lbl" Text="{l:Loc sgdb}"/>
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBox Classes="inp" PasswordChar="•" Text="{Binding SteamGridDbApiKey, Mode=TwoWay}"
                                                 Watermark="{l:Loc keyPh}" AutomationProperties.Name="SteamGridDB"/>
                                        <Button Grid.Column="1" Classes="btn" Margin="10,0,0,0" Content="{l:Loc verify}"
                                                Command="{Binding VerifyApiKeyCommand}"/>
                                        <Button Grid.Column="2" Classes="btn" Margin="10,0,0,0" Content="{l:Loc getKey}"
                                                Command="{Binding OpenUrlCommand}" CommandParameter="{Binding SteamGridDbKeyUrl}"/>
                                    </Grid>
                                    <TextBlock Classes="lbl" FontSize="12" Text="{Binding SecretStorageText}" TextWrapping="Wrap"/>
                                    <Border Classes="stat" IsVisible="{Binding HasApiKeyStatus}"
                                            Classes.ok="{Binding ApiKeyBadge, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=Done}"
                                            Classes.bad="{Binding ApiKeyBadge, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=Error}"
                                            Classes.wait="{Binding ApiKeyBadge, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=Pending}">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <c:StatusBadge State="{Binding ApiKeyBadge}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Classes="stat-title" Text="{Binding ApiKeyStatusText}"/>
                                                <TextBlock Text="SteamGridDB" FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- عام -->
                                <StackPanel Spacing="10" IsVisible="{Binding SettingsSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=4}">
                                    <c:CappedWidth Cap="480">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Classes="row" Text="{l:Loc startWith}"/>
                                            <TextBlock Classes="note" Text="{l:Loc startNote}" IsVisible="{Binding IsStartupSupported}"/>
                                            <TextBlock Classes="note" Text="{l:Loc startUnsupported}" IsVisible="{Binding !IsStartupSupported}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Theme="{StaticResource SwitchTheme}" IsChecked="{Binding LaunchOnStartup, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsStartupSupported}" AutomationProperties.Name="{l:Loc startWith}"/>
                                    </Grid>
                                    </c:CappedWidth>
                                    <c:CappedWidth Cap="480">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Classes="row" Text="{l:Loc startMin}"/>
                                            <TextBlock Classes="note" Text="{l:Loc startMinNote}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Theme="{StaticResource SwitchTheme}" IsChecked="{Binding StartMinimized, Mode=TwoWay}"
                                                      AutomationProperties.Name="{l:Loc startMin}"/>
                                    </Grid>
                                    </c:CappedWidth>
                                    <c:CappedWidth Cap="480" IsVisible="{Binding IsAppMenuSupported}">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Classes="row" Text="{l:Loc appMenu}"/>
                                            <TextBlock Classes="note" Text="{l:Loc appMenuNote}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Theme="{StaticResource SwitchTheme}" IsChecked="{Binding ShowInAppMenu, Mode=TwoWay}"
                                                      AutomationProperties.Name="{l:Loc appMenu}"/>
                                    </Grid>
                                    </c:CappedWidth>
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="row" Text="{l:Loc closeBtn}"/>
                                        <Border Classes="choice">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Button Classes="ch" Classes.on="{Binding CloseActionIndex, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=0}"
                                                        Command="{Binding SettingChoiceCommand}" CommandParameter="close:tray" Content="{l:Loc closeTray}"/>
                                                <Button Classes="ch" Classes.on="{Binding CloseActionIndex, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=1}"
                                                        Command="{Binding SettingChoiceCommand}" CommandParameter="close:exit" Content="{l:Loc closeExit}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Classes="note" Text="{l:Loc closeBtnNote}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="row" Text="{l:Loc startTab}"/>
                                        <Border Classes="choice">
                                            <WrapPanel>
                                                <Button Classes="ch" Classes.on="{Binding StartTab, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=0}"
                                                        Command="{Binding SettingChoiceCommand}" CommandParameter="starttab:0" Content="{l:Loc home}"/>
                                                <Button Classes="ch" Classes.on="{Binding StartTab, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=1}"
                                                        Command="{Binding SettingChoiceCommand}" CommandParameter="starttab:1" Content="{l:Loc favorites}"/>
                                                <Button Classes="ch" Classes.on="{Binding StartTab, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=2}"
                                                        Command="{Binding SettingChoiceCommand}" CommandParameter="starttab:2" Content="{l:Loc installed}"/>
                                                <Button Classes="ch" Classes.on="{Binding StartTab, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=3}"
                                                        Command="{Binding SettingChoiceCommand}" CommandParameter="starttab:3" Content="{l:Loc recent}"/>
                                            </WrapPanel>
                                        </Border>
                                        <TextBlock Classes="note" Text="{l:Loc startTabNote}"/>
                                    </StackPanel>
                                    <c:CappedWidth Cap="480">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Classes="row" Text="{l:Loc minOnPlay}"/>
                                            <TextBlock Classes="note" Text="{l:Loc minOnPlayNote}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Theme="{StaticResource SwitchTheme}" IsChecked="{Binding MinimizeOnGameStart, Mode=TwoWay}"
                                                      AutomationProperties.Name="{l:Loc minOnPlay}"/>
                                    </Grid>
                                    </c:CappedWidth>
                                    <c:CappedWidth Cap="480">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Classes="row" Text="{l:Loc closeSteam}"/>
                                            <TextBlock Classes="note" Text="{l:Loc closeSteamNote}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Theme="{StaticResource SwitchTheme}" IsChecked="{Binding CloseSteamAfterGame, Mode=TwoWay}"
                                                      AutomationProperties.Name="{l:Loc closeSteam}"/>
                                    </Grid>
                                    </c:CappedWidth>
                                    <TextBlock Classes="lbl" Text="{l:Loc notifications}" Margin="0,8,0,0"/>
                                    <c:CappedWidth Cap="480">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Classes="row" Text="{l:Loc ntfUpdate}"/>
                                            <TextBlock Classes="note" Text="{l:Loc ntfUpdateNote}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Theme="{StaticResource SwitchTheme}" IsChecked="{Binding NotifyGameUpdates, Mode=TwoWay}"
                                                      AutomationProperties.Name="{l:Loc ntfUpdate}"/>
                                    </Grid>
                                    </c:CappedWidth>
                                    <c:CappedWidth Cap="480">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Classes="row" Text="{l:Loc ntfLaunch}"/>
                                            <TextBlock Classes="note" Text="{l:Loc ntfLaunchNote}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Theme="{StaticResource SwitchTheme}" IsChecked="{Binding NotifyLaunchFailed, Mode=TwoWay}"
                                                      AutomationProperties.Name="{l:Loc ntfLaunch}"/>
                                    </Grid>
                                    </c:CappedWidth>
                                    <c:CappedWidth Cap="480">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Classes="row" Text="{l:Loc ntfScan}"/>
                                            <TextBlock Classes="note" Text="{l:Loc ntfScanNote}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Theme="{StaticResource SwitchTheme}" IsChecked="{Binding NotifyScan, Mode=TwoWay}"
                                                      AutomationProperties.Name="{l:Loc ntfScan}"/>
                                    </Grid>
                                    </c:CappedWidth>
                                    <c:CappedWidth Cap="480">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Classes="row" Text="{l:Loc ntfApp}"/>
                                            <TextBlock Classes="note" Text="{l:Loc ntfAppNote}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Theme="{StaticResource SwitchTheme}" IsChecked="{Binding NotifyAppUpdate, Mode=TwoWay}"
                                                      AutomationProperties.Name="{l:Loc ntfApp}"/>
                                    </Grid>
                                    </c:CappedWidth>
                                </StackPanel>

                                <!-- المكتبة -->
                                <StackPanel Spacing="16" IsVisible="{Binding SettingsSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=7}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="row" Text="{l:Loc layout}"/>
                                        <Border Classes="choice">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Button Classes="ch" Classes.on="{Binding LibraryLayoutIndex, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=0}"
                                                        Command="{Binding SettingChoiceCommand}" CommandParameter="layout:grid" Content="{l:Loc layoutGrid}"/>
                                                <Button Classes="ch" Classes.on="{Binding LibraryLayoutIndex, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=1}"
                                                        Command="{Binding SettingChoiceCommand}" CommandParameter="layout:list" Content="{l:Loc layoutList}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Classes="note" Text="{l:Loc layoutNote}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="row" Text="{l:Loc cardSize}"/>
                                        <Border Classes="choice">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Button Classes="ch" Classes.on="{Binding CardSizeIndex, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=0}"
                                                        Command="{Binding SettingChoiceCommand}" CommandParameter="cardsize:small" Content="{l:Loc sizeSmall}"/>
                                                <Button Classes="ch" Classes.on="{Binding CardSizeIndex, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=1}"
                                                        Command="{Binding SettingChoiceCommand}" CommandParameter="cardsize:comfortable" Content="{l:Loc sizeComfortable}"/>
                                                <Button Classes="ch" Classes.on="{Binding CardSizeIndex, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=2}"
                                                        Command="{Binding SettingChoiceCommand}" CommandParameter="cardsize:large" Content="{l:Loc sizeLarge}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Classes="note" Text="{l:Loc cardSizeNote}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="row" Text="{l:Loc defaultSort}"/>
                                        <Border Classes="choice">
                                            <WrapPanel>
                                                <Button Classes="ch" Classes.on="{Binding SortMode, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=name}"
                                                        Command="{Binding SetSortModeCommand}" CommandParameter="name" Content="{l:Loc sortName}"/>
                                                <Button Classes="ch" Classes.on="{Binding SortMode, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=lastplayed}"
                                                        Command="{Binding SetSortModeCommand}" CommandParameter="lastplayed" Content="{l:Loc sortLastPlayed}"/>
                                                <Button Classes="ch" Classes.on="{Binding SortMode, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=playtime}"
                                                        Command="{Binding SetSortModeCommand}" CommandParameter="playtime" Content="{l:Loc sortPlayTime}"/>
                                                <Button Classes="ch" Classes.on="{Binding SortMode, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=added}"
                                                        Command="{Binding SetSortModeCommand}" CommandParameter="added" Content="{l:Loc sortAdded}"/>
                                                <Button Classes="ch" Classes.on="{Binding SortMode, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=platform}"
                                                        Command="{Binding SetSortModeCommand}" CommandParameter="platform" Content="{l:Loc sortPlatform}"/>
                                            </WrapPanel>
                                        </Border>
                                        <TextBlock Classes="note" Text="{l:Loc defaultSortNote}"/>
                                    </StackPanel>
                                    <c:CappedWidth Cap="480">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Classes="row" Text="{l:Loc showStats}"/>
                                            <TextBlock Classes="note" Text="{l:Loc showStatsNote}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Theme="{StaticResource SwitchTheme}" IsChecked="{Binding ShowPlayTimeOnCards, Mode=TwoWay}"
                                                      AutomationProperties.Name="{l:Loc showStats}"/>
                                    </Grid>
                                    </c:CappedWidth>
                                    <c:CappedWidth Cap="480">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Classes="row" Text="{l:Loc showHidden}"/>
                                            <TextBlock Classes="note" Text="{l:Loc showHiddenNote}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Theme="{StaticResource SwitchTheme}" IsChecked="{Binding ShowHiddenGames, Mode=TwoWay}"
                                                      AutomationProperties.Name="{l:Loc showHidden}"/>
                                    </Grid>
                                    </c:CappedWidth>
                                    <c:CappedWidth Cap="480">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Classes="row" Text="{l:Loc showFree}"/>
                                            <TextBlock Classes="note" Text="{l:Loc showFreeNote}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Theme="{StaticResource SwitchTheme}" IsChecked="{Binding ShowFreeGames, Mode=TwoWay}"
                                                      AutomationProperties.Name="{l:Loc showFree}"/>
                                    </Grid>
                                    </c:CappedWidth>
                                </StackPanel>

                                <!-- المظهر -->
                                <StackPanel Spacing="16" IsVisible="{Binding SettingsSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=3}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="row" Text="{l:Loc theme}"/>
                                        <Border Classes="choice">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Button Classes="ch" Classes.on="{Binding ThemeIndex, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=0}"
                                                        Command="{Binding SettingChoiceCommand}" CommandParameter="theme:dark" Content="{l:Loc themeDark}"/>
                                                <Button Classes="ch" Classes.on="{Binding ThemeIndex, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=1}"
                                                        Command="{Binding SettingChoiceCommand}" CommandParameter="theme:oled" Content="{l:Loc themeOled}"/>
                                                <Button Classes="ch" Classes.on="{Binding ThemeIndex, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=2}"
                                                        Command="{Binding SettingChoiceCommand}" CommandParameter="theme:light" Content="{l:Loc themeLight}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Classes="note" Text="{l:Loc themeNote}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="row" Text="{l:Loc accent}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Classes="sw" Background="#DC2626" Classes.on="{Binding AccentKey, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=red}"
                                                    Command="{Binding SettingChoiceCommand}" CommandParameter="accent:red" ToolTip.Tip="{l:Loc accentRed}" AutomationProperties.Name="{l:Loc accentRed}"/>
                                            <Button Classes="sw" Background="#2563EB" Classes.on="{Binding AccentKey, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=blue}"
                                                    Command="{Binding SettingChoiceCommand}" CommandParameter="accent:blue" ToolTip.Tip="{l:Loc accentBlue}" AutomationProperties.Name="{l:Loc accentBlue}"/>
                                            <Button Classes="sw" Background="#9333EA" Classes.on="{Binding AccentKey, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=purple}"
                                                    Command="{Binding SettingChoiceCommand}" CommandParameter="accent:purple" ToolTip.Tip="{l:Loc accentPurple}" AutomationProperties.Name="{l:Loc accentPurple}"/>
                                            <Button Classes="sw" Background="#15803D" Classes.on="{Binding AccentKey, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=green}"
                                                    Command="{Binding SettingChoiceCommand}" CommandParameter="accent:green" ToolTip.Tip="{l:Loc accentGreen}" AutomationProperties.Name="{l:Loc accentGreen}"/>
                                            <Button Classes="sw" Background="#C2410C" Classes.on="{Binding AccentKey, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=orange}"
                                                    Command="{Binding SettingChoiceCommand}" CommandParameter="accent:orange" ToolTip.Tip="{l:Loc accentOrange}" AutomationProperties.Name="{l:Loc accentOrange}"/>
                                        </StackPanel>
                                        <TextBlock Classes="note" Text="{l:Loc accentNote}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="row" Text="{l:Loc reduceMotion}"/>
                                        <Border Classes="choice">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Button Classes="ch" Classes.on="{Binding ReduceMotionIndex, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=0}"
                                                        Command="{Binding SettingChoiceCommand}" CommandParameter="motion:off" Content="{l:Loc motionOff}"/>
                                                <Button Classes="ch" Classes.on="{Binding ReduceMotionIndex, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=1}"
                                                        Command="{Binding SettingChoiceCommand}" CommandParameter="motion:on" Content="{l:Loc motionOn}"/>
                                                <Button Classes="ch" Classes.on="{Binding ReduceMotionIndex, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=2}"
                                                        Command="{Binding SettingChoiceCommand}" CommandParameter="motion:auto" Content="{l:Loc motionAuto}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Classes="note" Text="{l:Loc reduceMotionNote}"/>
                                        <TextBlock Classes="note" Text="{Binding ReduceMotionStateText}" IsVisible="{Binding ReduceMotionStateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>
                                    <c:CappedWidth Cap="480">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Classes="row" Text="{l:Loc coverHover}"/>
                                            <TextBlock Classes="note" Text="{l:Loc coverHoverNote}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Theme="{StaticResource SwitchTheme}" IsChecked="{Binding CoverHoverAnimation, Mode=TwoWay}"
                                                      AutomationProperties.Name="{l:Loc coverHover}"/>
                                    </Grid>
                                    </c:CappedWidth>
                                </StackPanel>

                                <!-- المنصات -->
                                <StackPanel Spacing="12" IsVisible="{Binding SettingsSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=8}">
                                    <TextBlock Classes="note" Text="{l:Loc platformsNote}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Classes="btn" Content="{l:Loc redetect}" Command="{Binding RedetectPlatformsCommand}"/>
                                        <Button Classes="btn pri" Content="{l:Loc scanThisPc}" Command="{Binding RefreshCommand}"/>
                                    </StackPanel>
                                    <!-- وقت اللعب من Steam -->
                                    <c:CappedWidth Cap="480">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Classes="row" Text="{l:Loc steamImport}"/>
                                            <TextBlock Classes="note" Text="{l:Loc steamImportNote}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Theme="{StaticResource SwitchTheme}" IsChecked="{Binding ImportSteamPlaytime, Mode=TwoWay}"
                                                      AutomationProperties.Name="{l:Loc steamImport}"/>
                                    </Grid>
                                    </c:CappedWidth>
                                    <StackPanel Spacing="6" IsVisible="{Binding HasSeveralSteamAccounts}">
                                        <TextBlock Classes="row" Text="{l:Loc steamAccount}"/>
                                        <Border Classes="choice">
                                            <ItemsControl ItemsSource="{Binding SteamAccounts}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:SteamAccountChoice">
                                                        <Button Classes="ch" Classes.on="{Binding IsSelected}" Content="{Binding Name}"
                                                                Command="{Binding #Root.((vm:MainViewModel)DataContext).SelectSteamAccountCommand}"
                                                                CommandParameter="{Binding SteamId64}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                        <TextBlock Classes="note" Text="{l:Loc steamAccountNote}"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding PlatformRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PlatformRow">
                                                <Border Background="{DynamicResource PageBrush}" BorderBrush="{DynamicResource BorderBrushCard}" BorderThickness="1"
                                                        CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                                                    <StackPanel Spacing="4">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding DetectedText}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding GamesText}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                                                        <TextBlock Text="{Binding CapsText}" FontSize="12" TextWrapping="Wrap"/>
                                                        <SelectableTextBlock Text="{Binding PathText}" FontSize="11" Foreground="{DynamicResource SubtleBrush}"
                                                                             FlowDirection="LeftToRight" HorizontalAlignment="Left" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- المجموعات -->
                                <StackPanel Spacing="12" IsVisible="{Binding SettingsSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=10}">
                                    <!-- القائمة -->
                                    <StackPanel Spacing="12" IsVisible="{Binding IsCollectionListVisible}">
                                        <TextBlock Classes="note" Text="{l:Loc colNote}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Button Classes="btn pri" Content="{l:Loc colNewManual}" Command="{Binding NewManualCollectionCommand}"/>
                                            <Button Classes="btn" Content="{l:Loc colNewSmart}" Command="{Binding NewSmartCollectionCommand}"/>
                                        </StackPanel>
                                        <TextBlock Classes="lbl" Text="{l:Loc colEmpty}" IsVisible="{Binding HasNoCollections}"/>
                                        <ItemsControl Name="CollectionRows" ItemsSource="{Binding Collections}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CollectionItemViewModel">
                                                    <Border Classes="colrow" Height="56" Margin="0,0,0,8" Padding="8,0,12,0" CornerRadius="10"
                                                            Background="{DynamicResource PageBrush}" BorderBrush="{DynamicResource BorderBrushCard}" BorderThickness="1">
                                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                                            <!-- مقبض السحب لإعادة الترتيب -->
                                                            <Border Classes="grip" Width="26" Height="40" Background="Transparent" Cursor="SizeNorthSouth"
                                                                    ToolTip.Tip="{l:Loc colDrag}" VerticalAlignment="Center">
                                                                <TextBlock Text="⋮⋮" FontSize="14" Foreground="{DynamicResource SubtleBrush}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <c:VectorIcon Grid.Column="1" Data="{Binding Icon, Converter={x:Static conv:IconKeyConverter.Instance}}"
                                                                          Size="18" Margin="4,0,12,0" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <TextBlock Text="{Binding KindText}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                                                    <TextBlock Text="{Binding CountText}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <Button Classes="btn" Height="34" Padding="12,0" Content="{l:Loc colEditBtn}"
                                                                        Command="{Binding #Root.((vm:MainViewModel)DataContext).EditCollectionCommand}" CommandParameter="{Binding}"/>
                                                                <Button Classes="btn" Height="34" Padding="12,0" Content="{Binding HideLabel}"
                                                                        Command="{Binding #Root.((vm:MainViewModel)DataContext).ToggleCollectionHiddenCommand}" CommandParameter="{Binding}"/>
                                                                <Button Classes="btn" Height="34" Padding="12,0" Content="{l:Loc colDelete}"
                                                                        Command="{Binding #Root.((vm:MainViewModel)DataContext).DeleteCollectionCommand}" CommandParameter="{Binding}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Classes="note" Text="{l:Loc colBuiltIn}"/>
                                    </StackPanel>

                                    <!-- المحرر -->
                                    <StackPanel Spacing="12" IsVisible="{Binding IsEditingCollection}">
                                        <TextBlock Classes="row" FontWeight="SemiBold" Text="{Binding EditTitle}"/>
                                        <StackPanel Spacing="6">
                                            <TextBlock Classes="lbl" Text="{l:Loc colName}"/>
                                            <TextBox Name="CollectionNameBox" Classes="inp" Text="{Binding EditName, Mode=TwoWay}" MaxWidth="420" HorizontalAlignment="Left"
                                                     MinWidth="320" AutomationProperties.Name="{l:Loc colName}"/>
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <TextBlock Classes="lbl" Text="{l:Loc colIcon}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Classes="ib pick" Margin="0,0,8,0" Command="{Binding PickCollectionIconCommand}" CommandParameter="star" AutomationProperties.Name="star"
                                                        Classes.on="{Binding EditIcon, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=star}">
                                                    <c:VectorIcon Data="{StaticResource IconStar}" Size="18"/>
                                                </Button>
                                                <Button Classes="ib pick" Margin="0,0,8,0" Command="{Binding PickCollectionIconCommand}" CommandParameter="heart" AutomationProperties.Name="heart"
                                                        Classes.on="{Binding EditIcon, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=heart}">
                                                    <c:VectorIcon Data="{StaticResource IconHeart}" Size="18"/>
                                                </Button>
                                                <Button Classes="ib pick" Margin="0,0,8,0" Command="{Binding PickCollectionIconCommand}" CommandParameter="play" AutomationProperties.Name="play"
                                                        Classes.on="{Binding EditIcon, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=play}">
                                                    <c:VectorIcon Data="{StaticResource IconPlay}" Size="18"/>
                                                </Button>
                                                <Button Classes="ib pick" Margin="0,0,8,0" Command="{Binding PickCollectionIconCommand}" CommandParameter="sparkle" AutomationProperties.Name="sparkle"
                                                        Classes.on="{Binding EditIcon, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=sparkle}">
                                                    <c:VectorIcon Data="{StaticResource IconSparkle}" Size="18"/>
                                                </Button>
                                                <Button Classes="ib pick" Margin="0,0,8,0" Command="{Binding PickCollectionIconCommand}" CommandParameter="wrench" AutomationProperties.Name="wrench"
                                                        Classes.on="{Binding EditIcon, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=wrench}">
                                                    <c:VectorIcon Data="{StaticResource IconWrench}" Size="18"/>
                                                </Button>
                                                <Button Classes="ib pick" Margin="0,0,8,0" Command="{Binding PickCollectionIconCommand}" CommandParameter="bell" AutomationProperties.Name="bell"
                                                        Classes.on="{Binding EditIcon, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=bell}">
                                                    <c:VectorIcon Data="{StaticResource IconBell}" Size="18"/>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- شروط المجموعة الذكية -->
                                        <StackPanel Spacing="10" IsVisible="{Binding EditIsSmart}">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Classes="lbl" Text="{l:Loc colMatch}" VerticalAlignment="Center"/>
                                                <Border Classes="choice">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <Button Classes="ch" Classes.on="{Binding EditMatchIndex, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=0}"
                                                                Command="{Binding SetMatchCommand}" CommandParameter="all" Content="{l:Loc colAll}"/>
                                                        <Button Classes="ch" Classes.on="{Binding EditMatchIndex, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=1}"
                                                                Command="{Binding SetMatchCommand}" CommandParameter="any" Content="{l:Loc colAny}"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding EditRules}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:RuleEditorViewModel">
                                                        <WrapPanel Margin="0,0,0,8">
                                                            <ComboBox Width="170" Height="40" Margin="0,0,8,0" ItemsSource="{Binding FieldOptions}" SelectedItem="{Binding Field, Mode=TwoWay}"/>
                                                            <ComboBox Width="170" Height="40" Margin="0,0,8,0" ItemsSource="{Binding OpOptions}" SelectedItem="{Binding Op, Mode=TwoWay}"/>
                                                            <ComboBox Width="150" Height="40" Margin="0,0,8,0" ItemsSource="{Binding PlatformOptions}" SelectedItem="{Binding Platform, Mode=TwoWay}"
                                                                      IsVisible="{Binding IsPlatform}"/>
                                                            <TextBox Classes="inp" Width="150" Margin="0,0,8,0" Text="{Binding Value, Mode=TwoWay}" Watermark="{Binding ValueHint}"
                                                                     IsVisible="{Binding NeedsText}"/>
                                                            <Button Classes="x" VerticalAlignment="Center" ToolTip.Tip="{l:Loc colRemoveRule}" AutomationProperties.Name="{l:Loc colRemoveRule}"
                                                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).RemoveRuleCommand}" CommandParameter="{Binding}">
                                                                <c:VectorIcon Data="{StaticResource IconX}" Size="16"/>
                                                            </Button>
                                                        </WrapPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Classes="btn" HorizontalAlignment="Left" Content="{l:Loc colAddRule}" Command="{Binding AddRuleCommand}"/>
                                        </StackPanel>
                                        <TextBlock Classes="note" Text="{l:Loc colManualNote}" IsVisible="{Binding !EditIsSmart}"/>

                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Button Name="SaveCollectionButton" Classes="btn pri" Content="{l:Loc colSave}" Command="{Binding SaveCollectionCommand}"/>
                                            <Button Classes="btn" Content="{l:Loc cancel}" Command="{Binding CancelCollectionEditCommand}"/>
                                        </StackPanel>
                                        <TextBlock Classes="note" Foreground="{DynamicResource AmberBrush}" Text="{Binding EditProblem}"
                                                   IsVisible="{Binding EditProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- الاشتراكات -->
                                <StackPanel Spacing="12" IsVisible="{Binding SettingsSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=11}">
                                    <TextBlock Classes="note" Text="{l:Loc subNote}"/>
                                    <Border Classes="kv">
                                        <TextBlock Name="SubscriptionsTotal" Text="{Binding SubscriptionsTotalText}" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Classes="lbl" Text="{l:Loc subEmpty}" IsVisible="{Binding HasNoSubscriptions}"/>
                                    <ItemsControl ItemsSource="{Binding Subscriptions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SubscriptionRow">
                                                <Border Margin="0,0,0,8" Padding="14,10" CornerRadius="10" Background="{DynamicResource PageBrush}"
                                                        BorderBrush="{DynamicResource BorderBrushCard}" BorderThickness="1">
                                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding RenewalText}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding CostText}" FontSize="13" Margin="12,0" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="2" Classes="x" ToolTip.Tip="{l:Loc subRemove}" AutomationProperties.Name="{l:Loc subRemove}"
                                                                Command="{Binding #Root.((vm:MainViewModel)DataContext).RemoveSubscriptionCommand}" CommandParameter="{Binding}">
                                                            <c:VectorIcon Data="{StaticResource IconX}" Size="16"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Classes="row" Text="{l:Loc subAdd}"/>
                                    <WrapPanel>
                                        <TextBox Classes="inp" Width="200" Margin="0,0,8,8" Text="{Binding NewSubName, Mode=TwoWay}" Watermark="{l:Loc subNamePh}"/>
                                        <TextBox Classes="inp" Width="110" Margin="0,0,8,8" Text="{Binding NewSubCost, Mode=TwoWay}" Watermark="{l:Loc subCostPh}"
                                                 FlowDirection="LeftToRight"/>
                                        <TextBox Classes="inp" Width="150" Margin="0,0,8,8" Text="{Binding NewSubDate, Mode=TwoWay}" Watermark="YYYY-MM-DD"
                                                 FlowDirection="LeftToRight" AutomationProperties.Name="{l:Loc subDate}"/>
                                        <Border Classes="choice" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Button Classes="ch" Classes.on="{Binding NewSubCycleIndex, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=0}"
                                                        Command="{Binding SetSubCycleCommand}" CommandParameter="monthly" Content="{l:Loc subMonthly}"/>
                                                <Button Classes="ch" Classes.on="{Binding NewSubCycleIndex, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=1}"
                                                        Command="{Binding SetSubCycleCommand}" CommandParameter="yearly" Content="{l:Loc subYearly}"/>
                                            </StackPanel>
                                        </Border>
                                        <Button Classes="btn pri" Margin="0,0,8,8" Content="{l:Loc subAddBtn}" Command="{Binding AddSubscriptionCommand}"/>
                                    </WrapPanel>
                                    <TextBlock Classes="note" Text="{l:Loc subDateNote}"/>
                                </StackPanel>

                                <!-- الأدوات -->
                                <StackPanel Spacing="16" IsVisible="{Binding SettingsSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=9}">
                                    <StackPanel Spacing="6">
                                        <WrapPanel>
                                            <Button Classes="btn" Margin="0,0,10,8" Content="{l:Loc openLogs}" Command="{Binding OpenLogFolderCommand}"/>
                                            <Button Classes="btn" Margin="0,0,10,8" Content="{l:Loc openData}" Command="{Binding OpenDataFolderCommand}"/>
                                            <Button Classes="btn" Margin="0,0,10,8" Content="{l:Loc clearCovers}" Command="{Binding ClearCoverCacheCommand}"/>
                                        </WrapPanel>
                                        <TextBlock Classes="note" Text="{l:Loc toolsNote}"/>
                                    </StackPanel>
                                    <Border BorderBrush="{DynamicResource StatusRepairBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{l:Loc dangerZone}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource StatusRepairBrush}"/>
                                            <TextBlock Classes="note" Text="{l:Loc deleteAllNote}"/>
                                            <Button Classes="btn" HorizontalAlignment="Left" Content="{l:Loc deleteAll}" Command="{Binding DeleteAllDataCommand}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- الإضافات -->
                                <StackPanel Spacing="12" IsVisible="{Binding SettingsSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=6}">
                                    <TextBlock Classes="lbl" Text="{l:Loc pluginsNote}" TextWrapping="Wrap"/>
                                    <TextBlock Classes="lbl" Text="{l:Loc pluginsEmpty}" IsVisible="{Binding !HasPlugins}"/>
                                    <ItemsControl ItemsSource="{Binding PluginItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PluginItemViewModel">
                                                <c:CappedWidth Cap="560">
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,6">
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding FileName}" FontSize="15" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                                                        <TextBlock Classes="lbl" FontSize="12" Margin="0,2,0,0" Text="{Binding StateText}"/>
                                                        <SelectableTextBlock FontSize="11" Foreground="{DynamicResource SubtleBrush}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                                             FlowDirection="LeftToRight" HorizontalAlignment="Left" Text="{Binding Path}"/>
                                                        <SelectableTextBlock FontSize="11" Foreground="{DynamicResource SubtleBrush}" FlowDirection="LeftToRight" HorizontalAlignment="Left"
                                                                             Text="{Binding HashText}"/>
                                                    </StackPanel>
                                                    <ToggleButton Grid.Column="1" Theme="{StaticResource SwitchTheme}" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                  AutomationProperties.Name="{Binding FileName}"/>
                                                </Grid>
                                                </c:CappedWidth>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- معلومات النسخة -->
                                <StackPanel Spacing="0" IsVisible="{Binding SettingsSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=5}">
                                    <Border Classes="kv">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Classes="k" Text="{l:Loc version}"/>
                                            <TextBlock Text="{Binding AppVersion}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="kv">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Classes="k" Text=".NET"/>
                                            <TextBlock Text="{Binding DotNetVersion}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="kv">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Classes="k" Text="Avalonia UI"/>
                                            <TextBlock Text="{Binding AvaloniaVersion}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="kv" Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Classes="k" Text="{l:Loc repo}"/>
                                            <TextBlock Text="{Binding RepositoryName}" FlowDirection="LeftToRight"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Classes="btn" HorizontalAlignment="Stretch" Content="{l:Loc openGh}"
                                            Command="{Binding OpenUrlCommand}" CommandParameter="{Binding RepositoryUrl}"/>
                                </StackPanel>
                            </Panel>
                        </ScrollViewer>

                        <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,16,0,0">
                            <TextBlock Classes="lbl" Text="{l:Loc saved}"/>
                        </Border>
                    </Grid>
                </Grid>
            </Panel>
            </Border>
        </Border>
        </c:DialogFrame>
    </Panel>
</UserControl>
