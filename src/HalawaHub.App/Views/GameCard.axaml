<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HalawaHub.App.ViewModels"
             xmlns:l="using:HalawaHub.App.Services"
             xmlns:c="using:HalawaHub.App.Controls"
             xmlns:conv="using:HalawaHub.App.Converters"
             xmlns:behaviors="using:HalawaHub.App.Behaviors"
             x:Class="HalawaHub.App.Views.GameCard"
             x:DataType="vm:GameCardViewModel">


    <Panel Name="CardRoot" Classes="card">
        <!-- وجه البطاقة: الغلاف أو التدرج مع الحرف -->
        <Border Classes="face" CornerRadius="14"
                BorderBrush="{DynamicResource BorderBrushCard}" BorderThickness="1"
                Background="{Binding PaletteIndex, Converter={x:Static conv:CoverPaletteConverter.Instance}}">
            <Border Classes="cover-layer" Classes.offline="{Binding IsDriveMissing}" CornerRadius="13" ClipToBounds="True">
            <Panel>
                <TextBlock Text="{Binding Letter}" FontSize="84" FontWeight="ExtraBold" Foreground="#1FFFFFFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                           FontFamily="fonts:Inter#Inter"/>
                <Image Stretch="UniformToFill" IsVisible="{Binding HasCoverImage}"
                       behaviors:AsyncImage.DecodeWidth="360"
                       behaviors:AsyncImage.SourceUrl="{Binding CoverImageUrl}"
                       behaviors:AsyncImage.FallbackUrl="{Binding CoverImageUrlFallback}"/>

                <!-- العنوان وزر التشغيل -->
                <Border VerticalAlignment="Bottom" Padding="12,44,12,12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                            <GradientStop Color="#000A0404" Offset="0"/>
                            <GradientStop Color="#F20A0404" Offset="0.55"/>
                            <GradientStop Color="#F20A0404" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#F5EDED"
                                   TextTrimming="CharacterEllipsis"/>
                            <TextBlock Name="StatsLine" Text="{Binding StatsText}" FontSize="12" Foreground="#B8A4A4"
                                       TextTrimming="CharacterEllipsis" IsVisible="{Binding HasStatsLine}"/>
                        </StackPanel>
                        <Button Classes="play" Click="Play_Click" AutomationProperties.Name="{l:Loc play}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <c:VectorIcon Data="{StaticResource IconPlay}" Size="16" IsFilled="True"
                                              StrokeBrush="{x:Null}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PlayLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Panel>
            </Border>
        </Border>

        <!-- شارة المنصة، وتحتها شارة الحالة (تحديث، إصلاح، تعمل، القرص غير موصول) -->
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" Spacing="6" IsHitTestVisible="False">
            <Border Padding="9,3" CornerRadius="8" Background="#C70A0404" HorizontalAlignment="Left">
                <TextBlock Text="{Binding PlatformShort}" FontSize="12" FlowDirection="LeftToRight" Foreground="#F5EDED"/>
            </Border>
            <Border Name="StatusBadge" Classes="st" Padding="8,3" CornerRadius="8" Background="#E60A0404" HorizontalAlignment="Left"
                    BorderThickness="1" IsVisible="{Binding HasStatusBadge}"
                    Classes.t0="{Binding StatusTone, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=0}"
                    Classes.t1="{Binding StatusTone, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=1}"
                    Classes.t2="{Binding StatusTone, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=2}"
                    Classes.t3="{Binding StatusTone, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=3}">
                <TextBlock Text="{Binding StatusBadgeText}" FontSize="11" FontWeight="SemiBold"/>
            </Border>
        </StackPanel>

        <!-- زر القائمة: ≡ يتحول إلى ✕ -->
        <Button Classes="eb" Classes.open="{Binding IsMenuOpen}"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                Click="Menu_Click" ToolTip.Tip="{l:Loc more}" AutomationProperties.Name="{l:Loc more}">
            <Panel Classes="mt" Width="20" Height="20">
                <c:MenuCloseIcon IsOpen="{Binding IsMenuOpen}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Panel>
        </Button>

        <Border Name="Menu" Classes="card-menu" IsVisible="{Binding IsMenuOpen}"
                Width="176" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,50,8,0"
                Background="{DynamicResource MenuBrush}" BorderBrush="{DynamicResource MenuBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="6"
                BoxShadow="0 12 32 0 #99000000" RenderTransformOrigin="100%,0%">
            <!-- تُبنى القائمة عند أول فتح فقط (MenuContent فارغ قبله): أربعة أزرار جاهزة في كل بطاقة كانت ثلث وزنها تقريبًا -->
            <ContentControl Name="MenuHost" Content="{Binding MenuContent}">
            <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:GameCardViewModel">
            <StackPanel>
                <Button Classes="mi" Click="Favorite_Click" AutomationProperties.Name="{Binding FavoriteLabel}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:VectorIcon Data="{StaticResource IconHeart}" Size="16"
                                      FillBrush="{Binding IsFavorite, Converter={x:Static conv:HeartFillConverter.Instance}}"
                                      StrokeBrush="{Binding IsFavorite, Converter={x:Static conv:HeartStrokeConverter.Instance}}"
                                      VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding FavoriteLabel}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Name="SettingsItem" Classes="mi" Click="Settings_Click" PointerEntered="SettingsItem_PointerEntered" PointerExited="SettingsItem_PointerExited" AutomationProperties.Name="{l:Loc gameSettings}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Panel Width="16" Height="16" VerticalAlignment="Center">
                            <c:SlidersIcon Name="MenuSliders" Small="True" Foreground="{DynamicResource MenuTextBrush}" Ring="{DynamicResource MenuBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Panel>
                        <TextBlock Text="{l:Loc gameSettings}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Classes="mi" Click="Shortcut_Click" AutomationProperties.Name="{l:Loc desktopShortcut}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:VectorIcon Data="{StaticResource IconShortcut}" Size="16" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:Loc desktopShortcut}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Classes="mi" Click="CopyId_Click" AutomationProperties.Name="{l:Loc copyId}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:VectorIcon Data="{StaticResource IconCopy}" Size="16" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:Loc copyId}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            </DataTemplate>
            </ContentControl.ContentTemplate>
            </ContentControl>
        </Border>
    </Panel>
</UserControl>
