<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HalawaHub.App.ViewModels"
             xmlns:l="using:HalawaHub.App.Services"
             xmlns:behaviors="using:HalawaHub.App.Behaviors"
             xmlns:c="using:HalawaHub.App.Controls"
             xmlns:bp="using:HalawaHub.App.BigPicture"
             x:Class="HalawaHub.App.Views.DealsView"
             x:DataType="vm:MainViewModel"
             Name="Root">

    <UserControl.Styles>
        <!-- «عرض الكل» (.dmore): كبسولة صغيرة، السهم يتقدم عند المرور ويتبع اتجاه القراءة -->
        <Style Selector="Button.dmore">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushControl}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.dmore:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
            <Setter Property="BorderBrush" Value="#7F1D1D"/>
        </Style>
        <Style Selector="Button.dmore c|VectorIcon">
            <Setter Property="RenderTransform" Value="translateX(0px)"/>
            <Setter Property="Transitions"><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.35" Easing="{x:Static l:Springs.Switch}"/></Transitions></Setter>
        </Style>
        <Style Selector="Button.dmore:pointerover c|VectorIcon"><Setter Property="RenderTransform" Value="translateX(3px)"/></Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <DataTemplate x:Key="DealCard" x:DataType="vm:DealItem">
            <Button Classes="btn" Width="250" Height="196" Padding="0" Margin="0,0,14,14"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    AutomationProperties.Name="{Binding Title}"
                    Command="{Binding #Root.((vm:MainViewModel)DataContext).OpenUrlCommand}" CommandParameter="{Binding Url}">
                <StackPanel>
                    <Panel Height="117">
                        <Border CornerRadius="9,9,0,0" ClipToBounds="True" Background="{DynamicResource ChipBrush}">
                            <Image Stretch="UniformToFill" IsVisible="{Binding HasImage}"
                                   behaviors:AsyncImage.DecodeWidth="500" behaviors:AsyncImage.SourceUrl="{Binding ImageUrl}"/>
                        </Border>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="8,3" CornerRadius="8"
                                Background="#E6166534" FlowDirection="LeftToRight">
                            <TextBlock Text="{Binding DiscountText}" FontSize="13" FontWeight="Bold" Foreground="#DCFCE7"/>
                        </Border>
                    </Panel>
                    <StackPanel Margin="12,9,12,10" Spacing="4">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" FlowDirection="LeftToRight" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding PriceText}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding OldPriceText}" FontSize="12" TextDecorations="Strikethrough"
                                       Foreground="{DynamicResource MutedBrush}" IsVisible="{Binding HasOldPrice}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <!-- صفحة العروض: مجانيات Epic الآن، ومكان أي عروض تُضاف لاحقًا. كانت شريطًا يأخذ من ارتفاع المكتبة -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,8,0,40" Spacing="14">
            <!-- العنوان وسطر آخر تحديث بالنقطة الخضراء (.dhd / .dupd) -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{l:Loc deals}" FontSize="28" FontWeight="Bold"/>
                <StackPanel Name="DealsUpdated" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding HasDealsUpdated}">
                    <Ellipse Width="7" Height="7" Fill="#4ADE80"/>
                    <TextBlock Text="{Binding DealsUpdatedText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <TextBlock Name="DealsEmpty" Text="{Binding DealsEmptyText}" IsVisible="{Binding HasNoDeals}" FontSize="15"
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"/>

            <StackPanel Name="FreeGamesSection" Spacing="10" IsVisible="{Binding HasFreeGames}">
                <Grid ColumnDefinitions="*,Auto" Name="FreeMore">
                    <TextBlock Classes="lbl" Text="{l:Loc freeThisWeek}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Classes="dmore" Command="{Binding OpenUrlCommand}" CommandParameter="{x:Static vm:MainViewModel.EpicFreeGamesPage}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{l:Loc showAll}" VerticalAlignment="Center"/>
                            <Panel VerticalAlignment="Center" RenderTransform="{Binding IsRtl, Source={x:Static l:Loc.Instance}, Converter={x:Static bp:BpIs.FlipX}}">
                                <c:VectorIcon Data="{StaticResource IconArrowRight}" Size="14" StrokeWidth="2.4"/>
                            </Panel>
                        </StackPanel>
                    </Button>
                </Grid>
                <ItemsControl ItemsSource="{Binding FreeGames}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FreeGameItem">
                            <Button Classes="btn" Width="300" Height="236" Padding="0" Margin="0,0,16,16"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    AutomationProperties.Name="{Binding Title}"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).OpenUrlCommand}" CommandParameter="{Binding Url}">
                                <StackPanel>
                                    <Border Height="169" CornerRadius="9,9,0,0" ClipToBounds="True" Background="{DynamicResource ChipBrush}">
                                        <Image Stretch="UniformToFill" IsVisible="{Binding HasImage}"
                                               behaviors:AsyncImage.DecodeWidth="600" behaviors:AsyncImage.SourceUrl="{Binding ImageUrl}"/>
                                    </Border>
                                    <StackPanel Margin="14,10,14,12" Spacing="3">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding EndsText}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- تخفيضات Steam، ثم باقي المتاجر: نفس البطاقة -->
            <StackPanel Name="SteamDealsSection" Spacing="10" IsVisible="{Binding HasSteamDeals}">
                <Grid ColumnDefinitions="*,Auto" Name="SteamMore">
                    <TextBlock Classes="lbl" Text="{l:Loc dealsSteam}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Classes="dmore" Command="{Binding OpenUrlCommand}" CommandParameter="{x:Static vm:MainViewModel.SteamSpecialsPage}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{l:Loc showAll}" VerticalAlignment="Center"/>
                            <Panel VerticalAlignment="Center" RenderTransform="{Binding IsRtl, Source={x:Static l:Loc.Instance}, Converter={x:Static bp:BpIs.FlipX}}">
                                <c:VectorIcon Data="{StaticResource IconArrowRight}" Size="14" StrokeWidth="2.4"/>
                            </Panel>
                        </StackPanel>
                    </Button>
                </Grid>
                <ItemsControl ItemsSource="{Binding SteamDeals}" ItemTemplate="{StaticResource DealCard}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <StackPanel Name="OtherDealsSection" Spacing="10" IsVisible="{Binding HasOtherDeals}">
                <Grid ColumnDefinitions="*,Auto" Name="OtherMore">
                    <TextBlock Classes="lbl" Text="{l:Loc dealsOther}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Classes="dmore" Command="{Binding OpenUrlCommand}" CommandParameter="{x:Static vm:MainViewModel.GogDealsPage}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{l:Loc showAll}" VerticalAlignment="Center"/>
                            <Panel VerticalAlignment="Center" RenderTransform="{Binding IsRtl, Source={x:Static l:Loc.Instance}, Converter={x:Static bp:BpIs.FlipX}}">
                                <c:VectorIcon Data="{StaticResource IconArrowRight}" Size="14" StrokeWidth="2.4"/>
                            </Panel>
                        </StackPanel>
                    </Button>
                </Grid>
                <ItemsControl ItemsSource="{Binding OtherDeals}" ItemTemplate="{StaticResource DealCard}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <TextBlock Classes="note" Text="{l:Loc dealsPriceNote}" IsVisible="{Binding !HasNoDeals}" Foreground="{DynamicResource SubtleBrush}" FontSize="12"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
