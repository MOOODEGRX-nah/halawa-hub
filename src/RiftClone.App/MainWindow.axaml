<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RiftClone.App.ViewModels"
        xmlns:conv="using:RiftClone.App.Converters"
        x:Class="RiftClone.App.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainViewModel"
        Title="Halawa-Hub" Width="980" Height="660"
        Background="#0A0E1A"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <conv:PlatformColorConverter x:Key="PlatformColorConverter"/>
        <conv:BoolToStatusColorConverter x:Key="BoolToStatusColorConverter"/>
    </Window.Resources>

    <Window.Styles>
        <!-- زر أزرق أساسي: تشغيل كل لعبة -->
        <Style Selector="Button.play-btn">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button.play-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3B82F6"/>
        </Style>

        <!-- زر أحمر: إجراء عاجل (تحميل تحديث) -->
        <Style Selector="Button.cta-btn">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.cta-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#EF4444"/>
        </Style>

        <!-- زر ثانوي بحدود زرقاء: تحديث القائمة -->
        <Style Selector="Button.outline-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="1.3"/>
            <Setter Property="Foreground" Value="#93C5FD"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.outline-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#12203F"/>
        </Style>
    </Window.Styles>

    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- شريط علوي -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Halawa-Hub" FontSize="26" FontWeight="Bold">
                <TextBlock.Foreground>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="#3B82F6" Offset="0"/>
                        <GradientStop Color="#EF4444" Offset="1"/>
                    </LinearGradientBrush>
                </TextBlock.Foreground>
            </TextBlock>
            <TextBlock Text="{Binding FilteredGames.Count, StringFormat='{}{0} لعبة'}"
                       Foreground="#7A88AA" FontSize="13" Margin="12,0,0,0"
                       VerticalAlignment="Center"/>
            <Button Classes="outline-btn" Content="تحديث القائمة" Width="120" Height="34"
                    Margin="16,0,0,0" Command="{Binding RefreshCommand}"/>
        </StackPanel>

        <!-- شريط البحث والفلترة -->
        <Grid Grid.Row="1" ColumnDefinitions="*,150" Margin="0,0,0,16">
            <TextBox Grid.Column="0" Watermark="ابحث عن لعبة..."
                     Text="{Binding SearchQuery, Mode=TwoWay}"
                     Background="#141A2E" BorderBrush="#2A3352" BorderThickness="1"
                     CornerRadius="6" Foreground="White" Padding="12,8"/>
            <ComboBox Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding AvailablePlatforms}"
                      SelectedItem="{Binding SelectedPlatformFilter, Mode=TwoWay}"/>
        </Grid>

        <!-- شريط إشعار التحديث، يظهر فقط لما فيه إصدار أحدث -->
        <Border Grid.Row="2" Background="#141B33" BorderBrush="#2563EB" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                IsVisible="{Binding HasUpdateMessage}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding UpdateMessage}"
                           Foreground="White" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Classes="cta-btn" Content="تحميل التحديث"
                        Padding="14,6" Margin="12,0,0,0" Command="{Binding OpenUpdateCommand}"/>
            </Grid>
        </Border>

        <!-- قائمة الألعاب كبطاقات -->
        <ScrollViewer Grid.Row="3">
            <ListBox ItemsSource="{Binding FilteredGames}"
                     SelectedItem="{Binding SelectedGame}"
                     Background="Transparent"
                     BorderThickness="0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,10,10"/>
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected Border#CardBorder">
                        <Setter Property="BorderBrush" Value="#EF4444"/>
                        <Setter Property="BorderThickness" Value="2"/>
                    </Style>
                    <Style Selector="ListBoxItem:pointerover Border#CardBorder">
                        <Setter Property="Background" Value="#1B2340"/>
                    </Style>
                </ListBox.Styles>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="CardBorder" Width="240" Height="140"
                                CornerRadius="10" Background="#141A2E"
                                BorderThickness="0" ClipToBounds="True">
                            <Grid ColumnDefinitions="5,*">
                                <Rectangle Grid.Column="0"
                                           Fill="{Binding Platform, Converter={StaticResource PlatformColorConverter}}"/>

                                <Grid Grid.Column="1" Margin="14,10" RowDefinitions="Auto,*,Auto,Auto">
                                    <TextBlock Grid.Row="0" Text="{Binding Platform}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding Platform, Converter={StaticResource PlatformColorConverter}}"/>

                                    <TextBlock Grid.Row="1" Text="{Binding Name}"
                                               FontSize="15" FontWeight="Bold" Foreground="White"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               MaxLines="2" VerticalAlignment="Center"/>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{Binding IsInstalled, Converter={StaticResource BoolToStatusColorConverter}}"/>
                                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                   Foreground="#AAAAAA" Margin="6,0,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Row="3" Classes="play-btn" Content="تشغيل"
                                            HorizontalAlignment="Stretch" Height="30"
                                            Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).LaunchGameCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>

        <!-- رسالة حالة/خطأ -->
        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}"
                   Foreground="#FF6B6B" Margin="0,10,0,0"
                   IsVisible="{Binding HasStatusMessage}"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
