<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HalawaHub.App.ViewModels"
        xmlns:conv="using:HalawaHub.App.Converters"
        xmlns:behaviors="using:HalawaHub.App.Behaviors"
        x:Class="HalawaHub.App.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitleText}" Width="1080" Height="680"
        Icon="avares://Halawa-Hub/Assets/icon.ico"
        FlowDirection="RightToLeft">

    <Window.Background>
        <RadialGradientBrush Center="50%,0%" GradientOrigin="50%,0%" Radius="0.9">
            <GradientStop Color="#1A0A0C" Offset="0"/>
            <GradientStop Color="#0A0404" Offset="0.55"/>
            <GradientStop Color="#000000" Offset="1"/>
        </RadialGradientBrush>
    </Window.Background>

    <Window.Resources>
        <conv:PlatformColorConverter x:Key="PlatformColorConverter"/>
        <conv:BoolToStatusColorConverter x:Key="BoolToStatusColorConverter"/>
        <conv:StringEqualsConverter x:Key="StringEqualsConverter"/>
    </Window.Resources>

    <Window.Styles>
        <!-- زر أحمر أساسي: تشغيل كل لعبة -->
        <Style Selector="Button.play-btn">
            <Setter Property="Background" Value="#B91C1C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button.play-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#EF4444"/>
        </Style>

        <!-- زر إجراء عاجل (تحميل تحديث) -->
        <Style Selector="Button.cta-btn">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.cta-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#EF4444"/>
        </Style>

        <!-- زر ثانوي: تحديث القائمة -->
        <Style Selector="Button.outline-btn">
            <Setter Property="Background" Value="#150A0C"/>
            <Setter Property="BorderBrush" Value="#4A2024"/>
            <Setter Property="BorderThickness" Value="1.3"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.outline-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A1418"/>
        </Style>

        <!-- زر دائري صغير: أدوات اللعبة -->
        <Style Selector="Button.tools-btn">
            <Setter Property="Background" Value="#901A0A0C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.tools-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#B91C1C"/>
        </Style>

        <!-- نجمة المفضلة على البطاقة -->
        <Style Selector="ToggleButton.star-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#6B5457"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ToggleButton.star-btn:checked">
            <Setter Property="Foreground" Value="#F5A623"/>
        </Style>

        <!-- =========================================================
             تفاعلات الأيقونات: نبضة النجمة، دوران الترس، اهتزاز الجرس،
             دوران الإغلاق، تكبير مفتاح الربط
             ملاحظة فنية مهمة: جرّبنا أول تحريك RenderTransform مباشرة بصيغة
             النص ("rotate(90deg)")، وطاح البرنامج وقت التشغيل الفعلي برسالة
             "No animator registered for the property RenderTransform" —
             تبيّن إن Avalonia (بهالإصدار) ما يدعم تحريك RenderTransform
             بصيغة النص عبر Animation/KeyFrame أصلاً (فقط عبر Transition).
             الطريقة الصحيحة الموثّقة رسميًا: نحط كائن Transform صريح باسمه
             (RotateTransform/ScaleTransform) كـ RenderTransform، ونحرّك
             خاصيته الفرعية مباشرة بصيغة "RotateTransform.Angle" داخل
             KeyFrame — هذي الصيغة مسجّلة فعليًا (TransformAnimator) وتشتغل
             فقط جوّا Animation، مو كـ Setter عادي خارج أي حركة.
             ========================================================= -->
        <Style Selector="ToggleButton.star-btn">
            <Setter Property="RenderTransform">
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.star-btn:pressed">
            <Style.Animations>
                <Animation Duration="0:0:0.15" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.7"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.7"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="ToggleButton.star-btn:checked">
            <Style.Animations>
                <Animation Duration="0:0:0.6" IterationCount="1" PlaybackDirection="Normal">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.5"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.5"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- ترس الإعدادات: دوران بطيء دائم، أسرع عند hover -->
        <Style Selector="Button.gear-btn PathIcon">
            <Setter Property="RenderTransform">
                <RotateTransform Angle="0"/>
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:8" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Button.gear-btn:pointerover PathIcon">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Button.gear-btn:pointerover">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- الجرس: اهتزاز عند hover -->
        <Style Selector="Button.bell-btn">
            <Setter Property="RenderTransform">
                <RotateTransform Angle="0"/>
            </Setter>
        </Style>
        <Style Selector="Button.bell-btn:pointerover">
            <Style.Animations>
                <Animation Duration="0:0:0.6" IterationCount="1" PlaybackDirection="Normal">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0"/></KeyFrame>
                    <KeyFrame Cue="10%"><Setter Property="RotateTransform.Angle" Value="15"/></KeyFrame>
                    <KeyFrame Cue="20%"><Setter Property="RotateTransform.Angle" Value="-12"/></KeyFrame>
                    <KeyFrame Cue="25%"><Setter Property="RotateTransform.Angle" Value="10"/></KeyFrame>
                    <KeyFrame Cue="35%"><Setter Property="RotateTransform.Angle" Value="-8"/></KeyFrame>
                    <KeyFrame Cue="45%"><Setter Property="RotateTransform.Angle" Value="5"/></KeyFrame>
                    <KeyFrame Cue="60%"><Setter Property="RotateTransform.Angle" Value="-3"/></KeyFrame>
                    <KeyFrame Cue="75%"><Setter Property="RotateTransform.Angle" Value="1"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="0"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Button.bell-btn:pointerover PathIcon">
            <Setter Property="Foreground" Value="#EF4444"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- الإغلاق: دوران 90° + تلوّن أحمر عند hover -->
        <Style Selector="Button.close-btn">
            <Setter Property="RenderTransform">
                <RotateTransform Angle="0"/>
            </Setter>
        </Style>
        <Style Selector="Button.close-btn:pointerover">
            <Style.Animations>
                <Animation Duration="0:0:0.4" Easing="BackEaseOut" FillMode="Forward">
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="90"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
        </Style>

        <!-- مفتاح الربط: تكبير عند hover (بسّطنا الحركة لتكبير بس بدل قفزة+تكبير
             مع، عشان نتجنب الجمع بين حركتين على RenderTransform بنفس الوقت
             لحد ما نتأكد إنه مدعوم فعليًا) -->
        <Style Selector="Button.wrench-btn PathIcon">
            <Setter Property="RenderTransform">
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter>
        </Style>
        <Style Selector="Button.wrench-btn:pointerover PathIcon">
            <Style.Animations>
                <Animation Duration="0:0:0.25" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.15"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.15"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
            <Setter Property="Foreground" Value="#F5A623"/>
        </Style>

        <!-- عناصر الشريط الجانبي الثابتة (الكل/المفضلة/المثبتة/المضافة حديثًا) -->
        <Style Selector="ToggleButton.nav-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B0A0A2"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style Selector="ToggleButton.nav-item:checked">
            <Setter Property="Background" Value="#B91C1C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="ToggleButton.nav-item:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A1418"/>
        </Style>

        <!-- عناصر الشريط الجانبي الديناميكية (كل منصة) -->
        <Style Selector="Button.nav-platform">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B0A0A2"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style Selector="Button.nav-platform:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A1418"/>
        </Style>

        <!-- تبويبات نافذة التفاصيل -->
        <Style Selector="TabItem">
            <Setter Property="Foreground" Value="#B0A0A2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="#EF4444"/>
        </Style>
    </Window.Styles>

    <Grid Margin="20" ColumnDefinitions="*,220">

        <!-- ============ الشريط الجانبي (يسار الشاشة فعليًا رغم اتجاه RTL) ============ -->
        <Border Grid.Column="1" Background="#0D0608" BorderBrush="#2A1418" BorderThickness="1"
                CornerRadius="10" Margin="12,0,0,0" Padding="12">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto">

                <Button Grid.Row="0" Classes="outline-btn" Content="تحديث القائمة"
                        HorizontalAlignment="Stretch" Height="34" Margin="0,0,0,10"
                        Command="{Binding RefreshCommand}"/>

                <TextBox Grid.Row="1" Watermark="ابحث..." Text="{Binding SearchQuery, Mode=TwoWay}"
                         Background="#150A0C" BorderBrush="#3A1518" BorderThickness="1"
                         CornerRadius="6" Foreground="White" Padding="10,7" Margin="0,0,0,14"/>

                <TextBlock Grid.Row="2" Text="LIBRARY" FontSize="10" FontWeight="Bold"
                           Foreground="#6B5457" LetterSpacing="1.5" Margin="6,0,0,8"/>

                <StackPanel Grid.Row="3">
                    <ToggleButton Classes="nav-item" Content="الكل"
                                  IsChecked="{Binding SelectedNavItem, Converter={StaticResource StringEqualsConverter}, ConverterParameter=الكل, Mode=TwoWay}"/>
                    <ToggleButton Classes="nav-item"
                                  IsChecked="{Binding SelectedNavItem, Converter={StaticResource StringEqualsConverter}, ConverterParameter=المفضلة, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Theme="{StaticResource StrokeIconTheme}" Data="{StaticResource IconStar}" Width="13" Height="13" VerticalAlignment="Center"/>
                            <TextBlock Text="المفضلة" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="nav-item" Content="المثبتة"
                                  IsChecked="{Binding SelectedNavItem, Converter={StaticResource StringEqualsConverter}, ConverterParameter=المثبتة, Mode=TwoWay}"/>
                    <ToggleButton Classes="nav-item" Content="المضافة حديثًا"
                                  IsChecked="{Binding SelectedNavItem, Converter={StaticResource StringEqualsConverter}, ConverterParameter=المضافة حديثًا, Mode=TwoWay}"/>

                    <Border Height="1" Background="#2A1418" Margin="4,10"/>

                    <TextBlock Text="LAUNCHERS" FontSize="10" FontWeight="Bold"
                               Foreground="#6B5457" LetterSpacing="1.5" Margin="6,0,0,8"/>

                    <ItemsControl ItemsSource="{Binding AvailablePlatforms}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="nav-platform" Content="{Binding}"
                                        Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).SelectNavCommand}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ المحتوى الرئيسي ============ -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto">

            <!-- شريط علوي -->
            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" Spacing="10">
                    <Image Source="avares://Halawa-Hub/Assets/logo.png" Width="30" Height="30"/>
                    <TextBlock Text="Halawa" FontSize="26" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="-Hub" FontSize="26" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Background="#1A0A0C" BorderBrush="#7A2020" BorderThickness="1"
                        CornerRadius="20" Padding="10,4" Margin="16,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="6" Height="6" Fill="#EF4444" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding FilteredGames.Count, StringFormat='{}{0} لعبة'}"
                                   FontSize="10" FontWeight="Bold" Foreground="#D1D5DB" LetterSpacing="1"/>
                    </StackPanel>
                </Border>

                <Button Classes="tools-btn bell-btn" Width="34" Height="34" Margin="8,0,0,0">
                    <Grid>
                        <PathIcon Theme="{StaticResource StrokeIconTheme}" Data="{StaticResource IconBell}" Width="16" Height="16"/>
                        <Ellipse Width="8" Height="8" Fill="#EF4444"
                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,-2,-2,0" IsVisible="{Binding HasNotification}">
                            <Ellipse.Styles>
                                <Style Selector="Ellipse">
                                    <Style.Animations>
                                        <Animation Duration="0:0:1.2" IterationCount="Infinite">
                                            <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                                            <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.3"/></KeyFrame>
                                            <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                            </Ellipse.Styles>
                        </Ellipse>
                    </Grid>
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Width="240" Spacing="10">
                                <TextBlock Text="الإشعارات" FontWeight="Bold" FontSize="13" Foreground="White"/>
                                <StackPanel Spacing="8" IsVisible="{Binding HasUpdateMessage}">
                                    <TextBlock Text="{Binding UpdateMessage}" FontSize="12"
                                               Foreground="#D1D5DB" TextWrapping="Wrap"/>
                                    <Button Classes="cta-btn" Content="فتح الإعدادات" FontSize="11"
                                            Padding="10,6" Command="{Binding OpenSettingsCommand}"/>
                                </StackPanel>
                                <TextBlock Text="لا توجد إشعارات جديدة" FontSize="12"
                                           Foreground="#9CA3AF" IsVisible="{Binding !HasUpdateMessage}"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button Classes="tools-btn gear-btn" Width="34" Height="34"
                        Margin="8,0,0,0" Command="{Binding OpenSettingsCommand}">
                    <PathIcon Theme="{StaticResource StrokeIconTheme}" Data="{StaticResource IconGear}" Width="17" Height="17"/>
                </Button>
            </StackPanel>

            <!-- قائمة الألعاب: لوحة Bento بالصفحة الرئيسية، أو الشبكة العادية لأي فلترة -->
            <Grid Grid.Row="2">

            <!-- ============ الصفحة الرئيسية (Bento) ============ -->
            <ScrollViewer IsVisible="{Binding IsHomeView}">
                <StackPanel Spacing="20">

                    <Grid ColumnDefinitions="1.5*,1*">
                        <!-- العمود الأيمن: استمر من حيث توقفت + تم تحميله حديثًا -->
                        <StackPanel Grid.Column="0" Spacing="12" Margin="0,0,12,0">

                            <Border Height="300" CornerRadius="12" ClipToBounds="True"
                                    Background="#140A0C" BorderBrush="#2A1418" BorderThickness="1"
                                    IsVisible="{Binding HasContinuePlaying}">
                                <Grid>
                                    <Image Stretch="UniformToFill"
                                           behaviors:AsyncImage.SourceUrl="{Binding ContinuePlayingGame.CoverImageUrl}"
                                           behaviors:AsyncImage.FallbackUrl="{Binding ContinuePlayingGame.CoverImageUrlFallback}"
                                           behaviors:AsyncImage.DecodeWidth="500"/>
                                    <Border>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,30%" EndPoint="0%,100%">
                                                <GradientStop Color="#00000000" Offset="0"/>
                                                <GradientStop Color="#E6000000" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel VerticalAlignment="Bottom" Margin="20" Spacing="4">
                                        <TextBlock Text="استمر من حيث توقفت" FontSize="11" FontWeight="Bold" Foreground="#F5A623"/>
                                        <TextBlock Text="{Binding ContinuePlayingGame.Name}" FontSize="24" FontWeight="800" Foreground="White"/>
                                        <TextBlock Text="{Binding ContinuePlayingGame.LastPlayedText}" FontSize="12" Foreground="#D1D5DB" Margin="0,0,0,10"/>
                                        <Button Classes="play-btn" Content="تشغيل" Padding="24,10" HorizontalAlignment="Left"
                                                Command="{Binding LaunchGameCommand}"
                                                CommandParameter="{Binding ContinuePlayingGame}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Height="300" CornerRadius="12" Background="#140A0C" BorderBrush="#2A1418" BorderThickness="1"
                                    IsVisible="{Binding !HasContinuePlaying}">
                                <TextBlock Text="شغّل أول لعبة عشان نتابع لك آخر لعبة تلعبها هنا"
                                           Foreground="#9CA3AF" TextAlignment="Center" TextWrapping="Wrap"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30"/>
                            </Border>

                            <Border Height="96" CornerRadius="10" Background="#140A0C" BorderBrush="#2A1418" BorderThickness="1" Padding="14">
                                <Grid RowDefinitions="Auto,*">
                                    <TextBlock Grid.Row="0" Text="تم تحميله حديثًا" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentlyInstalled}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="140" CornerRadius="6" ClipToBounds="True" Background="#0D0608">
                                                    <Grid>
                                                        <Image Stretch="UniformToFill" IsVisible="{Binding HasCoverImage}"
                                                               behaviors:AsyncImage.SourceUrl="{Binding CoverImageUrl}"
                                                               behaviors:AsyncImage.FallbackUrl="{Binding CoverImageUrlFallback}"
                                                               behaviors:AsyncImage.DecodeWidth="180"/>
                                                        <Border Background="#99000000"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="Bold" Foreground="White"
                                                                   VerticalAlignment="Bottom" Margin="6" TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- العمود الأيسر: آخر الأخبار + تشغيل سريع (المفضلة) -->
                        <StackPanel Grid.Column="1" Spacing="12">
                            <Border CornerRadius="10" Background="#140A0C" BorderBrush="#2A1418" BorderThickness="1" Padding="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="آخر الأخبار" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding NewsEntries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#1A0D0F" BorderThickness="0,0,0,1" Padding="0,8">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="11.5" Foreground="#D1D5DB"
                                                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding GameName}" FontSize="9" Foreground="#6B5457" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="ما فيه أخبار حاليًا" FontSize="11" Foreground="#6B5457"
                                               IsVisible="{Binding !HasNews}"/>
                                </StackPanel>
                            </Border>

                            <Border CornerRadius="10" Background="#140A0C" BorderBrush="#2A1418" BorderThickness="1" Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="تشغيل سريع — المفضلة" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                                    <ItemsControl ItemsSource="{Binding FavoriteQuickLaunch}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
                                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6"
                                                            ClipToBounds="True" Background="#0D0608">
                                                        <Image Stretch="UniformToFill" IsVisible="{Binding HasCoverImage}"
                                                               behaviors:AsyncImage.SourceUrl="{Binding CoverImageUrl}"
                                                               behaviors:AsyncImage.FallbackUrl="{Binding CoverImageUrlFallback}"
                                                               behaviors:AsyncImage.DecodeWidth="60"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="White"
                                                               Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <Button Grid.Column="2" Classes="play-btn" Content="تشغيل" FontSize="10" Padding="10,4"
                                                            Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).LaunchGameCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="ما عندك ألعاب مفضّلة بعد — علّم أي لعبة بنجمة ⭐"
                                               FontSize="11" Foreground="#6B5457" TextWrapping="Wrap"
                                               IsVisible="{Binding !HasFavoriteQuickLaunch}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- آخر الألعاب اللي لعبتها -->
                    <StackPanel IsVisible="{Binding HasRecentlyPlayed}">
                        <TextBlock Text="آخر الألعاب اللي لعبتها" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,14"/>
                        <ItemsControl ItemsSource="{Binding RecentlyPlayed}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="200" Height="120" CornerRadius="10" ClipToBounds="True"
                                            Background="#140A0C" BorderBrush="#2A1418" BorderThickness="1" Margin="0,0,10,10">
                                        <Grid>
                                            <Image Stretch="UniformToFill" IsVisible="{Binding HasCoverImage}"
                                                   behaviors:AsyncImage.SourceUrl="{Binding CoverImageUrl}"
                                                   behaviors:AsyncImage.FallbackUrl="{Binding CoverImageUrlFallback}"
                                                   behaviors:AsyncImage.DecodeWidth="260"/>
                                            <Border Background="#80000000"/>
                                            <StackPanel VerticalAlignment="Bottom" Margin="10">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="White"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding LastPlayedText}" FontSize="9" Foreground="#D1D5DB" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ القائمة المفلترة العادية ============ -->
            <ScrollViewer IsVisible="{Binding !IsHomeView}">
                <ListBox ItemsSource="{Binding FilteredGames}"
                         SelectedItem="{Binding SelectedGame}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,10,10"/>
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected Border#CardBorder">
                            <Setter Property="BorderBrush" Value="#F5A623"/>
                            <Setter Property="BorderThickness" Value="2"/>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover Border#CardBorder">
                            <Setter Property="Background" Value="#1F1012"/>
                        </Style>
                    </ListBox.Styles>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="CardBorder" Width="200" Height="270"
                                    CornerRadius="10" Background="#140A0C"
                                    BorderBrush="#2A1418" BorderThickness="1"
                                    ClipToBounds="True">
                                <Grid>
                                    <!-- صورة الغلاف (لو متوفرة لهذي المنصة) -->
                                    <Image Stretch="UniformToFill"
                                           IsVisible="{Binding HasCoverImage}"
                                           behaviors:AsyncImage.SourceUrl="{Binding CoverImageUrl}"
                                           behaviors:AsyncImage.FallbackUrl="{Binding CoverImageUrlFallback}"
                                           behaviors:AsyncImage.DecodeWidth="220"/>

                                    <!-- تغميق موحّد فوق الصورة كاملة عشان النص يبين دايمًا -->
                                    <Border Background="#66000000" IsVisible="{Binding HasCoverImage}"/>

                                    <!-- تدرّج أغمق بالأسفل تحديدًا لقراءة أوضح للاسم والزر -->
                                    <Border IsVisible="{Binding HasCoverImage}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,35%" EndPoint="0%,100%">
                                                <GradientStop Color="#00000000" Offset="0"/>
                                                <GradientStop Color="#E6000000" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <!-- المحتوى فوق الصورة -->
                                    <Grid Margin="12,10" RowDefinitions="Auto,*,Auto,Auto">

                                        <!-- شارة المنصة + نجمة المفضلة + زر الأدوات -->
                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
                                            <Border Grid.Column="0" HorizontalAlignment="Left"
                                                    Background="#801A0A0C" BorderThickness="1"
                                                    CornerRadius="10" Padding="8,2"
                                                    BorderBrush="{Binding Platform, Converter={StaticResource PlatformColorConverter}}">
                                                <TextBlock Text="{Binding Platform}" FontSize="10" FontWeight="Bold"
                                                           LetterSpacing="0.5"
                                                           Foreground="{Binding Platform, Converter={StaticResource PlatformColorConverter}}"/>
                                            </Border>

                                            <ToggleButton Grid.Column="1" Classes="star-btn"
                                                          Width="24" Height="24"
                                                          IsChecked="{Binding IsFavorite, Mode=TwoWay}">
                                                <PathIcon Theme="{StaticResource StrokeIconTheme}" Data="{StaticResource IconStar}" Width="15" Height="15"/>
                                            </ToggleButton>

                                            <Button Grid.Column="2" Classes="tools-btn wrench-btn"
                                                    Width="26" Height="26"
                                                    Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).OpenDetailsCommand}"
                                                    CommandParameter="{Binding}">
                                                <PathIcon Theme="{StaticResource StrokeIconTheme}" Data="{StaticResource IconWrench}" Width="13" Height="13"/>
                                            </Button>
                                        </Grid>

                                        <TextBlock Grid.Row="1" Text="{Binding Name}"
                                                   FontSize="15" FontWeight="Bold" Foreground="White"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   MaxLines="3" VerticalAlignment="Bottom" Margin="0,8"/>

                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{Binding IsInstalled, Converter={StaticResource BoolToStatusColorConverter}}"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                       Foreground="#D1D5DB" Margin="6,0,0,0"/>
                                        </StackPanel>

                                        <Button Grid.Row="3" Classes="play-btn" Content="تشغيل"
                                                HorizontalAlignment="Stretch" Height="30"
                                                Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).LaunchGameCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

            </Grid>

            <!-- رسالة حالة/خطأ -->
            <TextBlock Grid.Row="3" Text="{Binding StatusMessage}"
                       Foreground="#FF6B6B" Margin="0,10,0,0"
                       IsVisible="{Binding HasStatusMessage}"
                       TextWrapping="Wrap"/>
        </Grid>

        <!-- ============ نافذة تفاصيل اللعبة (Installation / Launch Parameters / Artwork / Flags) ============ -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Background="#CC000000"
                IsVisible="{Binding IsDetailsOpen}">
            <Border Width="580" MaxHeight="620" Background="#140A0C"
                    BorderBrush="#3A1518" BorderThickness="1" CornerRadius="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
                <Grid DataContext="{Binding DetailsGame}" x:DataType="vm:GameCardViewModel"
                      RowDefinitions="Auto,Auto,Auto,*">

                    <!-- عنوان + زر إغلاق -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="20"
                                   FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                        <Button Grid.Column="1" Classes="outline-btn close-btn" Width="32" Height="32"
                                Padding="0" VerticalAlignment="Top"
                                Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).CloseDetailsCommand}">
                            <PathIcon Theme="{StaticResource StrokeIconTheme}" Data="{StaticResource IconClose}" Width="13" Height="13"/>
                        </Button>
                    </Grid>

                    <!-- Installation -->
                    <Border Grid.Row="1" Background="#1A0A0C" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Platform}" FontWeight="Bold" Foreground="White" FontSize="14"/>
                                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="play-btn" Content="تشغيل" Padding="16,8" Margin="0,0,8,0"
                                    Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).LaunchGameCommand}"
                                    CommandParameter="{Binding}"/>
                            <Button Grid.Column="2" Classes="outline-btn" Content="حذف" Padding="16,8"
                                    Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).DeleteGameCommand}"/>
                        </Grid>
                    </Border>

                    <!-- Launch Parameters -->
                    <Border Grid.Row="2" Background="#1A0A0C" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="معاملات التشغيل (Launch Parameters)" FontSize="12"
                                       FontWeight="Bold" Foreground="White"/>
                            <TextBox Text="{Binding LaunchParameters, Mode=TwoWay}" Watermark="مثال: -novid -dx11"
                                     Background="#150A0C" BorderBrush="#3A1518" BorderThickness="1"
                                     Foreground="White" CornerRadius="6" Padding="10,7"/>
                        </StackPanel>
                    </Border>

                    <!-- تبويبات: Tools / Artwork / Your Flags -->
                    <TabControl Grid.Row="3" Background="Transparent">
                        <TabItem Header="Tools" IsVisible="{Binding HasTools}">
                            <ItemsControl ItemsSource="{Binding Tools}" Margin="0,14,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1A0A0C" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               FontSize="13" Foreground="White"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                                               Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="outline-btn"
                                                        Content="{Binding ActionLabel}"
                                                        FontSize="11" Padding="12,6"
                                                        Command="{Binding ToggleCommand}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </TabItem>
                        <TabItem Header="Artwork">
                            <StackPanel Spacing="12" Margin="0,12,0,0">
                                <Border Height="220" CornerRadius="8" ClipToBounds="True" Background="#0D0608">
                                    <Image Stretch="Uniform" IsVisible="{Binding HasCoverImage}"
                                           behaviors:AsyncImage.SourceUrl="{Binding CoverImageUrl}"
                                           behaviors:AsyncImage.FallbackUrl="{Binding CoverImageUrlFallback}"/>
                                </Border>
                                <Button Classes="outline-btn" Content="تغيير الغلاف" HorizontalAlignment="Left"
                                        Padding="16,8" Click="ChangeCoverButton_Click"/>
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Your Flags">
                            <StackPanel Spacing="16" Margin="0,14,0,0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Favorite" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="علّمها بنجمة لسهولة الوصول لاحقًا"
                                                   FontSize="11" Foreground="#9CA3AF"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Classes="star-btn"
                                                  Width="34" Height="34"
                                                  IsChecked="{Binding IsFavorite, Mode=TwoWay}">
                                        <PathIcon Theme="{StaticResource StrokeIconTheme}" Data="{StaticResource IconStar}" Width="19" Height="19"/>
                                    </ToggleButton>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Owned" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="تلقائي — أي لعبة مثبتة تُحتسب مملوكة"
                                                   FontSize="11" Foreground="#9CA3AF"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding OwnedText}"
                                               Foreground="#4CAF50" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Border>

        <!-- ============ نافذة الإعدادات ============ -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Background="#CC000000"
                IsVisible="{Binding IsSettingsOpen}">
            <Border Width="480" MaxHeight="600" Background="#140A0C"
                    BorderBrush="#3A1518" BorderThickness="1" CornerRadius="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
                <StackPanel Spacing="16">

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="الإعدادات" FontSize="20"
                                   FontWeight="Bold" Foreground="White"/>
                        <Button Grid.Column="1" Classes="outline-btn close-btn" Width="32" Height="32"
                                Padding="0" Command="{Binding CloseSettingsCommand}">
                            <PathIcon Theme="{StaticResource StrokeIconTheme}" Data="{StaticResource IconClose}" Width="13" Height="13"/>
                        </Button>
                    </Grid>

                    <!-- التحديثات -->
                    <Border Background="#1A0A0C" CornerRadius="8" Padding="14">
                        <StackPanel Spacing="10">
                            <TextBlock Text="التحديثات" FontSize="13" FontWeight="Bold" Foreground="White"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding AppVersion, StringFormat='الإصدار الحالي: {0}'}"
                                           FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Classes="outline-btn" Content="تحقق من التحديثات"
                                        FontSize="11" Padding="12,6" Command="{Binding CheckForUpdatesNowCommand}"/>
                            </Grid>

                            <!-- يظهر بس لو فيه إصدار أحدث فعليًا -->
                            <Border Background="#1A0A0C" BorderBrush="#DC2626" BorderThickness="1"
                                    CornerRadius="6" Padding="10" IsVisible="{Binding HasUpdateMessage}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding UpdateMessage}"
                                               Foreground="White" FontSize="11" VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                    <Button Grid.Column="1" Classes="cta-btn" Content="تثبيت الآن"
                                            FontSize="11" Padding="12,6" Margin="10,0,0,0"
                                            Command="{Binding InstallUpdateCommand}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- مفاتيح API -->
                    <Border Background="#1A0A0C" CornerRadius="8" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="مفاتيح API" FontSize="13" FontWeight="Bold" Foreground="White"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="SteamGridDB (أغلفة GOG/Epic/Riot/Xbox)"
                                           FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Classes="outline-btn" FontSize="10" Padding="10,4"
                                        Command="{Binding OpenUrlCommand}"
                                        CommandParameter="https://www.steamgriddb.com/profile/preferences">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="احصل على مفتاح" VerticalAlignment="Center"/>
                                        <PathIcon Theme="{StaticResource StrokeIconTheme}" Data="{StaticResource IconArrowOut}" Width="10" Height="10" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding SteamGridDbApiKey, Mode=TwoWay}"
                                         Watermark="الصق المفتاح هنا..."
                                         Background="#150A0C" BorderBrush="#3A1518" BorderThickness="1"
                                         Foreground="White" CornerRadius="6" Padding="10,7"/>
                                <Button Grid.Column="1" Classes="outline-btn" Content="تحقق"
                                        FontSize="11" Padding="12,7" Margin="8,0,0,0"
                                        Command="{Binding VerifyApiKeyCommand}"/>
                            </Grid>
                            <TextBlock Text="{Binding ApiKeyStatusText}" FontSize="11" FontWeight="SemiBold"
                                       IsVisible="{Binding HasApiKeyStatus}" Foreground="#D1D5DB"/>
                        </StackPanel>
                    </Border>

                    <!-- المظهر -->
                    <Border Background="#1A0A0C" CornerRadius="8" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="المظهر (Theme)" FontSize="13" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="خيارات مظاهر إضافية — قريبًا" FontSize="11" Foreground="#9CA3AF"/>
                        </StackPanel>
                    </Border>

                    <!-- إعدادات التشغيل -->
                    <Border Background="#1A0A0C" CornerRadius="8" Padding="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="تشغيل مع بدء النظام" FontWeight="Bold" FontSize="13" Foreground="White"/>
                                <TextBlock Text="يفتح Halawa-Hub تلقائيًا عند تشغيل الويندوز"
                                           FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" OnContent="" OffContent=""
                                          IsChecked="{Binding LaunchOnStartup, Mode=TwoWay}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Border>

        <!-- ============ نافذة "ما الجديد" (تظهر تلقائيًا بعد كل تحديث) ============ -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Background="#CC000000"
                IsVisible="{Binding IsChangelogOpen}">
            <Border Width="460" MaxHeight="500" Background="#140A0C"
                    BorderBrush="#3A1518" BorderThickness="1" CornerRadius="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="ما الجديد" FontSize="20" FontWeight="Bold" Foreground="White"/>
                            <PathIcon Theme="{StaticResource StrokeIconTheme}" Data="{StaticResource IconSparkle}" Width="18" Height="18" Foreground="#F5A623"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="outline-btn close-btn" Width="32" Height="32"
                                Padding="0" Command="{Binding CloseChangelogCommand}">
                            <PathIcon Theme="{StaticResource StrokeIconTheme}" Data="{StaticResource IconClose}" Width="13" Height="13"/>
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="{Binding AppVersion}" FontSize="12"
                               Foreground="#EF4444" FontWeight="Bold" Margin="0,0,0,14"/>

                    <ScrollViewer Grid.Row="2">
                        <ItemsControl ItemsSource="{Binding ChangelogEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="•" Foreground="#EF4444" FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding}" Foreground="#D1D5DB"
                                                   FontSize="13" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="3" Classes="play-btn" Content="تمام" Height="38" Margin="0,14,0,0"
                            Command="{Binding CloseChangelogCommand}"/>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
