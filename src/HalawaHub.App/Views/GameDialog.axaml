<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HalawaHub.App.ViewModels"
             xmlns:l="using:HalawaHub.App.Services"
             xmlns:c="using:HalawaHub.App.Controls"
             xmlns:bp="using:HalawaHub.App.BigPicture"
             xmlns:conv="using:HalawaHub.App.Converters"
             xmlns:core="using:HalawaHub.Core.Covers"
             xmlns:news="using:HalawaHub.Core.News"
             xmlns:store="using:HalawaHub.Core.Store"
             xmlns:behaviors="using:HalawaHub.App.Behaviors"
             xmlns:anim="https://github.com/whistyun/AnimatedImage.Avalonia"
             x:Class="HalawaHub.App.Views.GameDialog"
             x:Name="Root"
             x:DataType="vm:MainViewModel"
             IsVisible="{Binding IsGameDialogVisible}">

    <UserControl.Styles>
        <Style Selector="Border.cover">
            <Setter Property="RenderTransform" Value="translateY(0px) rotate(0deg)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.35" Easing="{x:Static l:Springs.Tilt}"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.35"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.cover:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-4px) rotate(-1.5deg)"/>
            <Setter Property="BoxShadow" Value="{DynamicResource GlowCoverHover}"/>
        </Style>
        <Style Selector="Panel.nohover Border.cover:pointerover">
            <Setter Property="RenderTransform" Value="translateY(0px) rotate(0deg)"/>
            <Setter Property="BoxShadow" Value="0 0 0 0 #00000000"/>
        </Style>
        <Style Selector="Button.thumb">
            <Setter Property="Width" Value="96"/>
            <Setter Property="Height" Value="144"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCard}"/>
            <Setter Property="Background" Value="{DynamicResource PageBrush}"/>
        </Style>
        <Style Selector="Button.thumb:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource RedHoverBrush}"/>
        </Style>
        <!-- بطاقات الغلاف الثلاث (التصميم: GameDialog.dc.html) -->
        <Style Selector="Button.copt">
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource PageBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCard}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>
        <Style Selector="Button.copt:pointerover /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource RedHoverBrush}"/>
        </Style>
        <Style Selector="Button.copt.on /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource StatOkBorderBrush}"/>
        </Style>
        <Style Selector="Border.ctile">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource ChipBrush}"/>
        </Style>
        <Style Selector="Border.ctile.dash">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.ctile.dash c|VectorIcon"><Setter Property="Foreground" Value="{DynamicResource MenuTextBrush}"/></Style>
        <Style Selector="Border.tick">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource RedBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,-6,-6,0"/>
            <Setter Property="BoxShadow" Value="0 0 0 2 #33000000"/>
        </Style>
        <Style Selector="Border.tick c|VectorIcon"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style Selector="TextBlock.ct">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.cn">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- متصفح SteamGridDB -->
        <Style Selector="Button.chip">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource PageBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCard}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        </Style>
        <Style Selector="Button.chip.sm">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button.chip:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style Selector="Button.chip.on /template/ ContentPresenter, Button.chip.on:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource RedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.chip.sm.on /template/ ContentPresenter, Button.chip.sm.on:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource RedHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style Selector="Border.gif">
            <Setter Property="Background" Value="#E6F5A623"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.gif TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1A0A0A"/>
            <Setter Property="FontFamily" Value="fonts:Inter#Inter"/>
        </Style>
        <Style Selector="Button.sgt">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.sgt:pointerover Border">
            <Setter Property="BorderBrush" Value="{DynamicResource RedHoverBrush}"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <Border Name="Scrim" Background="{DynamicResource ScrimBrush}" PointerPressed="Scrim_PointerPressed"/>

        <!-- الحجم يتبع البرنامج: 80% منه، لا أصغر من 760×500 ولا أكبر من 1400×900، ودائمًا داخله -->
        <c:DialogFrame Name="Frame" MinFrameWidth="760" MinFrameHeight="500">
        <Border Name="DialogBox" CornerRadius="14" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrushCard}" BorderThickness="1" RenderTransformOrigin="50%,50%">
            <Border CornerRadius="13" ClipToBounds="True">
            <Panel>
            <Grid Name="Sections" ColumnDefinitions="210,*" IsVisible="{Binding !IsCoverSearchOpen}">
                <!-- الشريط الجانبي -->
                <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushCard}"
                        BorderThickness="0,0,1,0" Padding="12,20">
                    <StackPanel>
                        <TextBlock Text="{Binding DetailsGame.Name, FallbackValue=''}" Foreground="{DynamicResource RedHoverBrush}"
                                   FontWeight="Bold" FontSize="17" Margin="10,0,10,16" TextTrimming="CharacterEllipsis"/>
                        <Panel>
                            <c:SlidingPill Orientation="Vertical" Pitch="48" Motion="Dialog" IsHitTestVisible="False"
                                           ItemCount="{Binding GameDialogSectionCount}" SelectedIndex="{Binding GameDialogPillIndex}">
                                <Border CornerRadius="10" Background="{DynamicResource RedGradient}" BoxShadow="{DynamicResource GlowM}"/>
                            </c:SlidingPill>
                            <StackPanel Spacing="4">
                                <Button Classes="si" Classes.on="{Binding GameDialogSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=0}"
                                        Command="{Binding SelectGameDialogSectionCommand}" CommandParameter="0" Content="{l:Loc general}"/>
                                <Button Classes="si" Classes.on="{Binding GameDialogSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=6}"
                                        IsVisible="{Binding DetailsGame.HasNews, FallbackValue=False}"
                                        Command="{Binding SelectGameDialogSectionCommand}" CommandParameter="6" Content="{l:Loc details}"/>
                                <Button Classes="si" Classes.on="{Binding GameDialogSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=7}"
                                        Command="{Binding SelectGameDialogSectionCommand}" CommandParameter="7" Content="{l:Loc coll}"/>
                                <Button Classes="si" Classes.on="{Binding GameDialogSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=1}"
                                        Command="{Binding SelectGameDialogSectionCommand}" CommandParameter="1" Content="{l:Loc files}"/>
                                <Button Classes="si" Classes.on="{Binding GameDialogSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=2}"
                                        Command="{Binding SelectGameDialogSectionCommand}" CommandParameter="2" Content="{l:Loc custom}"/>
                                <Button Classes="si" Classes.on="{Binding GameDialogSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=3}"
                                        Command="{Binding SelectGameDialogSectionCommand}" CommandParameter="3" Content="{l:Loc launch}"/>
                                <Button Classes="si" Classes.on="{Binding GameDialogSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=4}"
                                        IsVisible="{Binding DetailsGame.HasNews, FallbackValue=False}"
                                        Command="{Binding SelectGameDialogSectionCommand}" CommandParameter="4" Content="{l:Loc news}"/>
                                <Button Classes="si" Classes.on="{Binding GameDialogSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=5}"
                                        IsVisible="{Binding DetailsGame.HasTools, FallbackValue=False}"
                                        Command="{Binding SelectGameDialogSectionCommand}" CommandParameter="5" Content="{l:Loc tools}"/>
                            </StackPanel>
                        </Panel>
                    </StackPanel>
                </Border>

                <!-- المحتوى -->
                <Grid Grid.Column="1" Margin="26,22" RowDefinitions="Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                        <TextBlock Name="Title" Classes="h2" Text="{Binding GameDialogTitle}"/>
                        <Button Grid.Column="1" Classes="x" Command="{Binding CloseDetailsCommand}"
                                ToolTip.Tip="{l:Loc close}" AutomationProperties.Name="{l:Loc close}">
                            <c:VectorIcon Data="{StaticResource IconX}" Size="18"/>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Name="Body" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <Panel DataContext="{Binding DetailsGame}" x:DataType="vm:GameCardViewModel">

                            <!-- عام -->
                            <StackPanel Spacing="16" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).GameDialogSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=0}">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="lbl" Text="{l:Loc gameName}"/>
                                    <TextBox Classes="inp" Text="{Binding EditableName, Mode=TwoWay}"
                                             Watermark="{Binding OriginalName}"
                                             AutomationProperties.Name="{l:Loc gameName}"/>
                                    <TextBlock Classes="lbl" Text="{l:Loc nameNote}"/>
                                </StackPanel>
                                <!-- الحالة والتحديث -->
                                <Border Background="{DynamicResource PageBrush}" BorderBrush="{DynamicResource BorderBrushCard}" BorderThickness="1"
                                        CornerRadius="10" Padding="16,12">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="lbl" Text="{l:Loc statusLabel}" VerticalAlignment="Center"/>
                                            <TextBlock Name="StatusDetails" Grid.Column="1" Text="{Binding StatusDetailsText}" FontSize="14" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                                       Foreground="{Binding StatusTone, Converter={x:Static conv:StatusToneBrushConverter.Instance}}"/>
                                        </Grid>
                                        <TextBlock Classes="lbl" FontSize="12" Text="{Binding UpdateNoteText}" TextWrapping="Wrap"/>
                                        <WrapPanel IsVisible="{Binding CanOpenInLauncher}">
                                            <Button Classes="btn" Classes.pri="{Binding HasUpdate}" Margin="0,0,10,0" Content="{Binding OpenInLauncherLabel}"
                                                    IsVisible="{Binding CanOpenInLauncher}"
                                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).OpenInLauncherCommand}" CommandParameter="{Binding}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <c:CappedWidth Cap="560">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,6">
                                    <TextBlock Text="{l:Loc platform}" FontSize="16" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="{DynamicResource ChipBrush}" CornerRadius="8" Padding="10,3">
                                        <TextBlock Text="{Binding PlatformShort}" FontSize="12" FlowDirection="LeftToRight"/>
                                    </Border>
                                </Grid>
                                </c:CappedWidth>
                                <c:CappedWidth Cap="560">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,6">
                                    <TextBlock Text="{l:Loc inFav}" FontSize="16" VerticalAlignment="Center"/>
                                    <ToggleButton Grid.Column="1" Theme="{StaticResource SwitchTheme}" IsChecked="{Binding IsFavorite, Mode=TwoWay}"
                                                  AutomationProperties.Name="{l:Loc inFav}"/>
                                </Grid>
                                </c:CappedWidth>
                                <c:CappedWidth Cap="560">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,6">
                                    <TextBlock Text="{l:Loc hide}" FontSize="16" VerticalAlignment="Center"/>
                                    <ToggleButton Grid.Column="1" Theme="{StaticResource SwitchTheme}" IsChecked="{Binding IsHidden, Mode=TwoWay}"
                                                  AutomationProperties.Name="{l:Loc hide}"/>
                                </Grid>
                                </c:CappedWidth>
                                <!-- يظهر فقط بعد اللعب: لا يضيف شيئًا لأول فتح -->
                                <c:CappedWidth Cap="560" IsVisible="{Binding HasPlayTime}">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,6">
                                    <TextBlock Text="{l:Loc playTime}" FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PlayTimeText}" FontSize="14" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AmberBrush}"/>
                                </Grid>
                                </c:CappedWidth>
                                <c:CappedWidth Cap="560" IsVisible="{Binding HasLastPlayed}">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,6">
                                    <TextBlock Text="{l:Loc lastPlayedLbl}" FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LastPlayedText}" FontSize="14" VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </Grid>
                                </c:CappedWidth>
                            </StackPanel>

                            <!-- المجموعات: عضوية اللعبة في المجموعات اليدوية -->
                            <StackPanel Spacing="12" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).GameDialogSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=7}">
                                <StackPanel Spacing="6">
                                    <ItemsControl ItemsSource="{Binding #Root.((vm:MainViewModel)DataContext).GameMemberships}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CollectionMembership">
                                                <c:CappedWidth Cap="560">
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                                    <TextBlock Text="{Binding Name}" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <ToggleButton Grid.Column="1" Theme="{StaticResource SwitchTheme}" IsChecked="{Binding IsMember, Mode=TwoWay}"
                                                                  AutomationProperties.Name="{Binding Name}"/>
                                                </Grid>
                                                </c:CappedWidth>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <TextBlock Classes="lbl" Text="{l:Loc collNote}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- الملفات المثبتة -->
                            <StackPanel Spacing="16" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).GameDialogSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=1}">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="lbl" Text="{l:Loc storage}"/>
                                    <Border Classes="code">
                                        <TextBlock Text="{Binding InstallPath}"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Classes="btn pri" Content="{l:Loc openLoc}" IsEnabled="{Binding HasInstallPath}"
                                            Command="{Binding #Root.((vm:MainViewModel)DataContext).OpenInstallLocationCommand}"/>
                                    <Button Classes="btn" Content="{l:Loc copyPath}" IsEnabled="{Binding HasInstallPath}" Click="CopyPath_Click"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Left" Padding="16,10" CornerRadius="10"
                                        Background="{DynamicResource PageBrush}" BorderBrush="{DynamicResource BorderBrushCard}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Classes="lbl" Text="{l:Loc sizeOnDisk}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SizeOnDiskText}" FontSize="15" FontWeight="Bold" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !IsInstalled}">
                                    <TextBlock Classes="lbl" Text="{l:Loc statusLabel}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center"/>
                                </Grid>
                                <Button Classes="btn" Classes.pri="{Binding NeedsRepair}" HorizontalAlignment="Left" Content="{l:Loc verifyFiles}"
                                        IsVisible="{Binding CanVerify}"
                                        Command="{Binding #Root.((vm:MainViewModel)DataContext).VerifyFilesCommand}" CommandParameter="{Binding}"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Name="ShortcutButton" Classes="btn" Content="{l:Loc desktopShortcut}" Click="Shortcut_Click"/>
                                    <Button Classes="btn" Content="{Binding UninstallLabel}" IsVisible="{Binding CanUninstall}" Foreground="{DynamicResource StatBadTextBrush}"
                                            Command="{Binding #Root.((vm:MainViewModel)DataContext).DeleteGameCommand}"/>
                                </StackPanel>
                                <!-- لعبة مضافة يدويًا: الملف الذي يُشغَّل، وتغييره أو إزالتها من Halawa -->
                                <StackPanel Spacing="8" IsVisible="{Binding IsManual}">
                                    <TextBlock Classes="lbl" Text="{l:Loc manualTarget}"/>
                                    <Border Classes="code">
                                        <TextBlock Text="{Binding ManualTarget}" TextWrapping="Wrap"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Classes="btn" Content="{l:Loc changeFile}" Click="ChangeManualFile_Click"/>
                                        <Button Classes="btn" Content="{l:Loc removeManual}" Click="RemoveManual_Click"/>
                                    </StackPanel>
                                    <TextBlock Classes="lbl" Text="{l:Loc removeManualNote}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- الغلاف: الحالي، ثم ثلاث بطاقات (يدويًا، SteamGridDB، الأصلي) والمستعمل عليه ✓ -->
                            <Panel IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).GameDialogSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=2}">
                                <StackPanel Spacing="16" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).IsCoverHome}">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Classes="cover" FlowDirection="LeftToRight" Width="72" Height="108" CornerRadius="10" VerticalAlignment="Top"
                                                BorderBrush="{DynamicResource BorderBrushCard}" BorderThickness="1"
                                                Background="{Binding PaletteIndex, Converter={x:Static conv:CoverPaletteConverter.Instance}}">
                                            <Border CornerRadius="9" ClipToBounds="True">
                                                <Panel>
                                                    <TextBlock Text="{Binding Letter}" FontSize="32" FontWeight="ExtraBold" Foreground="#24FFFFFF"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="fonts:Inter#Inter"/>
                                                    <Image Stretch="UniformToFill" IsVisible="{Binding HasCoverImage}"
                                                           behaviors:AsyncImage.SourceUrl="{Binding CoverImageUrl}"
                                                           behaviors:AsyncImage.FallbackUrl="{Binding CoverImageUrlFallback}"
                                                           anim:ImageBehavior.AnimatedSource="{Binding AnimatedCoverSource}"/>
                                                </Panel>
                                            </Border>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Classes="lbl" FontSize="12" Text="{l:Loc curCover}"/>
                                            <TextBlock Name="CoverSourceText" Text="{Binding CoverSourceText}" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Classes="lbl" FontSize="12" Text="{l:Loc imgNote}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                    <c:CappedWidth Cap="560">
                                    <UniformGrid Columns="3" Name="CoverOptions">
                                        <Button Classes="copt" Margin="0,0,8,0" Click="ChangeCover_Click" Classes.on="{Binding IsCoverOwn}"
                                                AutomationProperties.Name="{l:Loc optOwn}">
                                            <StackPanel Spacing="8">
                                                <Panel Width="64" Height="84" HorizontalAlignment="Center">
                                                    <Border Classes="ctile dash">
                                                        <Panel>
                                                        <Rectangle RadiusX="8" RadiusY="8" Stroke="{DynamicResource RedHoverBrush}" StrokeThickness="1.5" StrokeDashArray="3,2"/>
                                                        <c:VectorIcon Data="{StaticResource IconPlus}" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Panel>
                                                    </Border>
                                                    <Border Classes="tick" IsVisible="{Binding IsCoverOwn}"><c:VectorIcon Data="{StaticResource IconCheck}" Size="12" StrokeWidth="3" Foreground="White"/></Border>
                                                </Panel>
                                                <TextBlock Classes="ct" Text="{l:Loc optOwn}"/>
                                                <TextBlock Classes="cn" Text="{l:Loc optOwnN}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Name="SgdbCard" Classes="copt" Margin="4,0" Classes.on="{Binding IsCoverSgdb}"
                                                Command="{Binding #Root.((vm:MainViewModel)DataContext).SearchCoversCommand}"
                                                AutomationProperties.Name="{l:Loc optSg}">
                                            <StackPanel Spacing="8">
                                                <Panel Width="64" Height="84" HorizontalAlignment="Center">
                                                    <Border Classes="ctile" Background="{DynamicResource ComingSoonGradient}">
                                                        <c:VectorIcon Data="{StaticResource IconSearch}" Size="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Border Classes="tick" IsVisible="{Binding IsCoverSgdb}"><c:VectorIcon Data="{StaticResource IconCheck}" Size="12" StrokeWidth="3" Foreground="White"/></Border>
                                                </Panel>
                                                <TextBlock Classes="ct" Text="{l:Loc optSg}"/>
                                                <TextBlock Classes="cn" Text="{l:Loc optSgN}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="copt" Margin="8,0,0,0" Classes.on="{Binding IsCoverOriginal}"
                                                Command="{Binding #Root.((vm:MainViewModel)DataContext).RestoreCoverCommand}"
                                                AutomationProperties.Name="{l:Loc optOrig}">
                                            <StackPanel Spacing="8">
                                                <Panel Width="64" Height="84" HorizontalAlignment="Center">
                                                    <Border Classes="ctile" FlowDirection="LeftToRight"
                                                            Background="{Binding PaletteIndex, Converter={x:Static conv:CoverPaletteConverter.Instance}}">
                                                        <TextBlock Text="{Binding Letter}" FontSize="26" FontWeight="ExtraBold" Foreground="#55FFFFFF"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="fonts:Inter#Inter"/>
                                                    </Border>
                                                    <Border Classes="tick" IsVisible="{Binding IsCoverOriginal}"><c:VectorIcon Data="{StaticResource IconCheck}" Size="12" StrokeWidth="3" Foreground="White"/></Border>
                                                </Panel>
                                                <TextBlock Classes="ct" Text="{l:Loc optOrig}"/>
                                                <TextBlock Classes="cn" Text="{l:Loc optOrigN}"/>
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>
                                    </c:CappedWidth>
                                </StackPanel>

                                <!-- لا مفتاح بعد: نفس كلمات الإعدادات ومعالج البداية -->
                                <Border Name="KeyCard" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).IsCoverKeyOpen}" VerticalAlignment="Top"
                                        Background="{DynamicResource PageBrush}" BorderBrush="{DynamicResource BorderBrushCard}" BorderThickness="1"
                                        CornerRadius="12" Padding="16,14">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{l:Loc keyTitle}" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Classes="lbl" FontSize="12" Text="{l:Loc sgdbWhy}" TextWrapping="Wrap"/>
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <TextBox Classes="inp" PasswordChar="•" Watermark="{l:Loc keyPh}" AutomationProperties.Name="SteamGridDB"
                                                     Text="{Binding #Root.((vm:MainViewModel)DataContext).SteamGridDbApiKey, Mode=TwoWay}"/>
                                            <Button Grid.Column="1" Classes="btn pri" Margin="10,0,0,0" Content="{l:Loc verify}"
                                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).CheckKeyAndBrowseCommand}"/>
                                            <Button Grid.Column="2" Classes="btn" Margin="10,0,0,0" Content="{l:Loc getKey}"
                                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).OpenUrlCommand}"
                                                    CommandParameter="{Binding #Root.((vm:MainViewModel)DataContext).SteamGridDbKeyUrl}"/>
                                        </Grid>
                                        <TextBlock Classes="lbl" FontSize="12" Text="{Binding #Root.((vm:MainViewModel)DataContext).ApiKeyStatusText}"
                                                   IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).HasApiKeyStatus}"/>
                                        <Button Classes="btn" HorizontalAlignment="Left" Content="{l:Loc sgdbBack}"
                                                Command="{Binding #Root.((vm:MainViewModel)DataContext).CloseCoverSearchCommand}"/>
                                    </StackPanel>
                                </Border>
                            </Panel>

                            <!-- خيارات التشغيل -->
                            <StackPanel Spacing="8" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).GameDialogSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=3}">
                                <TextBlock Classes="lbl" Text="{l:Loc launch}"/>
                                <TextBox Classes="inp" FlowDirection="LeftToRight" TextAlignment="Left"
                                         Text="{Binding LaunchParameters, Mode=TwoWay}" Watermark="{l:Loc launchPh}"
                                         IsEnabled="{Binding SupportsLaunchParameters}"
                                         AutomationProperties.Name="{l:Loc launch}"/>
                                <TextBlock Classes="lbl" Text="{l:Loc launchNote}" IsVisible="{Binding SupportsLaunchParameters}"/>
                                <TextBlock Classes="lbl" Text="{l:Loc launchUrlNote}" TextWrapping="Wrap" IsVisible="{Binding !SupportsLaunchParameters}"/>
                            </StackPanel>

                            <!-- التفاصيل: بيانات متجر Steam (ألعاب Steam فقط) -->
                            <StackPanel Name="StoreDetails" Spacing="14" DataContext="{Binding #Root.DataContext}" x:DataType="vm:MainViewModel"
                                        IsVisible="{Binding GameDialogSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=6}">
                                <TextBlock Classes="lbl" Text="{l:Loc storeLoading}" IsVisible="{Binding IsStoreLoading}"/>
                                <TextBlock Classes="lbl" Text="{l:Loc storeNone}" IsVisible="{Binding HasNoStoreInfo}" TextWrapping="Wrap"/>
                                <StackPanel Spacing="14" IsVisible="{Binding HasStoreInfo}">
                                    <Border CornerRadius="10" ClipToBounds="True" Width="460" Height="215" HorizontalAlignment="Left" IsVisible="{Binding HasStoreHeader}"
                                            FlowDirection="LeftToRight" Background="{DynamicResource ChipBrush}">
                                        <Image Stretch="UniformToFill" behaviors:AsyncImage.DecodeWidth="920" behaviors:AsyncImage.SourceUrl="{Binding StoreHeader}"/>
                                    </Border>
                                    <TextBlock Text="{Binding StoreDescription}" FontSize="14" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left"/>
                                    <Border Classes="st" Padding="10,4" CornerRadius="8" BorderThickness="1" HorizontalAlignment="Left" IsVisible="{Binding HasDeckBadge}"
                                            BorderBrush="{Binding DeckTone, Converter={x:Static conv:StatusToneBrushConverter.Instance}}">
                                        <TextBlock Name="DeckBadge" Text="{Binding DeckText}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{Binding DeckTone, Converter={x:Static conv:StatusToneBrushConverter.Instance}}"/>
                                    </Border>
                                    <Border Classes="kv"><StackPanel Orientation="Horizontal"><TextBlock Classes="k" Text="{l:Loc storeDeveloper}"/><TextBlock Text="{Binding StoreDeveloper}" TextWrapping="Wrap"/></StackPanel></Border>
                                    <Border Classes="kv"><StackPanel Orientation="Horizontal"><TextBlock Classes="k" Text="{l:Loc storePublisher}"/><TextBlock Text="{Binding StorePublisher}" TextWrapping="Wrap"/></StackPanel></Border>
                                    <Border Classes="kv"><StackPanel Orientation="Horizontal"><TextBlock Classes="k" Text="{l:Loc storeRelease}"/><TextBlock Text="{Binding StoreRelease}"/></StackPanel></Border>

                                    <StackPanel Spacing="6" IsVisible="{Binding HasScreenshots}">
                                        <TextBlock Classes="lbl" Text="{l:Loc storeMedia}"/>
                                        <ItemsControl ItemsSource="{Binding StoreScreenshots}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="store:SteamScreenshot">
                                                    <Button Classes="shot" Width="176" Height="99" Padding="0" CornerRadius="8" Margin="0,0,10,10"
                                                            BorderThickness="1" BorderBrush="{DynamicResource BorderBrushCard}" Background="{DynamicResource PageBrush}"
                                                            Command="{Binding #Root.((vm:MainViewModel)DataContext).OpenMediaCommand}" CommandParameter="{Binding}">
                                                        <Image Stretch="UniformToFill" behaviors:AsyncImage.DecodeWidth="352" behaviors:AsyncImage.SourceUrl="{Binding ThumbnailUrl}"/>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Spacing="6" IsVisible="{Binding HasWindowsReq}">
                                        <TextBlock Classes="lbl" Text="{l:Loc storeReqWindows}"/>
                                        <Border Classes="code"><TextBlock Text="{Binding StoreWindowsReq}" TextWrapping="Wrap" FlowDirection="LeftToRight" HorizontalAlignment="Left"/></Border>
                                    </StackPanel>
                                    <StackPanel Spacing="6" IsVisible="{Binding HasLinuxReq}">
                                        <TextBlock Classes="lbl" Text="{l:Loc storeReqLinux}"/>
                                        <Border Classes="code"><TextBlock Text="{Binding StoreLinuxReq}" TextWrapping="Wrap" FlowDirection="LeftToRight" HorizontalAlignment="Left"/></Border>
                                    </StackPanel>
                                    <TextBlock Classes="lbl" FontSize="12" Text="{l:Loc storeSource}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- الأخبار: ألعاب Steam فقط -->
                            <StackPanel Spacing="8" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).GameDialogSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=4}">
                                <TextBlock Classes="lbl" Text="{l:Loc newsLoading}" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).IsGameNewsLoading}"/>
                                <TextBlock Classes="lbl" Text="{l:Loc newsNone}" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).HasNoGameNews}"/>
                                <ItemsControl ItemsSource="{Binding #Root.((vm:MainViewModel)DataContext).GameNews}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="news:NewsItem">
                                            <Button Classes="btn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="NaN"
                                                    Padding="14,10" Margin="0,0,0,8"
                                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).OpenUrlCommand}" CommandParameter="{Binding Url}">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Date, StringFormat='{}{0:yyyy-MM-dd}'}" FontSize="12"
                                                               Foreground="{DynamicResource MutedBrush}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- الأدوات: تظهر فقط إذا كانت للعبة أدوات من الإضافات -->
                            <ItemsControl ItemsSource="{Binding Tools}"
                                          IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).GameDialogSection, Converter={x:Static conv:EqualsTextConverter.Instance}, ConverterParameter=5}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GameToolViewModel">
                                        <Border Background="{DynamicResource PageBrush}" BorderBrush="{DynamicResource BorderBrushCard}" BorderThickness="1"
                                                CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                                    <TextBlock Classes="lbl" Text="{Binding Description}" FontSize="12" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="btn" Content="{Binding ActionLabel}" Command="{Binding ToggleCommand}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Panel>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,16,0,0">
                        <TextBlock Classes="lbl" Text="{l:Loc saved}"/>
                    </Border>
                </Grid>
            </Grid>
            <!-- متصفح SteamGridDB: يأخذ النافذة كلها (رجوع، العنوان، البحث، الأنواع، الأشكال، شبكة بلا حد) -->
            <Grid Name="SgdbView" Margin="22,18" RowDefinitions="Auto,Auto,Auto,Auto,*"
                  IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).IsCoverSearchOpen}" DataContext="{Binding Sgdb}" x:DataType="vm:SgdbBrowser">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
                    <Button Classes="x" Command="{Binding #Root.((vm:MainViewModel)DataContext).CloseCoverSearchCommand}"
                            ToolTip.Tip="{l:Loc sgdbBack}" AutomationProperties.Name="{l:Loc sgdbBack}">
                        <Panel RenderTransform="{Binding IsRtl, Source={x:Static l:Loc.Instance}, Converter={x:Static bp:BpIs.FlipX}}">
                            <c:VectorIcon Data="{StaticResource IconChevronLeft}" Size="18"/>
                        </Panel>
                    </Button>
                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Classes="lbl" FontSize="12" Text="{Binding CountText}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="x" Command="{Binding #Root.((vm:MainViewModel)DataContext).CloseDetailsCommand}"
                            ToolTip.Tip="{l:Loc close}" AutomationProperties.Name="{l:Loc close}">
                        <c:VectorIcon Data="{StaticResource IconX}" Size="18"/>
                    </Button>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                    <TextBox Name="SgdbQuery" Classes="inp" Text="{Binding Query, Mode=TwoWay}" Watermark="{l:Loc sgQ}"
                             AutomationProperties.Name="{l:Loc sgQ}" KeyDown="SgdbQuery_KeyDown"/>
                    <TextBlock Grid.Column="1" Classes="lbl" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" Text="{l:Loc sgQn}"/>
                </Grid>
                <!-- الأنواع -->
                <ItemsControl Grid.Row="2" Name="SgdbTypes" ItemsSource="{Binding TypeChips}" Margin="0,0,0,10">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SgdbChip">
                            <Button Classes="chip" Classes.on="{Binding IsOn}" Content="{Binding Label}"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).SgdbTypeCommand}" CommandParameter="{Binding Key}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- الأشكال والمتحركة فقط -->
                <WrapPanel Grid.Row="3" Margin="0,0,0,12">
                    <ItemsControl ItemsSource="{Binding StyleChips}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SgdbChip">
                                <Button Classes="chip sm" Classes.on="{Binding IsOn}" Margin="0,0,6,6" Content="{Binding Label}"
                                        Command="{Binding #Root.((vm:MainViewModel)DataContext).SgdbStyleCommand}" CommandParameter="{Binding Key}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Name="SgdbAnimated" Classes="chip sm" Classes.on="{Binding AnimatedOnly}" Margin="0,0,6,6"
                            Command="{Binding #Root.((vm:MainViewModel)DataContext).SgdbAnimatedCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Classes="gif"><TextBlock Text="GIF"/></Border>
                            <TextBlock Text="{l:Loc sgAnim}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <!-- النتائج: الصفحة التالية تُحمَّل عند الاقتراب من الأسفل -->
                <ScrollViewer Grid.Row="4" Name="SgdbBody" HorizontalScrollBarVisibility="Disabled" ScrollChanged="SgdbBody_ScrollChanged">
                    <StackPanel>
                        <TextBlock Classes="lbl" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" Foreground="{DynamicResource StatBadTextBrush}"/>
                        <TextBlock Classes="lbl" Text="{l:Loc sgNone}" IsVisible="{Binding IsEmpty}"/>
                        <ItemsControl Name="SgdbTiles" ItemsSource="{Binding Tiles}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SgdbTile">
                                    <Button Classes="sgt" Margin="0,0,10,10" Padding="0"
                                            Command="{Binding #Root.((vm:MainViewModel)DataContext).PickSgdbCommand}" CommandParameter="{Binding}">
                                        <StackPanel Width="{Binding TileWidth}" Spacing="4">
                                            <Border Height="{Binding TileHeight}" CornerRadius="8" ClipToBounds="True" FlowDirection="LeftToRight"
                                                    Background="{DynamicResource ChipBrush}" BorderBrush="{DynamicResource BorderBrushCard}" BorderThickness="1">
                                                <Panel>
                                                    <Image Stretch="Uniform" behaviors:AsyncImage.DecodeWidth="320" behaviors:AsyncImage.SourceUrl="{Binding ThumbUrl}"/>
                                                    <Border Classes="gif" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsVisible="{Binding IsAnimated}">
                                                        <TextBlock Text="GIF"/>
                                                    </Border>
                                                </Panel>
                                            </Border>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding StyleText}" FontSize="11" Foreground="{DynamicResource SubtleBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource MutedBrush}" FlowDirection="LeftToRight">
                                                    <Run Text="♥" Foreground="{DynamicResource RedHoverBrush}"/><Run Text=" "/><Run Text="{Binding ScoreText}"/>
                                                </TextBlock>
                                            </Grid>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="lbl" FontSize="12" HorizontalAlignment="Center" Margin="0,6" Text="{l:Loc sgdbSearching}" IsVisible="{Binding IsLoading}"/>
                        <TextBlock Classes="lbl" FontSize="12" HorizontalAlignment="Center" Margin="0,6" Text="{l:Loc sgMore}" IsVisible="{Binding HasMore}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            </Panel>
            </Border>
        </Border>
        </c:DialogFrame>
    </Panel>
</UserControl>
