<!--
  أيقونات متجهية (Vector) — مصدرها Lucide Icons (https://lucide.dev)، ترخيص ISC
  (متوافق تجاريًا 100%، ما يفرض قيود على بيع البرنامج). كل أيقونة مبنية على
  شبكة 24×24 بنفس أسلوب الرسم بخط رفيع (Outline)، لهذا PathIcon هنا يُرسم
  بـ Stroke بدل Fill الافتراضية — شوف PathIcon.Style بأسفل الملف.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

