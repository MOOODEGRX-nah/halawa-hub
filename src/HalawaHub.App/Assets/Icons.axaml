    <!--
      PathIcon الافتراضي بـ Avalonia يرسم بـ Fill بس (يناسب أيقونات مصمتة زي
      Fluent). أيقونات Lucide خط رفيع (Outline) بلا تعبئة، فلازم نغيّر طريقة
      الرسم لـ Stroke عشان تطلع صح. اسم صريح (StrokeIconTheme) بدل استبدال
      ثيم PathIcon الافتراضي مباشرة — أسلم وما يتعارض مع ترتيب دمج الموارد،
      لازم تحط Theme="{StaticResource StrokeIconTheme}" على كل PathIcon يستخدم
      أيقونات هذا الملف.
    -->
    <ControlTheme x:Key="StrokeIconTheme" TargetType="PathIcon">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Viewbox Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                    <Path Data="{TemplateBinding Data}"
                          Fill="Transparent"
                          Stroke="{TemplateBinding Foreground}"
                          StrokeThickness="2"
                          StrokeLineCap="Round"
                          StrokeJoin="Round"
                          Stretch="Uniform"/>
                </Viewbox>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
