<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RiftClone.App.ViewModels"
        xmlns:conv="using:RiftClone.App.Converters"
        xmlns:behaviors="using:RiftClone.App.Behaviors"
        x:Class="RiftClone.App.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainViewModel"
        Title="Halawa-Hub" Width="980" Height="660"
        FlowDirection="RightToLeft">

    <Window.Background>
        <RadialGradientBrush Center="50%,0%" GradientOrigin="50%,0%" Radius="0.9">
            <GradientStop Color="#1A0A0C" Offset="0"/>
            <GradientStop Color="#0A0404" Offset="0.55"/>
            <GradientStop Color="#000000" Offset="1"/>
        </RadialGradientBrush>
    </Window.Background>

    <Window.Resources>
        <conv:PlatformColorConverter x:Key="PlatformColorConverter"/>
        <conv:BoolToStatusColorConverter x:Key="BoolToStatusColorConverter"/>
    </Window.Resources>

    <Window.Styles>
        <!-- زر أحمر أساسي: تشغيل كل لعبة -->
        <Style Selector="Button.play-btn">
            <Setter Property="Background" Value="#B91C1C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button.play-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#EF4444"/>
        </Style>

        <!-- زر إجراء عاجل (تحميل تحديث) -->
        <Style Selector="Button.cta-btn">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.cta-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#EF4444"/>
        </Style>

        <!-- زر ثانوي: تحديث القائمة -->
        <Style Selector="Button.outline-btn">
            <Setter Property="Background" Value="#150A0C"/>
            <Setter Property="BorderBrush" Value="#4A2024"/>
            <Setter Property="BorderThickness" Value="1.3"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.outline-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A1418"/>
        </Style>
    </Window.Styles>

    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- شريط علوي -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                <TextBlock Text="Halawa" FontSize="26" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="-Hub" FontSize="26" FontWeight="Bold" Foreground="#EF4444"/>
            </StackPanel>

            <Border Background="#1A0A0C" BorderBrush="#7A2020" BorderThickness="1"
                    CornerRadius="20" Padding="10,4" Margin="16,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="6" Height="6" Fill="#EF4444" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding FilteredGames.Count, StringFormat='{}{0} لعبة'}"
                               FontSize="10" FontWeight="Bold" Foreground="#D1D5DB" LetterSpacing="1"/>
                </StackPanel>
            </Border>

            <Button Classes="outline-btn" Content="تحديث القائمة" Width="120" Height="34"
                    Margin="16,0,0,0" Command="{Binding RefreshCommand}"/>
        </StackPanel>

        <!-- شريط البحث والفلترة -->
        <Grid Grid.Row="1" ColumnDefinitions="*,150" Margin="0,0,0,16">
            <TextBox Grid.Column="0" Watermark="ابحث عن لعبة..."
                     Text="{Binding SearchQuery, Mode=TwoWay}"
                     Background="#150A0C" BorderBrush="#3A1518" BorderThickness="1"
                     CornerRadius="6" Foreground="White" Padding="12,8"/>
            <ComboBox Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Stretch"
                      Background="#150A0C" BorderBrush="#3A1518" CornerRadius="6"
                      ItemsSource="{Binding AvailablePlatforms}"
                      SelectedItem="{Binding SelectedPlatformFilter, Mode=TwoWay}"/>
        </Grid>

        <!-- شريط إشعار التحديث، يظهر فقط لما فيه إصدار أحدث -->
        <Border Grid.Row="2" Background="#1A0A0C" BorderBrush="#DC2626" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                IsVisible="{Binding HasUpdateMessage}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding UpdateMessage}"
                           Foreground="White" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Classes="cta-btn" Content="تحميل التحديث"
                        Padding="14,6" Margin="12,0,0,0" Command="{Binding OpenUpdateCommand}"/>
            </Grid>
        </Border>

        <!-- قائمة الألعاب كبطاقات -->
        <ScrollViewer Grid.Row="3">
            <ListBox ItemsSource="{Binding FilteredGames}"
                     SelectedItem="{Binding SelectedGame}"
                     Background="Transparent"
                     BorderThickness="0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,10,10"/>
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected Border#CardBorder">
                        <Setter Property="BorderBrush" Value="#F5A623"/>
                        <Setter Property="BorderThickness" Value="2"/>
                    </Style>
                    <Style Selector="ListBoxItem:pointerover Border#CardBorder">
                        <Setter Property="Background" Value="#1F1012"/>
                    </Style>
                </ListBox.Styles>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="CardBorder" Width="200" Height="270"
                                CornerRadius="10" Background="#140A0C"
                                BorderBrush="#2A1418" BorderThickness="1"
                                ClipToBounds="True">
                            <Grid>
                                <!-- صورة الغلاف (لو متوفرة لهذي المنصة) -->
                                <Image Stretch="UniformToFill"
                                       IsVisible="{Binding HasCoverImage}"
                                       behaviors:AsyncImage.SourceUrl="{Binding CoverImageUrl}"/>

                                <!-- تغميق موحّد فوق الصورة كاملة عشان النص يبين دايمًا -->
                                <Border Background="#66000000" IsVisible="{Binding HasCoverImage}"/>

                                <!-- تدرّج أغمق بالأسفل تحديدًا لقراءة أوضح للاسم والزر -->
                                <Border IsVisible="{Binding HasCoverImage}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0%,35%" EndPoint="0%,100%">
                                            <GradientStop Color="#00000000" Offset="0"/>
                                            <GradientStop Color="#E6000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- المحتوى فوق الصورة -->
                                <Grid Margin="12,10" RowDefinitions="Auto,*,Auto,Auto">

                                    <!-- شارة المنصة بشكل Pill -->
                                    <Border Grid.Row="0" HorizontalAlignment="Left"
                                            Background="#801A0A0C" BorderThickness="1"
                                            CornerRadius="10" Padding="8,2"
                                            BorderBrush="{Binding Platform, Converter={StaticResource PlatformColorConverter}}">
                                        <TextBlock Text="{Binding Platform}" FontSize="10" FontWeight="Bold"
                                                   LetterSpacing="0.5"
                                                   Foreground="{Binding Platform, Converter={StaticResource PlatformColorConverter}}"/>
                                    </Border>

                                    <TextBlock Grid.Row="1" Text="{Binding Name}"
                                               FontSize="15" FontWeight="Bold" Foreground="White"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               MaxLines="3" VerticalAlignment="Bottom" Margin="0,8"/>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{Binding IsInstalled, Converter={StaticResource BoolToStatusColorConverter}}"/>
                                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                   Foreground="#D1D5DB" Margin="6,0,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Row="3" Classes="play-btn" Content="تشغيل"
                                            HorizontalAlignment="Stretch" Height="30"
                                            Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).LaunchGameCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>

        <!-- رسالة حالة/خطأ -->
        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}"
                   Foreground="#FF6B6B" Margin="0,10,0,0"
                   IsVisible="{Binding HasStatusMessage}"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
