<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:bp="using:HalawaHub.App.BigPicture"
        xmlns:bpc="using:HalawaHub.App.BigPicture.Controls"
        xmlns:c="using:HalawaHub.App.Controls"
        xmlns:l="using:HalawaHub.App.Services"
        xmlns:behaviors="using:HalawaHub.App.Behaviors"
        x:Class="HalawaHub.App.BigPicture.BigPictureWindow"
        x:DataType="bp:BigPictureViewModel"
        Title="{Binding Title, Source={x:Static bp:BpWindowTitle.Instance}}"
        SystemDecorations="None" CanResize="False" ShowInTaskbar="True"
        Background="#0A0404" Icon="/Assets/icon.ico">

  <Window.Resources>
    <SolidColorBrush x:Key="BpText" Color="#F5EDED"/>
    <SolidColorBrush x:Key="BpMuted" Color="#B8A4A4"/>
    <SolidColorBrush x:Key="BpSurface" Color="#140808"/>
    <SolidColorBrush x:Key="BpLine" Color="#2A1212"/>
    <LinearGradientBrush x:Key="BpRedGrad" StartPoint="0%,50%" EndPoint="100%,50%">
      <GradientStop Color="#991B1B" Offset="0"/><GradientStop Color="#DC2626" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BpRedHot" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#991B1B" Offset="0"/><GradientStop Color="#EF4444" Offset="1"/>
    </LinearGradientBrush>

    <!-- بطاقة لعبة (.c) -->
    <DataTemplate x:Key="BpCardTemplate" x:DataType="bp:BpCardItem">
      <Button Classes="bpcard" Classes.f="{Binding IsFocused}" Focusable="False" Click="OnCardClick"
              bpc:BpFocus.Key="{Binding FocusKey}" bpc:BpFocus.Radius="18" Width="204" Height="306">
        <Panel>
          <Border CornerRadius="17" ClipToBounds="True" Background="{Binding Game.Name, Converter={x:Static bp:BpArtConverter.Instance}}">
            <Panel>
              <TextBlock Text="{Binding Game.Letter}" FontFamily="fonts:Inter#Inter" FontWeight="ExtraBold" FontSize="110"
                         Foreground="#1FFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Image Stretch="UniformToFill"
                     behaviors:AsyncImage.DecodeWidth="320"
                     behaviors:AsyncImage.SourceUrl="{Binding Game.CoverUrl}"
                     behaviors:AsyncImage.FallbackUrl="{Binding Game.CoverFallbackUrl}"/>
              <Border>
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#1AFFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="0.35"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <Border VerticalAlignment="Bottom" Padding="14,58,14,14">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#000A0404" Offset="0"/><GradientStop Color="#F20A0404" Offset="0.55"/>
                  </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                  <bpc:BpAutoText Classes="cardtitle" Text="{Binding Game.Name}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Game.HoursText}" FontSize="15" Foreground="{StaticResource BpMuted}" Margin="0,2,0,0"/>
                  <Border Classes="cpl" CornerRadius="10" Background="#DC2626" ClipToBounds="True">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                      <c:VectorIcon Data="M6 4l14 8-14 8z" Size="15" IsFilled="True" Foreground="White"/>
                      <TextBlock Text="{l:Loc bpPlay}" FontSize="17" FontWeight="SemiBold" Foreground="White"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </Panel>
          </Border>
          <Border Classes="bd" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top" Height="30" Padding="11,0">
            <TextBlock Text="{Binding Game.ShownPlatform}" FontSize="15" VerticalAlignment="Center"/>
          </Border>
          <Border IsVisible="{Binding Game.HasUpdate}" Margin="12" Width="30" Height="30" CornerRadius="15" Background="#F5A623"
                  HorizontalAlignment="Right" VerticalAlignment="Top" BoxShadow="0 0 14 0 #8CF5A623">
            <c:VectorIcon Data="M12 5v11M7 11l5 5 5-5" Size="16" StrokeWidth="3" Foreground="#1A0A0C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </Panel>
      </Button>
    </DataTemplate>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource BpText}"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter, Button:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- شارة (.bd) -->
    <Style Selector="Border.bd">
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Background" Value="#C70A0404"/>
      <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- الأزرار (.pl / .btn) -->
    <Style Selector="Button.btn">
      <Setter Property="Height" Value="68"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Background" Value="{StaticResource BpSurface}"/>
      <Setter Property="BorderBrush" Value="#2E1616"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="30,0"/>
      <Setter Property="FontSize" Value="21"/>
      <Setter Property="Foreground" Value="{StaticResource BpText}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="RenderTransform" Value="scale(1)"/>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="{x:Static bp:BpSprings.Press}"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.btn /template/ ContentPresenter">
      <Setter Property="Background" Value="{Binding $parent[Button].Background}"/>
      <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}"/>
      <Setter Property="CornerRadius" Value="{Binding $parent[Button].CornerRadius}"/>
    </Style>
    <Style Selector="Button.btn:pointerover"><Setter Property="Background" Value="#241010"/></Style>
    <Style Selector="Button.btn.f">
      <Setter Property="Background" Value="#241010"/>
      <Setter Property="RenderTransform" Value="scale(1.05)"/>
    </Style>
    <!-- الأزرار العريضة (قائمة صفحة اللعبة ولوحاتها) لا تكبر: الحلقة تحيط بحوافها المرسومة نفسها،
         ولونها الأفتح يكفي. تكبيرها كان لا يُرسم أحيانًا فتظهر الحلقة مستطيلًا فارغًا حول الزر -->
    <Style Selector="Button.btn.wide.f"><Setter Property="RenderTransform" Value="scale(1)"/></Style>
    <Style Selector="Button.btn.wide.f:not(.pl)"><Setter Property="Background" Value="#3A1518"/></Style>
    <Style Selector="Button.btn /template/ ContentPresenter"><Setter Property="Transitions"><Transitions><BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.3"/></Transitions></Setter></Style>
    <Style Selector="Button.btn.f /template/ ContentPresenter"><Setter Property="BoxShadow" Value="0 10 30 0 #73EF4444"/></Style>
    <Style Selector="Button.btn.pri, Button.btn.pl">
      <Setter Property="Background" Value="#DC2626"/>
      <Setter Property="BorderBrush" Value="#DC2626"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.btn.pl"><Setter Property="FontSize" Value="23"/><Setter Property="Padding" Value="36,0"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Button.btn.pri.f, Button.btn.pl.f, Button.btn.pl:pointerover, Button.btn.pri:pointerover"><Setter Property="Background" Value="#EF4444"/></Style>
    <Style Selector="Button.btn:pressed"><Setter Property="RenderTransform" Value="scale(0.94)"/></Style>

    <!-- بطاقة اللعبة (.c) -->
    <Style Selector="Button.bpcard">
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="BorderBrush" Value="{StaticResource BpLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="ZIndex" Value="0"/>
      <Setter Property="RenderTransform" Value="translateY(0px) scale(1)"/>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.32" Easing="{x:Static bp:BpSprings.Lift}"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.bpcard /template/ ContentPresenter">
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="BorderBrush" Value="{StaticResource BpLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.bpcard.f">
      <Setter Property="ZIndex" Value="3"/>
      <Setter Property="RenderTransform" Value="translateY(-10px) scale(1.06)"/>
    </Style>
    <Style Selector="Button.bpcard.f /template/ ContentPresenter"><Setter Property="BoxShadow" Value="0 18 44 0 #61EF4444"/></Style>
    <Style Selector="Button.bpcard:pressed"><Setter Property="RenderTransform" Value="scale(0.98)"/></Style>
    <Style Selector="TextBlock.cardtitle"><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Border.cpl">
      <Setter Property="Height" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Height" Duration="0:0:0.3" Easing="{x:Static bp:BpSprings.Open}"/>
          <ThicknessTransition Property="Margin" Duration="0:0:0.3"/>
          <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.bpcard.f Border.cpl"><Setter Property="Height" Value="44"/><Setter Property="Margin" Value="0,10,0,0"/><Setter Property="Opacity" Value="1"/></Style>

    <!-- "عرض الكل" (.c.more) -->
    <Style Selector="Border.mi">
      <Setter Property="Background" Value="#241010"/>
      <Setter Property="RenderTransform" Value="translateX(0px)"/>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.35" Easing="{x:Static bp:BpSprings.Lift}"/>
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.3"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.bpcard.f Border.mi">
      <Setter Property="Background" Value="{StaticResource BpRedHot}"/>
      <Setter Property="BoxShadow" Value="0 0 22 0 #8CEF4444"/>
      <Setter Property="RenderTransform" Value="translateX(6px)"/>
    </Style>
    <Style Selector="Rectangle.dash"><Setter Property="Stroke" Value="#3A1518"/><Setter Property="StrokeDashArray" Value="3,2"/></Style>
    <Style Selector="Button.bpcard.f Rectangle.dash"><Setter Property="StrokeDashArray" Value="{x:Null}"/><Setter Property="Stroke" Value="#7F1D1D"/></Style>
    <Style Selector="Border.more">
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Background" Value="{StaticResource BpSurface}"/>
    </Style>

    <!-- أزرار دائرية في الشريط العلوي (.ib) -->
    <Style Selector="Button.ib">
      <Setter Property="Width" Value="64"/>
      <Setter Property="Height" Value="64"/>
      <Setter Property="CornerRadius" Value="32"/>
      <Setter Property="Background" Value="{StaticResource BpSurface}"/>
      <Setter Property="BorderBrush" Value="#2E1616"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#E8D8D8"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.ib /template/ ContentPresenter">
      <Setter Property="Background" Value="{Binding $parent[Button].Background}"/>
      <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}"/>
      <Setter Property="CornerRadius" Value="32"/>
    </Style>
    <Style Selector="Button.ib:pointerover"><Setter Property="Background" Value="#241010"/></Style>
    <Style Selector="Button.ib.open">
      <Setter Property="Background" Value="{StaticResource BpRedHot}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.ib.open /template/ ContentPresenter"><Setter Property="BoxShadow" Value="0 0 22 0 #99EF4444"/></Style>

    <!-- تبويبات الشريط العلوي (.tbtn) وشريط الرئيسي (.tstab) -->
    <Style Selector="Button.tbtn">
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource BpMuted}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Transitions"><Transitions><BrushTransition Property="Foreground" Duration="0:0:0.25"/></Transitions></Setter>
    </Style>
    <Style Selector="Button.tbtn.on"><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.tstab">
      <Setter Property="Height" Value="62"/>
      <Setter Property="FontSize" Value="21"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="CornerRadius" Value="12,12,0,0"/>
      <Setter Property="Foreground" Value="{StaticResource BpMuted}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Transitions"><Transitions><BrushTransition Property="Foreground" Duration="0:0:0.25"/></Transitions></Setter>
    </Style>
    <Style Selector="Button.tstab /template/ ContentPresenter">
      <Setter Property="Background" Value="{Binding $parent[Button].Background}"/>
      <Setter Property="CornerRadius" Value="12,12,0,0"/>
    </Style>
    <Style Selector="Button.tstab.on"><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.tstab.f"><Setter Property="Background" Value="#1AEF4444"/></Style>

    <!-- إحصاءات البطل (.hst) -->
    <Style Selector="StackPanel.hst"><Setter Property="Spacing" Value="3"/></Style>
    <Style Selector="StackPanel.hst > TextBlock.k">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="LetterSpacing" Value="1.1"/>
      <Setter Property="Foreground" Value="{StaticResource BpMuted}"/>
    </Style>
    <Style Selector="StackPanel.hst > TextBlock.v"><Setter Property="FontSize" Value="21"/><Setter Property="FontWeight" Value="SemiBold"/></Style>

    <!-- منصات المكتبة (.chip) -->
    <Style Selector="Button.chip">
      <Setter Property="Foreground" Value="{StaticResource BpMuted}"/>
      <Setter Property="Transitions"><Transitions><BrushTransition Property="Foreground" Duration="0:0:0.3"/></Transitions></Setter>
    </Style>
    <Style Selector="Button.chip.on"><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Border.cnt"><Setter Property="Background" Value="#2A1313"/></Style>
    <Style Selector="Button.chip.on Border.cnt"><Setter Property="Background" Value="#4D000000"/></Style>

    <!-- مفاتيح لوحة المفاتيح (.key) -->
    <Style Selector="Button.key">
      <Setter Property="Height" Value="78"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Background" Value="{StaticResource BpSurface}"/>
      <Setter Property="BorderBrush" Value="#2E1616"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#D9C7C7"/>
      <Setter Property="ZIndex" Value="0"/>
      <Setter Property="RenderTransform" Value="scale(1)"/>
      <Setter Property="Transitions">
        <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="{x:Static bp:BpSprings.Key}"/></Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.key /template/ ContentPresenter">
      <Setter Property="Background" Value="{Binding $parent[Button].Background}"/>
      <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}"/>
      <Setter Property="CornerRadius" Value="14"/>
    </Style>
    <Style Selector="Button.key.pri"><Setter Property="BorderBrush" Value="#7F1D1D"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.key.f">
      <Setter Property="Background" Value="{StaticResource BpRedGrad}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="ZIndex" Value="1"/>
      <Setter Property="RenderTransform" Value="scale(1.08)"/>
    </Style>
    <Style Selector="Button.key.f /template/ ContentPresenter"><Setter Property="BoxShadow" Value="0 0 24 0 #8CEF4444"/></Style>
    <Style Selector="Button.key:pressed"><Setter Property="RenderTransform" Value="scale(0.92)"/></Style>

    <!-- نتائج البحث (.qsr) -->
    <Style Selector="Button.qsr">
      <Setter Property="Height" Value="92"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Background" Value="{StaticResource BpSurface}"/>
      <Setter Property="RenderTransform" Value="scale(1)"/>
      <Setter Property="Transitions">
        <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="{x:Static bp:BpSprings.Lift}"/></Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.qsr /template/ ContentPresenter">
      <Setter Property="Background" Value="{Binding $parent[Button].Background}"/>
      <Setter Property="CornerRadius" Value="14"/>
    </Style>
    <Style Selector="Button.qsr.f"><Setter Property="Background" Value="#4A1C1F"/><Setter Property="RenderTransform" Value="scale(1.02)"/></Style>

    <!-- البطاقات والأسطر (.cd / .tile / .row / .nti) -->
    <Style Selector="Border.cd">
      <Setter Property="Background" Value="{StaticResource BpSurface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BpLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="18"/>
    </Style>
    <Style Selector="Button.wide">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style Selector="Button.nti">
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.2"/></Transitions></Setter>
    </Style>
    <Style Selector="Button.nti /template/ ContentPresenter">
      <Setter Property="Background" Value="{Binding $parent[Button].Background}"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="Button.nti.f"><Setter Property="Background" Value="#241010"/></Style>
    <Style Selector="Button.row">
      <Setter Property="Padding" Value="20,16"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.2"/></Transitions></Setter>
    </Style>
    <Style Selector="Button.row /template/ ContentPresenter">
      <Setter Property="Background" Value="{Binding $parent[Button].Background}"/>
      <Setter Property="CornerRadius" Value="14"/>
    </Style>
    <Style Selector="Button.row.f"><Setter Property="Background" Value="#241010"/></Style>

    <!-- عناصر القائمة الجانبية والإعدادات (.si) -->
    <Style Selector="Button.si">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Height" Value="64"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource BpMuted}"/>
      <Setter Property="Transitions"><Transitions><BrushTransition Property="Foreground" Duration="0:0:0.3"/></Transitions></Setter>
    </Style>
    <Style Selector="Button.si.on"><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.si.dg"><Setter Property="Foreground" Value="#FCA5A5"/></Style>
    <Style Selector="Button.si.dg.on"><Setter Property="Foreground" Value="White"/></Style>

    <!-- اللوحات (.panel) وصندوق الحالة (.stat) -->
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#0E0606"/>
      <Setter Property="BorderBrush" Value="{StaticResource BpLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="Padding" Value="38,32"/>
      <Setter Property="BoxShadow" Value="0 40 110 0 #B3000000"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.stat">
      <Setter Property="Padding" Value="20,16"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Background" Value="#0A0404"/>
      <Setter Property="BorderBrush" Value="{StaticResource BpLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Transitions"><Transitions><BrushTransition Property="BorderBrush" Duration="0:0:0.35"/></Transitions></Setter>
    </Style>
    <Style Selector="Border.stat.ok">
      <Setter Property="BorderBrush" Value="#59EF4444"/>
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%"><GradientStop Color="#14EF4444" Offset="0"/><GradientStop Color="#0A0404" Offset="0.6"/></LinearGradientBrush>
      </Setter>
    </Style>
    <Style Selector="Border.stat.bad">
      <Setter Property="BorderBrush" Value="#8CDC2626"/>
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%"><GradientStop Color="#477F1D1D" Offset="0"/><GradientStop Color="#0A0404" Offset="0.6"/></LinearGradientBrush>
      </Setter>
    </Style>

    <!-- الإشعارات (.ntr) -->
    <Style Selector="Border.ntr">
      <Setter Property="Padding" Value="18,16"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Background" Value="{StaticResource BpSurface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BpLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="RenderTransform" Value="translateX(0px) scale(1)"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.2"/>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="{x:Static bp:BpSprings.Lift}"/>
          <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.ntr.f"><Setter Property="Background" Value="#241010"/><Setter Property="RenderTransform" Value="translateX(0px) scale(1.02)"/></Style>
    <Style Selector="Border.ntr.new"><Setter Property="BoxShadow" Value="0 0 26 0 #2E4ADE80"/><Setter Property="BorderBrush" Value="#594ADE80"/></Style>
    <Style Selector="Border.ntr.out"><Setter Property="Opacity" Value="0"/><Setter Property="RenderTransform" Value="translateX(420px) scale(1)"/></Style>
    <Style Selector="StackPanel.nacts">
      <Setter Property="MaxHeight" Value="0"/>
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="MaxHeight" Duration="0:0:0.3"/>
          <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
          <ThicknessTransition Property="Margin" Duration="0:0:0.3"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.ntr.f StackPanel.nacts"><Setter Property="MaxHeight" Value="64"/><Setter Property="Opacity" Value="1"/><Setter Property="Margin" Value="0,12,0,0"/></Style>
    <Style Selector="Button.btn.sm"><Setter Property="Height" Value="48"/><Setter Property="Padding" Value="18,0"/><Setter Property="CornerRadius" Value="12"/><Setter Property="FontSize" Value="17"/></Style>
    <Style Selector="Ellipse.udot">
      <Setter Property="RenderTransform" Value="scale(1)"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.45"/>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.45" Easing="{x:Static bp:BpSprings.Lift}"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Ellipse.udot.off"><Setter Property="Opacity" Value="0"/><Setter Property="RenderTransform" Value="scale(0)"/></Style>

    <!-- حلقة التركيز (.fring) -->
    <Style Selector="Border#Ring">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Canvas.Left" Duration="0:0:0.42" Easing="{x:Static bp:BpSprings.Ring}"/>
          <DoubleTransition Property="Canvas.Top" Duration="0:0:0.42" Easing="{x:Static bp:BpSprings.Ring}"/>
          <DoubleTransition Property="Width" Duration="0:0:0.42" Easing="{x:Static bp:BpSprings.Ring}"/>
          <DoubleTransition Property="Height" Duration="0:0:0.42" Easing="{x:Static bp:BpSprings.Ring}"/>
          <CornerRadiusTransition Property="CornerRadius" Duration="0:0:0.3"/>
          <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
        </Transitions>
      </Setter>
    </Style>
  </Window.Styles>

  <Viewbox Stretch="Uniform">
    <Panel x:Name="Root" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" ClipToBounds="True"
           FlowDirection="{Binding FlowDirection, Source={x:Static l:Loc.Instance}}"
           TextElement.FontFamily="{Binding FontFamily, Source={x:Static l:Loc.Instance}}">
      <Panel.Background>
        <RadialGradientBrush Center="85%,-10%" GradientOrigin="85%,-10%" RadiusX="68%" RadiusY="52%">
          <GradientStop Color="#38B91C1C" Offset="0"/><GradientStop Color="#000A0404" Offset="1"/>
        </RadialGradientBrush>
      </Panel.Background>

      <!-- ===== الصفحات المنزلقة (.pview / .ptrack) ===== -->
      <Panel x:Name="PageView" ClipToBounds="True">
        <StackPanel x:Name="Track" Orientation="Horizontal" HorizontalAlignment="Left">

          <!-- الرئيسي -->
          <Panel x:Name="HomePage" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" ClipToBounds="True">
            <Panel x:Name="HeroArt" IsHitTestVisible="False">
              <Border x:Name="HeroArtFill" Height="720" VerticalAlignment="Top" ClipToBounds="True"
                      Background="{Binding Hero.Name, Converter={x:Static bp:BpArtConverter.Instance}}">
                <Border.OpacityMask>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="Black" Offset="0.45"/><GradientStop Color="Transparent" Offset="1"/>
                  </LinearGradientBrush>
                </Border.OpacityMask>
                <Panel>
                  <TextBlock Text="{Binding Hero.Letter}" FontFamily="fonts:Inter#Inter" FontWeight="Black" FontSize="860"
                             Foreground="#17FFFFFF" HorizontalAlignment="Right" Margin="0,-150,140,0" LineHeight="860"/>
                  <!-- بلا صورة بطل: الغلاف مموّهًا -->
                  <Image Stretch="UniformToFill" Opacity="0.55" IsVisible="{Binding HeroHasNoArt}" FlowDirection="LeftToRight"
                         behaviors:AsyncImage.DecodeWidth="360"
                         behaviors:AsyncImage.SourceUrl="{Binding Hero.CoverUrl}" behaviors:AsyncImage.FallbackUrl="{Binding Hero.CoverFallbackUrl}">
                    <Image.Effect><BlurEffect Radius="60"/></Image.Effect>
                  </Image>
                  <Image Stretch="UniformToFill" FlowDirection="LeftToRight" behaviors:AsyncImage.DecodeWidth="1920"
                         behaviors:AsyncImage.SourceUrl="{Binding Hero.HeroUrl}"/>
                </Panel>
              </Border>
              <Border>
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#E00A0404" Offset="0"/><GradientStop Color="#8C0A0404" Offset="0.38"/><GradientStop Color="#000A0404" Offset="0.72"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <Border>
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,100%" EndPoint="0%,0%">
                    <GradientStop Color="#FF0A0404" Offset="0.42"/><GradientStop Color="#000A0404" Offset="0.72"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
            </Panel>
            <bpc:BpGridLight Classes="gl"/>

            <StackPanel x:Name="HeroPanel" Margin="72,150,0,0" Width="1600" HorizontalAlignment="Left" VerticalAlignment="Top" Spacing="14">
              <Border Classes="bd" Height="34" Padding="14,0" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Hero.ShownPlatform}" FontSize="17" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="{Binding Hero.Name}" FontSize="76" FontWeight="ExtraBold" TextTrimming="CharacterEllipsis"/>
              <Border IsVisible="{Binding Hero.HasUpdate}" Height="40" Padding="16,0" CornerRadius="12" Background="#2A1313"
                      BorderBrush="#4A2A12" BorderThickness="1" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <c:VectorIcon Data="M12 4v12M6 11l6 6 6-6M5 20h14" Size="18" StrokeWidth="2.6" Foreground="#F5A623"/>
                  <TextBlock Text="{l:Loc bpUpdAvail}" FontSize="18" FontWeight="SemiBold" Foreground="#F5A623"/>
                </StackPanel>
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,14,0,0">
                <ItemsControl ItemsSource="{Binding HeroButtons}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="16"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="bp:BpButtonItem">
                      <Button Classes="btn" Classes.pl="{Binding IsPrimary}" Classes.f="{Binding IsFocused}" Focusable="False"
                              bpc:BpFocus.Key="{Binding FocusKey}" Click="OnHeroButtonClick">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                          <c:VectorIcon IsVisible="{Binding IsPrimary}" Data="M6 4l14 8-14 8z" Size="22" IsFilled="True" Foreground="White"/>
                          <c:VectorIcon IsVisible="{Binding Id, Converter={x:Static bp:BpIs.Fav}}" Size="22"
                                        Data="M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7z"
                                        IsFilled="{Binding IsOn}" FillBrush="{Binding IsOn, Converter={x:Static bp:BpIs.HeartFill}}" Foreground="{Binding IsOn, Converter={x:Static bp:BpIs.HeartStroke}}"/>
                          <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="{Binding $parent[Button].FontSize}"
                                     FontWeight="{Binding $parent[Button].FontWeight}" Foreground="{Binding $parent[Button].Foreground}"/>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                  <Border BorderBrush="#24FFFFFF" BorderThickness="1,0,0,0" Padding="26,0">
                    <StackPanel Classes="hst"><TextBlock Classes="k" Text="{Binding Upper[bpLastPlayed]}"/><TextBlock Classes="v" Text="{Binding Hero.LastShortText}"/></StackPanel>
                  </Border>
                  <Border BorderBrush="#24FFFFFF" BorderThickness="1,0,0,0" Padding="26,0">
                    <StackPanel Classes="hst"><TextBlock Classes="k" Text="{Binding Upper[bpPlayTime]}"/><TextBlock Classes="v" Text="{Binding Hero.HoursShortText}"/></StackPanel>
                  </Border>
                  <Border BorderBrush="#24FFFFFF" BorderThickness="1,0,0,0" Padding="26,0">
                    <StackPanel Classes="hst"><TextBlock Classes="k" Text="{Binding Upper[bpSize]}"/><TextBlock Classes="v" Text="{Binding HeroSize}" FlowDirection="LeftToRight"/></StackPanel>
                  </Border>
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <!-- شريط التبويبات بخطه المتمدد (.tstrip) -->
            <Panel Margin="72,556,0,0" Width="860" Height="64" HorizontalAlignment="Left" VerticalAlignment="Top">
              <Border Height="2" VerticalAlignment="Bottom" Background="#12FFFFFF"/>
              <c:SlidingPill ItemCount="4" SelectedIndex="{Binding StripIndex}" EdgeInset="18" Motion="Underline" Height="6"
                             VerticalAlignment="Bottom" Margin="0,0,0,-2">
                <Border CornerRadius="3" Background="{StaticResource BpRedGrad}" BoxShadow="0 0 14 0 #B3EF4444"/>
              </c:SlidingPill>
              <ItemsControl ItemsSource="{Binding StripTabs}" VerticalAlignment="Top">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="bp:BpButtonItem">
                    <Button Classes="tstab" Classes.on="{Binding IsOn}" Classes.f="{Binding IsFocused}" Focusable="False"
                            bpc:BpFocus.Key="{Binding FocusKey}" bpc:BpFocus.Radius="12" Click="OnStripClick">
                      <TextBlock Text="{Binding Label}" Foreground="{Binding $parent[Button].Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Panel>

            <!-- صف البطاقات (.crow / .rt): نزل قليلًا حتى لا تلامس حلقة البطاقة المكبّرة خط التبويب فوقها -->
            <Panel Margin="72,664,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
              <StackPanel x:Name="RowStrip" Orientation="Horizontal" Spacing="26">
                <ItemsControl x:Name="RowItems" ItemsSource="{Binding RowCards}" ItemTemplate="{StaticResource BpCardTemplate}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="26"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
                <Button Classes="bpcard" Classes.f="{Binding MoreCard.IsFocused}" Focusable="False" Click="OnMoreClick"
                        bpc:BpFocus.Key="more" bpc:BpFocus.Radius="18" Width="204" Height="306">
                  <Panel><Border Classes="more"/><Rectangle Classes="dash" StrokeThickness="2" RadiusX="18" RadiusY="18"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14">
                      <Border x:Name="MoreIcon" Classes="mi" Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center">
                        <!-- السهم يشير لاتجاه القراءة: يسارًا في العربية -->
                        <c:VectorIcon Data="M5 12h14M13 6l6 6-6 6" Size="26" StrokeWidth="2.4" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      RenderTransform="{Binding IsRtl, Converter={x:Static bp:BpIs.FlipX}}"/>
                      </Border>
                      <TextBlock Text="{Binding MoreCard.Label}" FontSize="19" FontWeight="SemiBold" Foreground="#D9C7C7" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </Panel>
                </Button>
              </StackPanel>
            </Panel>
          </Panel>

          <!-- المكتبة والبحث: المرحلة 2 -->
          <!-- المكتبة (.lh / .lg) -->
          <Panel x:Name="LibraryPage" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" ClipToBounds="True">
            <bpc:BpGridLight Classes="gl"/>
            <DockPanel Margin="72,144,72,0" Height="70" VerticalAlignment="Top" LastChildFill="False">
              <TextBlock DockPanel.Dock="Left" Text="{l:Loc bpLibrary}" FontSize="40" FontWeight="ExtraBold" VerticalAlignment="Center"/>
              <TextBlock DockPanel.Dock="Left" Text="{Binding LibraryCountText}" FontSize="20" Foreground="#9C8A8A" Margin="20,0,0,0" VerticalAlignment="Center"/>
              <Border DockPanel.Dock="Right" Padding="6" CornerRadius="30" Background="{StaticResource BpSurface}" BorderBrush="{StaticResource BpLine}" BorderThickness="1"
                      MinWidth="900" VerticalAlignment="Center">
                <Panel>
                  <c:SlidingPill ItemCount="{Binding Filters.Count}" SelectedIndex="{Binding FilterIndex}">
                    <Border CornerRadius="24" Background="{StaticResource BpRedGrad}" BoxShadow="0 0 18 0 #80EF4444"/>
                  </c:SlidingPill>
                  <ItemsControl ItemsSource="{Binding Filters}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="bp:BpFilterItem">
                        <Button Classes="chip" Classes.on="{Binding IsOn}" Focusable="False" Click="OnFilterClick" Height="54"
                                bpc:BpFocus.Key="{Binding FocusKey}" bpc:BpFocus.Radius="24">
                          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}" FontSize="19" FontWeight="SemiBold" Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
                            <Border Classes="cnt" CornerRadius="12" Padding="10,2" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Count}" FontSize="15" FontWeight="SemiBold" Foreground="{Binding $parent[Button].Foreground}"/>
                            </Border>
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Panel>
              </Border>
              <bpc:BpGlyph DockPanel.Dock="Right" Button="x" Ps="{Binding UsePsGlyphs}" Size="34" Margin="0,0,14,0" VerticalAlignment="Center"/>
            </DockPanel>
            <!-- نافذة ثابتة من 4 صفوف تتبدل ألعابها عند التمرير: لا بطاقات جديدة ولا تمرير افتراضي مكلف -->
            <Panel x:Name="LibraryViewport" Margin="52,224,0,100" ClipToBounds="True">
              <ItemsControl x:Name="LibraryGrid" ItemsSource="{Binding LibraryWindow}" Margin="20,17,20,0" VerticalAlignment="Top">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="bp:BpRowSlot">
                    <StackPanel Orientation="Horizontal" Spacing="26" Height="340">
                      <ContentControl Content="{Binding C0}" ContentTemplate="{StaticResource BpCardTemplate}" IsVisible="{Binding C0, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                      <ContentControl Content="{Binding C1}" ContentTemplate="{StaticResource BpCardTemplate}" IsVisible="{Binding C1, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                      <ContentControl Content="{Binding C2}" ContentTemplate="{StaticResource BpCardTemplate}" IsVisible="{Binding C2, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                      <ContentControl Content="{Binding C3}" ContentTemplate="{StaticResource BpCardTemplate}" IsVisible="{Binding C3, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                      <ContentControl Content="{Binding C4}" ContentTemplate="{StaticResource BpCardTemplate}" IsVisible="{Binding C4, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                      <ContentControl Content="{Binding C5}" ContentTemplate="{StaticResource BpCardTemplate}" IsVisible="{Binding C5, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                      <ContentControl Content="{Binding C6}" ContentTemplate="{StaticResource BpCardTemplate}" IsVisible="{Binding C6, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Panel>
          </Panel>

          <!-- البحث (.sbx / .kb / .sres) -->
          <Panel x:Name="SearchPage" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" ClipToBounds="True">
            <bpc:BpGridLight Classes="gl"/>
            <Border Margin="72,150,0,0" Width="1090" Height="84" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="26"
                    BorderThickness="2.5" Background="{StaticResource BpSurface}" BoxShadow="0 0 16 0 #66EF4444" Padding="24,0">
              <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                  <GradientStop Color="#B91C1C" Offset="0"/><GradientStop Color="#F5A623" Offset="1"/>
                </LinearGradientBrush>
              </Border.BorderBrush>
              <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <Panel Width="30" Height="30">
                  <c:VectorIcon x:Name="SearchIcon" Data="M4 11a7 7 0 1 0 14 0a7 7 0 1 0 -14 0 M21 21l-4.3-4.3" Size="30" StrokeWidth="2.4" Foreground="{StaticResource BpMuted}"/>
                  <Border x:Name="QBadge" IsVisible="{Binding NoMatch}" Width="34" Height="34" CornerRadius="17" Margin="0,-76,0,0"
                          HorizontalAlignment="Left" BoxShadow="0 0 14 0 #80EF4444">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Color="#EF4444" Offset="0"/><GradientStop Color="#F5A623" Offset="1"/></LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="?" FontFamily="fonts:Inter#Inter" FontWeight="Bold" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                </Panel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <bpc:BpAutoText Text="{Binding QueryShown}" FontSize="30" Foreground="{Binding HasQuery, Converter={x:Static bp:BpIs.QueryBrush}}" VerticalAlignment="Center"/>
                  <Border Width="3" Height="40" CornerRadius="2" Background="#F5A623" Margin="2,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <ItemsControl x:Name="Keyboard" ItemsSource="{Binding KeyRows}" Margin="72,272,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                          FlowDirection="{Binding KeyboardDirection}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ItemsControl ItemsSource="{Binding}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="bp:BpButtonItem">
                        <Button Classes="key" Classes.f="{Binding IsFocused}" Classes.pri="{Binding IsPrimary}" Focusable="False" Click="OnKeyClick"
                                Width="{Binding Id, Converter={x:Static bp:BpIs.KeyWidth}}" bpc:BpFocus.Key="{Binding FocusKey}">
                          <TextBlock Text="{Binding Label}" FontSize="{Binding Id, Converter={x:Static bp:BpIs.KeyFont}}" FontWeight="SemiBold"
                                     Foreground="{Binding $parent[Button].Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Margin="0,150,72,0" Width="{Binding ResultsWidth}" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="10">
              <TextBlock Text="{l:Loc bpResults}" FontSize="22" FontWeight="Bold" Margin="0,0,0,8"/>
              <ItemsControl x:Name="ResultsList" ItemsSource="{Binding Results}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="bp:BpCardItem">
                    <Button Classes="qsr" Classes.f="{Binding IsFocused}" Focusable="False" Click="OnCardClick" bpc:BpFocus.Key="{Binding FocusKey}">
                      <DockPanel>
                        <Border DockPanel.Dock="Left" Width="120" Height="68" CornerRadius="10" ClipToBounds="True"
                                Background="{Binding Game.Name, Converter={x:Static bp:BpArtConverter.Instance}}">
                          <Panel>
                            <TextBlock Text="{Binding Game.Letter}" FontFamily="fonts:Inter#Inter" FontWeight="ExtraBold" FontSize="38" Foreground="#29FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Stretch="UniformToFill" behaviors:AsyncImage.DecodeWidth="240"
                                   behaviors:AsyncImage.SourceUrl="{Binding Game.HeaderUrl}" behaviors:AsyncImage.FallbackUrl="{Binding Game.CoverUrl}"/>
                          </Panel>
                        </Border>
                        <Border DockPanel.Dock="Right" CornerRadius="8" Background="#2A1313" Padding="10,3" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Game.ShownPlatform}" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                        <bpc:BpAutoText Text="{Binding Game.Name}" FontSize="21" FontWeight="SemiBold" Margin="18,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      </DockPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel IsVisible="{Binding NoMatch}" Margin="0,20" Spacing="4">
                <TextBlock Text="{Binding NoMatchText}" FontSize="22" FontWeight="SemiBold" Foreground="#D9C7C7"/>
                <TextBlock Text="{l:Loc bpTryOther}" FontSize="17" Foreground="#9C8A8A"/>
              </StackPanel>
            </StackPanel>
          </Panel>
        </StackPanel>
      </Panel>

      <!-- ===== صفحة اللعبة (.gpg) ===== -->
      <Panel x:Name="GamePage" IsVisible="{Binding IsGameOpen}" Background="#0A0404">
        <Border Height="720" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False"
                Background="{Binding Hero.Name, Converter={x:Static bp:BpArtConverter.Instance}}">
          <Border.OpacityMask>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Color="Black" Offset="0.45"/><GradientStop Color="Transparent" Offset="1"/></LinearGradientBrush>
          </Border.OpacityMask>
          <Panel>
            <Image Stretch="UniformToFill" Opacity="0.55" IsVisible="{Binding HeroHasNoArt}" FlowDirection="LeftToRight" behaviors:AsyncImage.DecodeWidth="360"
                   behaviors:AsyncImage.SourceUrl="{Binding Hero.CoverUrl}" behaviors:AsyncImage.FallbackUrl="{Binding Hero.CoverFallbackUrl}">
              <Image.Effect><BlurEffect Radius="60"/></Image.Effect>
            </Image>
            <Image Stretch="UniformToFill" FlowDirection="LeftToRight" behaviors:AsyncImage.DecodeWidth="1920" behaviors:AsyncImage.SourceUrl="{Binding Hero.HeroUrl}"/>
          </Panel>
        </Border>
        <Border IsHitTestVisible="False">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
              <GradientStop Color="#E00A0404" Offset="0"/><GradientStop Color="#8C0A0404" Offset="0.38"/><GradientStop Color="#000A0404" Offset="0.72"/>
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <Border IsHitTestVisible="False">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,100%" EndPoint="0%,0%"><GradientStop Color="#FF0A0404" Offset="0.42"/><GradientStop Color="#000A0404" Offset="0.72"/></LinearGradientBrush>
          </Border.Background>
        </Border>

        <bpc:BpGridLight Classes="gl"/>

        <StackPanel Margin="72,150,0,0" Width="880" HorizontalAlignment="Left" VerticalAlignment="Top" Spacing="14">
          <Border Classes="bd" Height="34" Padding="14,0" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Hero.ShownPlatform}" FontSize="17" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="{Binding Hero.Name}" FontSize="84" FontWeight="ExtraBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
          <StackPanel Orientation="Horizontal" Spacing="14">
            <TextBlock Text="{Binding Hero.HoursText}" FontSize="21" Foreground="#D9C7C7"/>
            <Ellipse Width="6" Height="6" Fill="#6B4B4B" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Hero.LastLongText}" FontSize="21" Foreground="#D9C7C7"/>
          </StackPanel>
          <Border IsVisible="{Binding Hero.HasUpdate}" Height="40" Padding="16,0" CornerRadius="12" Background="#2A1313"
                  BorderBrush="#4A2A12" BorderThickness="1" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <c:VectorIcon Data="M12 4v12M6 11l6 6 6-6M5 20h14" Size="18" StrokeWidth="2.6" Foreground="#F5A623"/>
              <TextBlock Text="{l:Loc bpUpdAvail}" FontSize="18" FontWeight="SemiBold" Foreground="#F5A623"/>
            </StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding GameButtons}" Width="460" HorizontalAlignment="Left" Margin="0,20,0,0">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="14"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="bp:BpButtonItem">
                <Button Classes="btn wide" Classes.pl="{Binding IsPrimary}" Classes.f="{Binding IsFocused}" Focusable="False"
                        HorizontalAlignment="Stretch" bpc:BpFocus.Key="{Binding FocusKey}" Click="OnGameButtonClick">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <c:VectorIcon IsVisible="{Binding IsPrimary}" Data="M6 4l14 8-14 8z" Size="22" IsFilled="True" Foreground="White"/>
                    <!-- لكل زر أيقونته، كما في أزرار الرئيسي -->
                    <c:VectorIcon IsVisible="{Binding Id, Converter={x:Static bp:BpIs.Update}}" Data="M12 4v12M6 11l6 6 6-6M5 20h14" Size="22" StrokeWidth="2.4"
                                  Foreground="{Binding $parent[Button].Foreground}"/>
                    <c:VectorIcon IsVisible="{Binding Id, Converter={x:Static bp:BpIs.Fav}}" Size="22"
                                  Data="M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7z"
                                  IsFilled="{Binding IsOn}" FillBrush="{Binding IsOn, Converter={x:Static bp:BpIs.HeartFill}}" Foreground="{Binding IsOn, Converter={x:Static bp:BpIs.HeartStroke}}"/>
                    <c:VectorIcon IsVisible="{Binding Id, Converter={x:Static bp:BpIs.Settings}}" Data="M4 7h10M18 7h2M4 17h4M12 17h8M14 4v6M8 14v6" Size="22" StrokeWidth="2.2"
                                  Foreground="{Binding $parent[Button].Foreground}"/>
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="{Binding $parent[Button].FontSize}"
                               FontWeight="{Binding $parent[Button].FontWeight}" Foreground="{Binding $parent[Button].Foreground}"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel x:Name="GameSide" Margin="0,150,72,0" Width="660" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="18">
          <!-- تظهر فقط حين لا توجد للعبة صورة عريضة؛ معها تكون الصورة نفسها خلفية الصفحة كلها -->
          <Border IsVisible="{Binding ShowShowcase}" Height="372" CornerRadius="22" ClipToBounds="True" BorderBrush="#14FFFFFF" BorderThickness="1" BoxShadow="0 30 70 0 #80000000"
                  Background="{Binding Hero.Name, Converter={x:Static bp:BpArtConverter.Instance}}">
            <Panel>
              <TextBlock Text="{Binding Hero.Letter}" FontFamily="fonts:Inter#Inter" FontWeight="Black" FontSize="220" Foreground="#21FFFFFF"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Image Stretch="UniformToFill" FlowDirection="LeftToRight" behaviors:AsyncImage.DecodeWidth="720"
                     behaviors:AsyncImage.SourceUrl="{Binding Hero.ShowcaseUrl}" behaviors:AsyncImage.FallbackUrl="{Binding Hero.CoverUrl}"/>
              <Border>
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Color="#21FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="0.38"/></LinearGradientBrush>
                </Border.Background>
              </Border>
            </Panel>
          </Border>
          <UniformGrid Rows="1" Columns="4">
            <Border Classes="cd" CornerRadius="16" Padding="16,14" Margin="0,0,12,0">
              <!-- القيمة تصغر لتتسع بدل أن تُقص إلى «…» في الخانة الضيقة -->
              <StackPanel Spacing="4"><TextBlock Text="{l:Loc bpPlayTime}" FontSize="15" Foreground="{StaticResource BpMuted}" TextTrimming="CharacterEllipsis"/>
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="28">
                  <TextBlock Text="{Binding Hero.HoursShortText}" FontSize="21" FontWeight="Bold"/></Viewbox></StackPanel>
            </Border>
            <Border Classes="cd" CornerRadius="16" Padding="16,14" Margin="0,0,12,0">
              <StackPanel Spacing="4"><TextBlock Text="{l:Loc bpLastPlayed}" FontSize="15" Foreground="{StaticResource BpMuted}" TextTrimming="CharacterEllipsis"/>
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="28">
                  <TextBlock Text="{Binding Hero.LastShortText}" FontSize="21" FontWeight="Bold"/></Viewbox></StackPanel>
            </Border>
            <Border Classes="cd" CornerRadius="16" Padding="16,14" Margin="0,0,12,0">
              <StackPanel Spacing="4"><TextBlock Text="{l:Loc bpSize}" FontSize="15" Foreground="{StaticResource BpMuted}" TextTrimming="CharacterEllipsis"/>
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="28">
                  <TextBlock Text="{Binding HeroSize}" FontSize="21" FontWeight="Bold" FlowDirection="LeftToRight"/></Viewbox></StackPanel>
            </Border>
            <Border Classes="cd" CornerRadius="16" Padding="16,14">
              <StackPanel Spacing="4"><TextBlock Text="{l:Loc bpPlatform}" FontSize="15" Foreground="{StaticResource BpMuted}" TextTrimming="CharacterEllipsis"/>
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="28">
                  <TextBlock Text="{Binding Hero.ShownPlatform}" FontSize="21" FontWeight="Bold"/></Viewbox></StackPanel>
            </Border>
          </UniformGrid>
          <Border Classes="cd" Padding="24,18" IsVisible="{Binding Hero.SteamAppId, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                <TextBlock Text="{l:Loc bpNews}" FontSize="22" FontWeight="Bold"/>
                <Border CornerRadius="10" Background="#2A1313" Padding="10,2" VerticalAlignment="Center"><TextBlock Text="Steam" FontSize="14" FontWeight="SemiBold"/></Border>
              </StackPanel>
              <ItemsControl ItemsSource="{Binding NewsItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="bp:BpButtonItem">
                    <Border BorderBrush="#231010" BorderThickness="0,1,0,0">
                      <Button Classes="nti" Classes.f="{Binding IsFocused}" Focusable="False" bpc:BpFocus.Key="{Binding FocusKey}" bpc:BpFocus.Radius="12"
                              Click="OnNewsClick">
                        <StackPanel Spacing="4">
                          <bpc:BpAutoText Text="{Binding Label}" FontSize="19" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Note}" FontSize="15" Foreground="#9C8A8A" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                        </StackPanel>
                      </Button>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock IsVisible="{Binding !NewsItems.Count}" Text="{l:Loc bpNoNews}" FontSize="17" Foreground="#9C8A8A" Margin="16,8"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Panel>

      <!-- ===== الشريط العلوي (.top) ===== -->
      <Grid x:Name="TopBar" Height="120" VerticalAlignment="Top" Margin="72,0" ColumnDefinitions="*,Auto,*">
        <Button x:Name="TopLogo" Grid.Column="0" Width="64" Height="64" HorizontalAlignment="Left" Focusable="False" Click="OnGuideClick" CornerRadius="14">
          <Border CornerRadius="14" BoxShadow="0 0 26 0 #4DEF4444" ClipToBounds="True" Background="Black" BorderBrush="{StaticResource BpLine}" BorderThickness="1">
            <Image Source="/Assets/logo.png" Stretch="UniformToFill"/>
          </Border>
        </Button>

        <!-- LB وRB في مكانهما على ذراع التحكم في اللغتين؛ التبويبات وحدها تتبع اتجاه اللغة -->
        <StackPanel x:Name="TabBar" Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" FlowDirection="LeftToRight">
          <bpc:BpGlyph Button="lb" Ps="{Binding UsePsGlyphs}" VerticalAlignment="Center"/>
          <Border Width="660" Height="76" Padding="8" CornerRadius="26" Background="{StaticResource BpSurface}"
                  FlowDirection="{Binding #TopBar.FlowDirection}"
                  BorderBrush="{StaticResource BpLine}" BorderThickness="1" BoxShadow="0 8 24 0 #73000000">
            <Panel>
              <c:SlidingPill ItemCount="3" SelectedIndex="{Binding TabIndex}">
                <Border CornerRadius="19" Background="{StaticResource BpRedGrad}" BoxShadow="0 0 26 0 #8CEF4444"/>
              </c:SlidingPill>
              <UniformGrid Rows="1" Columns="3">
                <Button Classes="tbtn" Classes.on="{Binding IsHomeTab}" Focusable="False" Click="OnTabClick" Tag="0">
                  <TextBlock Text="{l:Loc bpHome}" Foreground="{Binding $parent[Button].Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Classes="tbtn" Classes.on="{Binding IsLibraryTab}" Focusable="False" Click="OnTabClick" Tag="1">
                  <TextBlock Text="{l:Loc bpLibrary}" Foreground="{Binding $parent[Button].Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Classes="tbtn" Classes.on="{Binding IsSearchTab}" Focusable="False" Click="OnTabClick" Tag="2">
                  <TextBlock Text="{l:Loc bpSearch}" Foreground="{Binding $parent[Button].Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
              </UniformGrid>
            </Panel>
          </Border>
          <bpc:BpGlyph Button="rb" Ps="{Binding UsePsGlyphs}" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,6,0" IsVisible="{Binding HasPad}" VerticalAlignment="Center">
            <c:VectorIcon Size="24" StrokeWidth="2" Foreground="#D9C7C7" Width="34" Height="26"
                          Data="M9 3h16c4.4 0 7 4 7.6 9.5.6 5.6-.6 10.5-4 10.5-2.6 0-3.7-3.4-6.6-3.4h-10c-2.9 0-4 3.4-6.6 3.4-3.4 0-4.6-4.9-4-10.5C2 7 4.6 3 9 3z M9 9v6 M6 12h6 M22.4 10.5a.6 .6 0 1 0 1.2 0a.6 .6 0 1 0 -1.2 0 M25.4 13.5a.6 .6 0 1 0 1.2 0a.6 .6 0 1 0 -1.2 0"/>
            <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{Binding HasBattery}" FlowDirection="LeftToRight" VerticalAlignment="Center">
              <Border Width="6" Height="16" CornerRadius="2" Background="{Binding BatteryBars, Converter={x:Static bp:BpIs.Bar}, ConverterParameter=1}"/>
              <Border Width="6" Height="16" CornerRadius="2" Background="{Binding BatteryBars, Converter={x:Static bp:BpIs.Bar}, ConverterParameter=2}"/>
              <Border Width="6" Height="16" CornerRadius="2" Background="{Binding BatteryBars, Converter={x:Static bp:BpIs.Bar}, ConverterParameter=3}"/>
              <Border Width="6" Height="16" CornerRadius="2" Background="{Binding BatteryBars, Converter={x:Static bp:BpIs.Bar}, ConverterParameter=4}"/>
            </StackPanel>
          </StackPanel>
          <TextBlock x:Name="Clock" FontFamily="fonts:Inter#Inter" FontWeight="Bold" FontSize="26" FlowDirection="LeftToRight"
                     VerticalAlignment="Center" Margin="0,0,6,0" IsVisible="{Binding Settings.ShowClock}"/>
          <Panel>
            <Button x:Name="BellButton" Classes="ib" Focusable="False" Click="OnBellClick">
              <c:VectorIcon x:Name="BellIcon" Data="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9 M10.3 21a1.94 1.94 0 0 0 3.4 0" Size="24" Foreground="#E8D8D8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
            <!-- عدد غير المقروء على حافة الجرس (.ib .cnt) -->
            <Border IsVisible="{Binding UnreadCount, Converter={x:Static bp:BpIs.Positive}}" IsHitTestVisible="False"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,2,0" MinWidth="26" Height="26" CornerRadius="13"
                    Padding="7,0" Background="#EF4444" BorderBrush="#0A0404" BorderThickness="3">
              <TextBlock Text="{Binding UnreadCount}" FontFamily="fonts:Inter#Inter" FontWeight="Bold" FontSize="14" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Panel>
          <Button Classes="ib" Classes.open="{Binding IsSettingsOpen}" Focusable="False" Click="OnSettingsClick">
            <c:SlidersIcon IsFlipped="{Binding IsSettingsOpen}" Foreground="White"/>
          </Button>
          <Button Classes="ib" Classes.open="{Binding IsGuideOpen}" Focusable="False" Click="OnGuideClick">
            <c:MenuCloseIcon IsOpen="{Binding IsGuideOpen}" Foreground="#E8D8D8" Width="26" Height="26"/>
          </Button>
        </StackPanel>
      </Grid>

      <!-- ===== نافذة الإعدادات (.setdlg) ===== -->
      <Panel x:Name="SettingsLayer" IsVisible="{Binding IsSettingsOpen}" Background="#C7060202" PointerPressed="OnSettingsScrimPressed">
        <Border x:Name="SettingsDialog" Width="1340" CornerRadius="20" ClipToBounds="True" BorderBrush="{StaticResource BpLine}" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 40 110 0 #B3000000" Background="#0E0606">
          <Grid ColumnDefinitions="340,*" MinHeight="740">
            <Border Grid.Column="0" Background="#0F0607" BorderBrush="{StaticResource BpLine}" BorderThickness="0,0,1,0" Padding="16,28">
              <StackPanel Spacing="6">
                <Border BorderBrush="#231010" BorderThickness="0,0,0,1" Padding="12,0,12,18" Margin="0,0,0,12">
                  <StackPanel Orientation="Horizontal" Spacing="14">
                    <Border Width="50" Height="50" CornerRadius="12" ClipToBounds="True" Background="Black" BoxShadow="0 0 16 0 #4DEF4444">
                      <Image Source="/Assets/logo.png" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Halawa Hub" FontSize="20" FontWeight="Bold"/>
                      <TextBlock Text="{l:Loc bp}" FontSize="15" Foreground="#F5A623"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <TextBlock Text="{l:Loc bpSettings}" FontSize="20" FontWeight="Bold" Foreground="#EF4444" Margin="12,0,12,14"/>
                <Panel>
                  <c:SlidingPill Orientation="Vertical" ItemCount="5" Pitch="70" SelectedIndex="{Binding SectionIndex}" Motion="Dialog"
                                 Opacity="{Binding SectionPillDim, Converter={x:Static bp:BpIs.Dim}}">
                    <Border CornerRadius="14" Background="{StaticResource BpRedGrad}" BoxShadow="0 0 20 0 #73EF4444"/>
                  </c:SlidingPill>
                  <ItemsControl ItemsSource="{Binding SettingSections}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="bp:BpButtonItem">
                        <Button Classes="si" Classes.on="{Binding IsOn}" Focusable="False" Click="OnSectionClick">
                          <TextBlock Text="{Binding Label}" Foreground="{Binding $parent[Button].Foreground}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Panel>
              </StackPanel>
            </Border>
            <DockPanel Grid.Column="1" Margin="36,30">
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                <Button DockPanel.Dock="Right" Width="60" Height="60" Focusable="False" Click="OnSettingsClick">
                  <c:VectorIcon Data="M6 6l12 12M18 6L6 18" Size="26" Foreground="{StaticResource BpMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <TextBlock Text="{Binding SectionTitle}" FontSize="30" FontWeight="Bold" VerticalAlignment="Center"/>
              </DockPanel>
              <Border DockPanel.Dock="Bottom" BorderBrush="#231010" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                <TextBlock Text="{l:Loc bpSaved}" FontSize="16" Foreground="{StaticResource BpMuted}"/>
              </Border>
              <ItemsControl x:Name="SettingRowsList" ItemsSource="{Binding SettingRows}" VerticalAlignment="Top">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="bp:BpSettingRow">
                    <Panel>
                      <TextBlock IsVisible="{Binding IsInfo}" Text="{Binding Label}" FontSize="17" Foreground="{StaticResource BpMuted}" Margin="20,6"/>
                      <Button IsVisible="{Binding IsControl}" Classes="row" Classes.f="{Binding IsFocused}" Focusable="False"
                              bpc:BpFocus.Key="{Binding FocusKey}" Click="OnRowClick">
                        <DockPanel>
                          <bpc:BpSwitch DockPanel.Dock="Right" IsVisible="{Binding IsToggle}" IsOn="{Binding IsOn}" Margin="22,0,0,0" VerticalAlignment="Center"/>
                          <bpc:BpGlyph DockPanel.Dock="Right" IsVisible="{Binding IsButton}" Button="a" Ps="{Binding $parent[Window].((bp:BigPictureViewModel)DataContext).UsePsGlyphs}"
                                       Margin="22,0,0,0" VerticalAlignment="Center"/>
                          <Border DockPanel.Dock="Right" IsVisible="{Binding IsSegmented}" Margin="22,0,0,0" Padding="5" CornerRadius="14" Background="#0A0404"
                                  BorderBrush="{StaticResource BpLine}" BorderThickness="1" VerticalAlignment="Center">
                            <Panel>
                              <c:SlidingPill ItemCount="{Binding Options.Count}" SelectedIndex="{Binding Selected}" Motion="Even">
                                <Border CornerRadius="10" Background="#B91C1C" BoxShadow="0 0 14 0 #73EF4444"/>
                              </c:SlidingPill>
                              <ItemsControl ItemsSource="{Binding Options}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="18" Padding="22,0" Height="48" LineHeight="48" TextAlignment="Center" Foreground="#B8A4A4"/>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </Panel>
                          </Border>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}" FontSize="21"/>
                            <TextBlock Text="{Binding Note}" FontSize="16" Foreground="{StaticResource BpMuted}" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="24"/>
                          </StackPanel>
                        </DockPanel>
                      </Button>
                    </Panel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DockPanel>
          </Grid>
        </Border>
      </Panel>

      <!-- ===== التحديث قبل التشغيل، ولوحة التشغيل (.panel) ===== -->
      <Panel IsVisible="{Binding IsUpdateOpen}" Background="#C7060202">
        <Border x:Name="UpdatePanel" Classes="panel" Width="900">
          <StackPanel Spacing="18">
            <StackPanel Orientation="Horizontal" Spacing="16">
              <Border Width="52" Height="52" CornerRadius="14" Background="#2A1313" BorderBrush="#4A2A12" BorderThickness="1">
                <c:VectorIcon Data="M12 4v12M6 11l6 6 6-6M5 20h14" Size="26" StrokeWidth="2.4" Foreground="#F5A623" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="{Binding UpdateTitle}" FontSize="30" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{l:Loc bpUpdText}" FontSize="21" LineHeight="34" Foreground="#D9C7C7" TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{Binding UpdateButtons}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="14"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="bp:BpButtonItem">
                  <Button Classes="btn" Classes.pri="{Binding IsPrimary}" Classes.f="{Binding IsFocused}" Focusable="False" bpc:BpFocus.Key="{Binding FocusKey}" Click="OnUpdateButtonClick">
                    <TextBlock Text="{Binding Label}" FontSize="21" FontWeight="{Binding $parent[Button].FontWeight}" Foreground="{Binding $parent[Button].Foreground}"/>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Panel>

      <!-- إعدادات اللعبة داخل الشاشة الكبيرة -->
      <Panel IsVisible="{Binding IsGameOptionsOpen}" Background="#C7060202">
        <Border x:Name="GameOptionsPanel" Classes="panel" Width="760">
          <StackPanel Spacing="18">
            <StackPanel Spacing="4">
              <TextBlock Text="{l:Loc bpGameSettings}" FontSize="30" FontWeight="Bold" Foreground="#EF4444"/>
              <bpc:BpAutoText Text="{Binding GameOptionsTitle}" FontSize="21" Foreground="#D9C7C7" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding GameOptions}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="bp:BpButtonItem">
                  <Button Classes="btn wide" Classes.f="{Binding IsFocused}" Focusable="False" HorizontalAlignment="Stretch"
                          Height="NaN" MinHeight="68" Padding="26,14" bpc:BpFocus.Key="{Binding FocusKey}" Click="OnGameOptionClick">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding Label}" FontSize="21" FontWeight="SemiBold" Foreground="{Binding $parent[Button].Foreground}"/>
                      <TextBlock Text="{Binding Note}" IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                 FontSize="16" Foreground="#9C8A8A" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Panel>

      <Panel IsVisible="{Binding IsLaunchOpen}" Background="#C7060202">
        <Border x:Name="LaunchPanel" Classes="panel" Width="780">
          <StackPanel Spacing="18" HorizontalAlignment="Stretch">
            <Border Width="220" Height="330" CornerRadius="16" ClipToBounds="True" BorderBrush="{StaticResource BpLine}" BorderThickness="1" HorizontalAlignment="Center"
                    Background="{Binding Hero.Name, Converter={x:Static bp:BpArtConverter.Instance}}">
              <Panel>
                <TextBlock Text="{Binding Hero.Letter}" FontFamily="fonts:Inter#Inter" FontWeight="ExtraBold" FontSize="100" Foreground="#24FFFFFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image Stretch="UniformToFill" behaviors:AsyncImage.DecodeWidth="320"
                       behaviors:AsyncImage.SourceUrl="{Binding Hero.CoverUrl}" behaviors:AsyncImage.FallbackUrl="{Binding Hero.CoverFallbackUrl}"/>
              </Panel>
            </Border>
            <Border Classes="stat" Classes.ok="{Binding IsLaunchDone}" Classes.bad="{Binding IsLaunchFailed}">
              <StackPanel Orientation="Horizontal" Spacing="18">
                <Viewbox Width="56" Height="56"><c:StatusBadge State="{Binding LaunchBadge}"/></Viewbox>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding LaunchTitle}" FontSize="22" FontWeight="Bold" Foreground="{Binding IsLaunchFailed, Converter={x:Static bp:BpIs.FailTitle}}"/>
                  <TextBlock Text="{Binding LaunchSub}" FontSize="17" Foreground="{StaticResource BpMuted}"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <StackPanel IsVisible="{Binding IsLaunchFailed}" Spacing="18">
              <TextBlock Text="{Binding FailText}" FontSize="21" LineHeight="34" Foreground="#D9C7C7" TextWrapping="Wrap" TextAlignment="Center"/>
              <ItemsControl ItemsSource="{Binding FailButtons}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="14"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="bp:BpButtonItem">
                    <Button Classes="btn" Classes.pri="{Binding IsPrimary}" Classes.f="{Binding IsFocused}" Focusable="False" bpc:BpFocus.Key="{Binding FocusKey}" Click="OnFailButtonClick">
                      <TextBlock Text="{Binding Label}" FontSize="21" FontWeight="{Binding $parent[Button].FontWeight}" Foreground="{Binding $parent[Button].Foreground}"/>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </Border>
      </Panel>

      <!-- ===== القائمة الجانبية (.gsh) ===== -->
      <Panel IsVisible="{Binding IsGuideOpen}">
        <Border Background="#99060202" PointerPressed="OnGuideScrimPressed"/>
        <Border x:Name="GuideSheet" Width="520" HorizontalAlignment="Left" Background="#0F0607" BorderBrush="{StaticResource BpLine}" BorderThickness="0,0,1,0"
                Padding="22,40,22,120" BoxShadow="30 0 90 0 #99000000">
          <StackPanel Spacing="12">
            <Border BorderBrush="#231010" BorderThickness="0,0,0,1" Padding="12,0,12,18" Margin="0,0,0,12">
              <StackPanel Orientation="Horizontal" Spacing="14">
                <Border Width="50" Height="50" CornerRadius="12" ClipToBounds="True" Background="Black" BoxShadow="0 0 16 0 #4DEF4444">
                  <Image Source="/Assets/logo.png" Stretch="UniformToFill"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Halawa Hub" FontSize="20" FontWeight="Bold"/>
                  <TextBlock Text="{l:Loc bp}" FontSize="15" Foreground="#F5A623"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock x:Name="GuideClock" FontFamily="fonts:Inter#Inter" FontWeight="Bold" FontSize="54" Padding="12,0" FlowDirection="LeftToRight"
                       HorizontalAlignment="Left" IsVisible="{Binding Settings.ShowClock}"/>
            <Border BorderBrush="#231010" BorderThickness="0,0,0,1" Padding="12,0,12,14" Margin="0,0,0,8">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <c:VectorIcon Size="18" StrokeWidth="2.4" Foreground="{StaticResource BpMuted}" Width="26" Height="20"
                              Data="M9 3h16c4.4 0 7 4 7.6 9.5.6 5.6-.6 10.5-4 10.5-2.6 0-3.7-3.4-6.6-3.4h-10c-2.9 0-4 3.4-6.6 3.4-3.4 0-4.6-4.9-4-10.5C2 7 4.6 3 9 3z"/>
                <TextBlock Text="{Binding ContextPadText}" FontSize="17" Foreground="{StaticResource BpMuted}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{Binding HasBattery}" FlowDirection="LeftToRight" VerticalAlignment="Center">
                  <Border Width="6" Height="16" CornerRadius="2" Background="{Binding BatteryBars, Converter={x:Static bp:BpIs.Bar}, ConverterParameter=1}"/>
                  <Border Width="6" Height="16" CornerRadius="2" Background="{Binding BatteryBars, Converter={x:Static bp:BpIs.Bar}, ConverterParameter=2}"/>
                  <Border Width="6" Height="16" CornerRadius="2" Background="{Binding BatteryBars, Converter={x:Static bp:BpIs.Bar}, ConverterParameter=3}"/>
                  <Border Width="6" Height="16" CornerRadius="2" Background="{Binding BatteryBars, Converter={x:Static bp:BpIs.Bar}, ConverterParameter=4}"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Panel>
              <c:SlidingPill Orientation="Vertical" ItemCount="7" Pitch="70" SelectedIndex="{Binding GuideIndex}" Motion="Dialog">
                <Border CornerRadius="14" Background="{StaticResource BpRedGrad}" BoxShadow="0 0 20 0 #73EF4444"/>
              </c:SlidingPill>
              <ItemsControl ItemsSource="{Binding GuideItems}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="bp:BpButtonItem">
                    <Button Classes="si" Classes.on="{Binding IsOn}" Classes.dg="{Binding IsDanger}" Focusable="False" Click="OnGuideItemClick">
                      <DockPanel>
                        <Border DockPanel.Dock="Right" IsVisible="{Binding Badge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" MinWidth="30" Height="30"
                                CornerRadius="15" Background="#EF4444" Padding="9,0">
                          <TextBlock Text="{Binding Badge}" FontFamily="fonts:Inter#Inter" FontWeight="Bold" FontSize="15" Foreground="White"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Label}" Foreground="{Binding $parent[Button].Foreground}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                      </DockPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Panel>
          </StackPanel>
        </Border>
      </Panel>

      <!-- ===== لوحة الإشعارات من الحافة الأخرى (.nsh) ===== -->
      <Panel IsVisible="{Binding IsNotificationsOpen}">
        <Border Background="#99060202" PointerPressed="OnGuideScrimPressed"/>
        <Border x:Name="NotifSheet" Width="660" HorizontalAlignment="Right" Background="#0F0607" BorderBrush="{StaticResource BpLine}" BorderThickness="1,0,0,0"
                Padding="26,40,26,120" BoxShadow="-30 0 90 0 #99000000">
          <DockPanel>
            <Border DockPanel.Dock="Top" BorderBrush="#231010" BorderThickness="0,0,0,1" Padding="6,0,6,14" Margin="0,0,0,16">
              <DockPanel>
                <Button DockPanel.Dock="Right" IsVisible="{Binding HasNotifications}" Height="50" Padding="14,0" CornerRadius="12" Focusable="False" Click="OnClearNotificationsClick">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <bpc:BpGlyph Button="y" Ps="{Binding UsePsGlyphs}" Size="34" VerticalAlignment="Center"/>
                    <TextBlock Text="{l:Loc bpNtClear}" FontSize="17" Foreground="{StaticResource BpMuted}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Text="{l:Loc bpNtTitle}" FontSize="28" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center"/>
                  <Border IsVisible="{Binding HasNotifications}" CornerRadius="12" Background="#2A1313" Padding="11,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding NotifItems.Count}" FontSize="15" FontWeight="SemiBold"/>
                  </Border>
                </StackPanel>
              </DockPanel>
            </Border>
            <Panel>
              <ItemsControl ItemsSource="{Binding NotifItems}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="bp:BpNotifItem">
                    <Border Classes="ntr" Classes.f="{Binding IsFocused}" Classes.out="{Binding Leaving}" Classes.new="{Binding IsNew}"
                            bpc:BpFocus.Key="{Binding FocusKey}" bpc:BpFocus.Radius="16" PointerPressed="OnNotificationPressed">
                      <Panel>
                        <DockPanel>
                          <Border DockPanel.Dock="Left" Width="54" Height="54" CornerRadius="14" VerticalAlignment="Top" BorderThickness="1"
                                  Background="{Binding Model.Kind, Converter={x:Static bp:BpKind.Background}}"
                                  BorderBrush="{Binding Model.Kind, Converter={x:Static bp:BpKind.Border}}">
                            <c:VectorIcon Data="{Binding Model.Kind, Converter={x:Static bp:BpKind.PathOf}}" Size="26" StrokeWidth="2.2"
                                          Foreground="{Binding Model.Kind, Converter={x:Static bp:BpKind.Foreground}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <StackPanel Margin="16,0,0,0" Spacing="3">
                            <bpc:BpAutoText Text="{Binding Model.Title}" FontSize="20" FontWeight="Bold" Margin="0,0,22,0" TextWrapping="Wrap"/>
                            <bpc:BpAutoText Text="{Binding Model.Body}" FontSize="17" Foreground="#D9C7C7" TextWrapping="Wrap" LineHeight="25"
                                            IsVisible="{Binding Model.Body, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="{Binding Model.Time}" FontSize="14" Foreground="#9C8A8A" Margin="0,2,0,0"/>
                            <StackPanel Classes="nacts" Orientation="Horizontal" Spacing="10">
                              <Button IsVisible="{Binding HasAction}" Classes="btn pri sm" Focusable="False" Click="OnNotificationActionClick">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                  <bpc:BpGlyph Button="a" Ps="{Binding $parent[Window].((bp:BigPictureViewModel)DataContext).UsePsGlyphs}" Size="30" VerticalAlignment="Center"/>
                                  <TextBlock Text="{Binding Model.ActionLabel}" FontSize="17" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                              </Button>
                              <Button Classes="btn sm" Focusable="False" Click="OnNotificationDismissClick">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                  <bpc:BpGlyph Button="x" Ps="{Binding $parent[Window].((bp:BigPictureViewModel)DataContext).UsePsGlyphs}" Size="30" VerticalAlignment="Center"/>
                                  <TextBlock Text="{l:Loc bpNtDismiss}" FontSize="17" VerticalAlignment="Center"/>
                                </StackPanel>
                              </Button>
                            </StackPanel>
                          </StackPanel>
                        </DockPanel>
                        <Ellipse Classes="udot" Classes.off="{Binding !Unread}" Width="11" Height="11" Fill="#EF4444"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,2,0"/>
                      </Panel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel IsVisible="{Binding !HasNotifications}" Spacing="14" Margin="20,90" HorizontalAlignment="Center">
                <Viewbox Width="56" Height="56" HorizontalAlignment="Center"><c:StatusBadge State="Done"/></Viewbox>
                <TextBlock Text="{l:Loc bpNtEmpty}" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="{l:Loc bpNtEmptySub}" FontSize="17" Foreground="#9C8A8A" HorizontalAlignment="Center"/>
              </StackPanel>
            </Panel>
          </DockPanel>
        </Border>
      </Panel>

      <!-- ===== إشعار يصل (.ntoast) ===== -->
      <Border x:Name="IncomingToast" IsVisible="{Binding Incoming, Converter={x:Static ObjectConverters.IsNotNull}}" Width="600"
              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,72,120" CornerRadius="18" Background="{StaticResource BpSurface}"
              BorderBrush="#3A1518" BorderThickness="1" BoxShadow="0 24 70 0 #99000000" ClipToBounds="True" Cursor="Hand" PointerPressed="OnIncomingPressed">
        <Panel>
          <StackPanel Orientation="Horizontal" Spacing="16" Margin="20,18,20,22">
            <Border Width="54" Height="54" CornerRadius="14" BorderThickness="1"
                    Background="{Binding Incoming.Kind, Converter={x:Static bp:BpKind.Background}}"
                    BorderBrush="{Binding Incoming.Kind, Converter={x:Static bp:BpKind.Border}}">
              <c:VectorIcon Data="{Binding Incoming.Kind, Converter={x:Static bp:BpKind.PathOf}}" Size="26" StrokeWidth="2.2"
                            Foreground="{Binding Incoming.Kind, Converter={x:Static bp:BpKind.Foreground}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center" Width="490" Spacing="3">
              <bpc:BpAutoText Text="{Binding Incoming.Title}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
              <bpc:BpAutoText Text="{Binding Incoming.Body}" FontSize="17" Foreground="#D9C7C7" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </StackPanel>
          <Border x:Name="IncomingBar" Height="4" VerticalAlignment="Bottom" Background="{StaticResource BpRedGrad}" RenderTransformOrigin="0%,50%"/>
        </Panel>
      </Border>

      <!-- ===== حلقة التركيز ===== -->
      <Canvas x:Name="RingLayer" IsHitTestVisible="False">
        <Border x:Name="Ring" Opacity="0" Width="0" Height="0" CornerRadius="20" BorderThickness="3" BorderBrush="#EF4444"
                BoxShadow="0 0 28 0 #99EF4444, inset 0 0 16 0 #40EF4444">
                    <Border x:Name="RingFlash" Margin="-3" CornerRadius="{Binding #Ring.CornerRadius}" BorderThickness="3" BorderBrush="#8CFFFFFF" Opacity="0"/>
        </Border>
        <!-- علامة الضغط بشكل الحلقة نفسه (مربع بزوايا مستديرة حول العنصر) بدل دائرة في وسطه -->
        <Border x:Name="TapR" BorderBrush="White" BorderThickness="3" Opacity="0" RenderTransformOrigin="50%,50%" IsHitTestVisible="False"/>
        <Border x:Name="TapM" Background="#40FFFFFF" BorderBrush="White" BorderThickness="3" Opacity="0" RenderTransformOrigin="50%,50%" IsHitTestVisible="False"/>
      </Canvas>

      <!-- ===== شريط التلميحات (.hb) ===== -->
      <Border Height="100" VerticalAlignment="Bottom" Padding="72,10,72,0" IsHitTestVisible="False">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,100%" EndPoint="0%,0%">
            <GradientStop Color="#FF0A0404" Offset="0.64"/><GradientStop Color="#000A0404" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Text="{Binding ContextText}" FontSize="20" Foreground="#9C8A8A" VerticalAlignment="Center"/>
          <ItemsControl ItemsSource="{Binding Hints}" HorizontalAlignment="Right" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="34"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="bp:BpHint">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <bpc:BpGlyph Button="{Binding Button}" Ps="{Binding $parent[Window].((bp:BigPictureViewModel)DataContext).UsePsGlyphs}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Label}" FontSize="20" Foreground="#D9C7C7" VerticalAlignment="Center"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>

      <!-- ===== رسالة قصيرة (.toast) ===== -->
      <Border x:Name="ToastBox" IsVisible="False" IsHitTestVisible="False" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,136,0,0"
              Padding="14,12,22,12" CornerRadius="16" BorderBrush="#59EF4444" BorderThickness="1" Background="#0A0404"
              BoxShadow="0 20 60 0 #99000000">
        <StackPanel Orientation="Horizontal" Spacing="14">
          <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource BpRedHot}" BoxShadow="0 0 16 0 #A6EF4444">
            <c:VectorIcon Data="M6 12.5l4 4 8-9" Size="26" StrokeWidth="3.4" Foreground="White"/>
          </Border>
          <TextBlock x:Name="ToastText" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <!-- ===== بداية الشاشة الكبيرة: الشبكة تُرسم، شعاع يعبر، الشعار يلمع، الاسم يصعد حرفًا حرفًا، ثم عبور إلى الرئيسي ===== -->
      <Panel x:Name="Intro" IsVisible="False" ClipToBounds="True">
        <Border x:Name="IntroBg" Background="#050202"/>
        <Border x:Name="IntroGlow" Width="1500" Height="1500" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"
                IsHitTestVisible="False" RenderTransformOrigin="50%,50%" Margin="0,-120,0,0">
          <Border.Background>
            <RadialGradientBrush>
              <GradientStop Color="#80B91C1C" Offset="0"/><GradientStop Color="#2EB91C1C" Offset="0.35"/>
              <GradientStop Color="#0FF5A623" Offset="0.5"/><GradientStop Color="#00050202" Offset="0.72"/>
            </RadialGradientBrush>
          </Border.Background>
        </Border>
        <bpc:BpGridLight x:Name="IntroGrid" Reveal="0"/>
        <!-- شعاع ضوء مائل يعبر الشاشة مرة -->
        <Border x:Name="IntroStreak" Width="320" Height="2600" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"
                IsHitTestVisible="False" RenderTransformOrigin="50%,50%">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
              <GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#1FF5A623" Offset="0.35"/>
              <GradientStop Color="#59FFE4D6" Offset="0.5"/><GradientStop Color="#1FEF4444" Offset="0.65"/><GradientStop Color="#00FFFFFF" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <StackPanel x:Name="IntroContent" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="30" Margin="0,-60,0,0" RenderTransformOrigin="50%,40%">
          <!-- الشعار وحده بلا مربع داكن: توهج أحمر حوله، ولمعة تمر على حرف M فقط -->
          <Panel x:Name="IntroLogo" Width="250" Height="250" HorizontalAlignment="Center" Opacity="0" RenderTransformOrigin="50%,50%">
            <Image Source="/Assets/logo-mark.png" Stretch="Uniform">
              <Image.Effect><DropShadowEffect BlurRadius="70" OffsetX="0" OffsetY="0" Color="#EF4444" Opacity="0.9"/></Image.Effect>
            </Image>
            <Panel ClipToBounds="True">
              <Panel.OpacityMask><ImageBrush Source="/Assets/logo-mark.png" Stretch="Uniform"/></Panel.OpacityMask>
              <Border x:Name="IntroShine" Width="110" Height="520" VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="50%,50%">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                    <GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#CCFFF4EC" Offset="0.5"/><GradientStop Color="#00FFFFFF" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
            </Panel>
          </Panel>
          <StackPanel x:Name="IntroWords" Spacing="10" HorizontalAlignment="Center">
            <StackPanel x:Name="IntroName" Orientation="Horizontal" HorizontalAlignment="Center" FlowDirection="LeftToRight"/>
            <TextBlock x:Name="IntroSub" Text="{l:Loc bp}" FontSize="30" FontWeight="SemiBold" Foreground="#F5A623" HorizontalAlignment="Center" Opacity="0"/>
          </StackPanel>
          <Border x:Name="IntroLine" Width="360" Height="4" CornerRadius="2" HorizontalAlignment="Center" Background="{StaticResource BpRedGrad}"
                  BoxShadow="0 0 16 0 #CCEF4444" RenderTransformOrigin="50%,50%" Opacity="0"/>
        </StackPanel>
      </Panel>
    </Panel>
  </Viewbox>
</Window>
